# SideQuest M2 server-side catalog config for app/.env.local.
# Copy this tracked template to app/.env.local on YOUR computer and fill in the
# current team Supabase project URL + publishable key through an approved channel.
# .env.local is ignored by Git, and must never be committed or shared as a screenshot.
# Never use the legacy VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY names.
# Do not use VITE_ or SIDEQUEST_PUBLIC_ prefixes for database values.
# Keep the values blank in this committed template. See docs/SUPABASE_LOCAL_SETUP.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# For production, configure these in the hosting Node environment.
# npm start does not automatically read app/.env.local. PORT defaults to 3000.

# Authenticated group-planning API is intentionally OFF until its RPC proposal,
# verified Supabase Auth and SQL grants receive security review and are deployed.
# This flag alone does not install group migrations or provide a login UI.
SIDEQUEST_GROUPS_ENABLED=false
