# SideQuest M2 server-side catalog config for app/.env.local.
# Copy this tracked template to app/.env.local on YOUR computer and fill in the
# current team Supabase project URL + publishable key through an approved channel.
# .env.local is ignored by Git, and must never be committed or shared as a screenshot.
# Never use the legacy VITE_SUPABASE_URL / VITE_SUPABASE_PUBLISHABLE_KEY names.
# Do not use VITE_ or SIDEQUEST_PUBLIC_ prefixes for database values.
# Keep the values blank in this committed template. See docs/SUPABASE_LOCAL_SETUP.md.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# For production, configure these in the hosting Node environment.
# npm start does not automatically read app/.env.local. PORT defaults to 3000.

# Authenticated group-planning API is intentionally OFF until its RPC proposal,
# verified Supabase Auth and SQL grants receive security review and are deployed.
# This flag alone does not install group migrations or provide a login UI.
SIDEQUEST_GROUPS_ENABLED=false

# Optional email sign-in. Default Supabase emails send a sign-in link back to the
# Site URL; a custom template with {{ .Token }} also allows a typed code.
SIDEQUEST_AUTH_EMAIL_ENABLED=false
SIDEQUEST_AUTH_ALLOW_SIGNUP=false

# Personal accounts: with email sign-in on, My Schedule, Someday and busy time are kept in
# the signed-in student's account (tables from supabase/migrations/20261124000000_*).
# Works without group planning. For a real sign-in on your own computer set
# SIDEQUEST_AUTH_EMAIL_ENABLED, SIDEQUEST_AUTH_ALLOW_SIGNUP, SIDEQUEST_ACCOUNTS_ENABLED and
# SIDEQUEST_PUBLIC_GROUP_LOGIN to true, then run: npm run real
SIDEQUEST_ACCOUNTS_ENABLED=false

# Who may hold an account. Default: Santa Clara addresses only (scu.edu and subdomains).
# For staging, list single test addresses rather than opening an outside domain.
SIDEQUEST_AUTH_ALLOWED_DOMAINS=scu.edu
SIDEQUEST_AUTH_ALLOWED_EMAILS=

# This public Boolean changes UI visibility only; it is not an auth control.
# Vite exposes this flag but no Supabase URL/keys or tokens to the browser.
SIDEQUEST_PUBLIC_GROUP_LOGIN=false
# Public look switch: true builds the designed look (paper, tickets, busy-time bar) on real data.
SIDEQUEST_PUBLIC_QUIET=false

# Optional AI-assisted Discover. The key stays server-side and is never public.
# Without a key, ordinary Discover remains available; the AI panel stays hidden.
OPENAI_API_KEY=
SIDEQUEST_AI_MODEL=gpt-6-luna
