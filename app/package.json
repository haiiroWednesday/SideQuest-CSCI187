{
  "name": "sidequest-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr server/index.ts --outDir dist-server && node scripts/check-browser-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start": "node dist-server/index.js",
    "test:coverage": "vitest run --coverage",
    "test:mutation:pilot": "node scripts/mutation-interval-pilot.mjs",
    "test:rubric": "vitest run tests/kandel.rubric-evidence.test.ts tests/kandel.code-quality.test.ts",
    "test:regression": "npm run test:coverage && npm run test:mutation:pilot && npm run test:rubric && npm run build && npm run test:e2e",
    "test:regression:contract": "vitest run tests/regression.contract-matrix.test.ts",
    "test:regression:journeys": "playwright test e2e/regression.journeys.spec.ts --project=chromium",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"playwright.config.ts\" \"eslint.config.mjs\" \"index.html\" \"scenario-lab.html\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"server/**/*.ts\" \"tests/**/*.{ts,tsx}\" \"e2e/**/*.{ts,tsx,mjs}\" \"scripts/**/*.mjs\" \"vite.config.ts\" \"playwright.config.ts\" \"eslint.config.mjs\" \"index.html\" \"scenario-lab.html\"",
    "lint": "eslint src server tests e2e scripts vite.config.ts playwright.config.ts eslint.config.mjs --max-warnings 0",
    "check:quality": "npm run format:check && npm run lint && npm run test:rubric"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "9.39.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "4.1.12",
    "eslint": "9.39.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "jsdom": "^26.1.0",
    "prettier": "3.6.2",
    "typescript": "~5.9.3",
    "typescript-eslint": "8.48.0",
    "vite": "^8.3.4",
    "vitest": "4.1.12"
  }
}
