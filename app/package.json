{
  "name": "sidequest-react",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --ssr server/index.ts --outDir dist-server && node scripts/check-browser-bundle.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "start": "node dist-server/index.js",
    "test:coverage": "vitest run --coverage",
    "test:mutation:pilot": "node scripts/mutation-interval-pilot.mjs",
    "test:rubric": "vitest run tests/kandel.rubric-evidence.test.ts tests/kandel.code-quality.test.ts",
    "test:regression": "npm run test:coverage && npm run test:mutation:pilot && npm run test:rubric && npm run build && npm run test:e2e",
    "test:regression:contract": "vitest run tests/regression.contract-matrix.test.ts",
    "test:regression:journeys": "playwright test e2e/regression.journeys.spec.ts --project=chromium",
    "test:ai:live": "node --env-file=.env.local scripts/verify-ai-live.mjs"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "@supabase/supabase-js": "^2.118.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@vitest/coverage-v8": "4.1.12",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^26.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "4.1.12",
    "@types/ws": "8.18.1"
  }
}
