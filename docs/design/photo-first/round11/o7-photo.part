
// =================== ROUND 7 · photo first, built on what you kept ===================
// Every option starts from a mechanic you marked Keep or Maybe (shape filters, the free-hours board,
// the claw, the lens, overlap cards, "Still on?") or from your references (tickets, stamps, sticky
// notes, tape, big numbers, folders), and puts the real photo inside it.
const SEC7 = [], O7 = {}
const pic = (n, w, h, fx = 50, fy = 45, ex = '') => `<div class="ph-${n}" style="width:${w}px;height:${h}px;background-size:cover;background-position:${fx}% ${fy}%;background-repeat:no-repeat;${ex}"></div>`
// a photo cut into one of our shapes (the same shapes as the filters and the characters)
const SHAPE = {
  round: 'M50 4C76 4 96 24 96 50S76 96 50 96 4 76 4 50 24 4 50 4Z',
  squircle: 'M30 4H70C88 4 96 12 96 30V70C96 88 88 96 70 96H30C12 96 4 88 4 70V30C4 12 12 4 30 4Z',
  scallop: Array.from({ length: 12 }, (_, i) => { const a = i / 12 * Math.PI * 2, b = (i + .5) / 12 * Math.PI * 2, c = (i + 1) / 12 * Math.PI * 2; return `${i ? '' : `M${50 + 40 * Math.cos(a)} ${50 + 40 * Math.sin(a)}`}Q${50 + 54 * Math.cos(b)} ${50 + 54 * Math.sin(b)} ${50 + 40 * Math.cos(c)} ${50 + 40 * Math.sin(c)}` }).join('') + 'Z',
  flower: Array.from({ length: 6 }, (_, i) => { const a = i / 6 * Math.PI * 2, b = (i + .5) / 6 * Math.PI * 2, c = (i + 1) / 6 * Math.PI * 2; return `${i ? '' : `M${50 + 30 * Math.cos(a)} ${50 + 30 * Math.sin(a)}`}C${50 + 62 * Math.cos(a + .2)} ${50 + 62 * Math.sin(a + .2)} ${50 + 62 * Math.cos(c - .2)} ${50 + 62 * Math.sin(c - .2)} ${50 + 30 * Math.cos(c)} ${50 + 30 * Math.sin(c)}` }).join('') + 'Z',
  arch: 'M8 96V44C8 20 26 4 50 4S92 20 92 44V96Z',
  ticket: 'M8 4H92V40A10 10 0 0 0 92 60V96H8V60A10 10 0 0 0 8 40Z' }
const MASK7 = {}
for (const k in SHAPE) MASK7[k] = `url('data:image/svg+xml,${encodeURIComponent(`<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 100 100"><path d="${SHAPE[k]}"/></svg>`).replace(/'/g, '%27')}')`
const shapePic = (kind, n, s, fx = 50, fy = 45, rot = 0) => `<div style="width:${s}px;height:${s}px;transform:rotate(${rot}deg);filter:drop-shadow(0 6px 10px rgba(48,36,33,.16))"><div class="ph-${n}" style="width:100%;height:100%;background-size:cover;background-position:${fx}% ${fy}%;-webkit-mask:${MASK7[kind]} center/100% 100% no-repeat;mask:${MASK7[kind]} center/100% 100% no-repeat"></div></div>`
const check7 = (s = 22) => `<span style="width:${s}px;height:${s}px;border-radius:50%;background:${C6.ink};color:#fff;display:grid;place-content:center;font:900 ${s * .5}px var(--sans);box-shadow:0 0 0 2px #fff">✓</span>`
const tape = (x, y, w, rot, c = 'rgba(243,210,124,.75)') => `<span style="position:absolute;left:${x}px;top:${y}px;width:${w}px;height:${w * .32}px;background:${c};transform:rotate(${rot}deg);box-shadow:0 1px 2px rgba(0,0,0,.08);mix-blend-mode:multiply"></span>`
const sticky7 = (x, y, w, t, rot = -3, fs = 1, c = C6.sticky) => `<div style="position:absolute;left:${x}px;top:${y}px;width:${w}px;padding:${10 * fs}px ${12 * fs}px;background:${c};transform:rotate(${rot}deg);box-shadow:0 6px 14px rgba(48,36,33,.12);font:400 ${15 * fs}px/1.15 var(--serif);color:${C6.ink}">${t}</div>`
// a red pen ring drawn round something (organic marks, never a font)
const penRing = (x, y, w, h, rot = -6) => `<svg style="position:absolute;left:${x}px;top:${y}px;overflow:visible" width="${w}" height="${h}"><path d="M${w * .52} ${h * .04}C${w * .92} ${h * -.02} ${w * 1.04} ${h * .5} ${w * .9} ${h * .8}C${w * .76} ${h * 1.04} ${w * .2} ${h * 1.06} ${w * .06} ${h * .74}C${w * -.06} ${h * .44} ${w * .14} ${h * .06} ${w * .62} ${h * .1}" fill="none" stroke="${C6.red}" stroke-width="2.4" stroke-linecap="round" transform="rotate(${rot} ${w / 2} ${h / 2})"/></svg>`
const credit7 = (t, fs = 1, dark) => `<span style="display:inline-flex;align-items:center;gap:${5 * fs}px;padding:${3 * fs}px ${8 * fs}px;border-radius:999px;background:${dark ? 'rgba(43,33,31,.72)' : 'rgba(255,255,255,.88)'};color:${dark ? '#fff' : C6.ink};font:600 ${9.5 * fs}px var(--sans)">${t}</span>`
const kick = (t, c = C6.red, fs = 1) => `<div style="font:700 ${10 * fs}px var(--sans);letter-spacing:.14em;color:${c}">${t}</div>`
const btn7 = (t, fs = 1, ghost, full) => `<span style="display:inline-flex;align-items:center;justify-content:center;gap:${6 * fs}px;white-space:nowrap;${full ? 'width:100%;box-sizing:border-box;' : ''}padding:${11 * fs}px ${18 * fs}px;border-radius:999px;font:700 ${13 * fs}px var(--sans);${ghost ? `background:#fff;color:${C6.ink};box-shadow:inset 0 0 0 1.5px ${C6.ink}` : `background:${C6.red};color:#fff`}">${t}</span>`

// ---------------- 1 · Shape filters, filled with what's on ----------------
const SF = [['scallop', 'rosegarden', 'Outside', 4, 1, -6], ['round', 'observatory', 'Stars', 1, 1, 5], ['squircle', 'dog', 'Animals', 2, 0, -4], ['flower', 'rose', 'Gardens', 3, 0, 7], ['arch', 'mission', 'Mission', 2, 0, -3], ['round', 'wisteria', 'Walks', 2, 0, 4]]
const sfTile = ([k, n, t, c, on, rot], s, fs) => `<div style="position:relative;width:${s}px;height:${s}px;opacity:${on ? 1 : .55};filter:${on ? 'none' : 'grayscale(.5)'}">${shapePic(k, n, s, 50, 45, rot)}<div style="position:absolute;left:50%;bottom:${-6 * fs}px;transform:translateX(-50%);padding:${4 * fs}px ${10 * fs}px;border-radius:999px;background:#fff;box-shadow:0 3px 8px rgba(48,36,33,.12);white-space:nowrap;text-align:center"><span style="font:400 ${15 * fs}px var(--serif)">${t}</span> <span style="font:700 ${9 * fs}px var(--sans);color:${C6.muted}">${c}</span></div>${on ? `<span style="position:absolute;right:${2 * fs}px;top:${2 * fs}px">${check7(22 * fs)}</span>` : ''}</div>`
O7.P1 = [ph6(C6.paper, `<div style="padding:12px 20px 0">${H6('What looks', 'good today?', 30)}</div><div style="display:flex;flex-wrap:wrap;gap:22px 10px;justify-content:center;padding:18px 8px 0">${SF.map(x => sfTile(x, 112, 1)).join('')}</div><div style="position:absolute;left:16px;right:16px;bottom:22px;display:flex;align-items:center;justify-content:space-between"><span style="font:600 12px var(--sans)">5 events fit</span>${btn7('Show →', 1)}</div>`),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:70px;width:300px">${H6('What looks', 'good today?', 60)}<div style="font:500 14px var(--sans);color:${C6.muted};margin-top:14px;width:260px">Every shape is a photo from something on today. Tap the ones that look good.</div><div style="margin-top:22px">${btn7('Show 5 →', 1.1)}</div></div><div style="position:absolute;left:420px;top:40px;display:grid;grid-template-columns:repeat(3,170px);gap:34px 14px">${SF.map(x => sfTile(x, 160, 1.15)).join('')}</div>`)]

// ---------------- 2 · Your free hours, matched, with pictures ----------------
const tgt7 = (n, t, sub, fs, on, fx = 50, fy = 45) => `<div style="background:#fff;border-radius:${14 * fs}px;overflow:hidden;box-shadow:0 6px 14px rgba(48,36,33,.08);${on ? `outline:${1.5 * fs}px solid ${C6.red}` : ''}">${pic(n, 100 * fs, 46 * fs, fx, fy)}<div style="padding:${6 * fs}px ${9 * fs}px ${7 * fs}px"><div style="font:400 ${14 * fs}px/1.05 var(--serif)">${t}</div><div style="font:500 ${9 * fs}px var(--sans);color:${C6.muted};margin-top:${2 * fs}px">${sub}</div></div></div>`
const mapRow7 = (t, sub, tint, fs) => `<div style="display:flex;align-items:center;gap:${8 * fs}px;padding:${7 * fs}px ${9 * fs}px;border-radius:${11 * fs}px;background:${tint};margin-top:${5 * fs}px"><span style="width:${8 * fs}px;height:${8 * fs}px;border-radius:2px;background:${tint === '#fff' ? C6.line : 'rgba(48,36,33,.35)'};transform:rotate(45deg)"></span><span style="flex:1;font:600 ${11.5 * fs}px var(--sans)">${t}</span><span style="font:500 ${10 * fs}px var(--sans);color:${C6.muted}">${sub}</span></div>`
const board7 = (fs, W) => { const L = 112 * fs, R = W - 100 * fs
  return `<div style="position:relative;width:${W}px;height:${350 * fs}px">
  <div style="position:absolute;left:0;top:0;width:${L}px">${folder6('Fri', mapRow7('2:10–4:40', '2h30', C6.stub, fs) + mapRow7('6:00–7:30', '1h30', C6.sageT, fs) + mapRow7('after 8', '', '#fff', fs), fs, '#fff', '70%')}</div>
  <div style="position:absolute;left:0;top:${180 * fs}px;width:${L}px">${folder6('Sat', mapRow7('1:00–4:00', '3h', C6.sticky, fs) + mapRow7('evening', '', '#fff', fs), fs, '#fff', '70%')}</div>
  <svg style="position:absolute;left:0;top:0;overflow:visible" width="${W}" height="${350 * fs}">${curve(L, 70 * fs, R, 40 * fs, C6.red)}${curve(L, 130 * fs, R, 230 * fs, C6.sage, 1)}${curve(L, 232 * fs, R, 136 * fs, C6.red)}${curve(L, 100 * fs, R, 318 * fs, C6.red)}</svg>
  <div style="position:absolute;right:0;top:0;width:${100 * fs}px">${tgt7('rosegarden', 'Rose sketch', 'Gardens · 3:00', fs, 1, 50, 55)}</div>
  <div style="position:absolute;right:0;top:${96 * fs}px;width:${100 * fs}px">${tgt7('arbor', 'Wisteria walk', 'Sat · 1:30', fs, 1)}</div>
  <div style="position:absolute;right:0;top:${192 * fs}px;width:${100 * fs}px;opacity:.75">${tgt7('dog', 'Therapy dogs', 'Library · 6:00', fs, 0, 55, 40)}</div>
  <div style="position:absolute;right:0;top:${278 * fs}px;width:${100 * fs}px">${tgt7('observatory', 'Open night', 'Ricard · 8:00', fs, 1, 40, 60)}</div></div>` }
O7.P2 = [ph6(C6.paper, `<div style="padding:8px 16px 0;display:flex;gap:6px;align-items:center">${cb('star', 34, '#fff', C6.red)}<span style="font:500 12px var(--sans);color:${C6.muted}">Discover / <b style="color:${C6.ink}">Match</b></span></div><div style="padding:12px 16px 0">${H6('Your free hours,', 'matched', 30)}</div><div style="padding:14px 14px 0">${board7(1, 252)}</div>${tab6(0)}`),
  dk6('#f5efe4', `<div style="position:absolute;left:60px;top:40px;width:280px">${H6('Your free hours,', 'matched', 56)}<div style="font:500 14px var(--sans);color:${C6.muted};margin-top:14px">Red lines fit. Each thing on the right shows what it looks like, so you know at a glance.</div></div><div style="position:absolute;left:390px;top:26px">${board7(1.5, 560)}</div>`)]

// ---------------- 3 · The claw, with photo capsules ----------------
const capsule = (n, s, fx = 50, fy = 45) => `<div style="position:relative;width:${s}px;height:${s}px;border-radius:50%;overflow:hidden;box-shadow:inset 0 0 0 ${s * .06}px rgba(255,255,255,.85),0 3px 6px rgba(48,36,33,.18)">${pic(n, s, s, fx, fy)}<span style="position:absolute;left:${s * .16}px;top:${s * .12}px;width:${s * .3}px;height:${s * .18}px;border-radius:50%;background:rgba(255,255,255,.55);transform:rotate(-30deg)"></span><span style="position:absolute;left:0;right:0;top:48%;height:${s * .05}px;background:rgba(255,255,255,.7)"></span></div>`
const machine7 = (w, fs) => { const caps = [['rosegarden', 0, 1], ['dog', .2, 0], ['observatory', .42, 2], ['wisteria', .64, 0], ['rose', .1, 1], ['fountain', .52, 1], ['budgie', .78, 1], ['mission', .32, 0]]
  return `<div style="width:${w}px;position:relative">
  <div style="height:${30 * fs}px;border-radius:${12 * fs}px ${12 * fs}px 0 0;background:repeating-linear-gradient(90deg,${C6.red} 0 ${22 * fs}px,${C6.paper} ${22 * fs}px ${44 * fs}px);border:${2.4 * fs}px solid ${C6.ink};border-bottom:none"></div>
  <div style="position:absolute;left:50%;top:${-14 * fs}px;transform:translateX(-50%);padding:${5 * fs}px ${14 * fs}px;border-radius:999px;background:${C6.paper};border:${2.2 * fs}px solid ${C6.ink};font:italic 400 ${15 * fs}px var(--serif);white-space:nowrap">grab a plan</div>
  <div style="position:relative;height:${w * .78}px;border:${2.4 * fs}px solid ${C6.ink};background:linear-gradient(160deg,#fffaf0,#f3ecdc);overflow:hidden">
    <div style="position:absolute;left:${w * .38}px;top:${4 * fs}px">${claw(46 * fs)}</div>
    <div style="position:absolute;left:${w * .38}px;top:${54 * fs}px;transform:rotate(-8deg)">${capsule('arbor', 44 * fs)}</div>
    <div style="position:absolute;left:0;bottom:0;width:100%;height:${w * .42}px">${caps.map(([n, x, r], i) => `<div style="position:absolute;left:${x * (w - 50 * fs)}px;top:${(i % 2 ? 0 : 22) * fs + (r === 2 ? -10 : 0) * fs + (i > 3 ? 28 * fs : 0)}px;transform:rotate(${(i * 37) % 30 - 15}deg)">${i % 3 === 2 ? blob(['round', 'star', 'cloud'][i % 3], [C6.sage, C6.gold, '#c9d7c3'][i % 3], 44 * fs, 'happy') : capsule(n, 46 * fs)}</div>`).join('')}</div>
    <div style="position:absolute;right:${10 * fs}px;top:${10 * fs}px;width:${2 * fs}px;height:${w * .4}px;background:rgba(255,255,255,.9);transform:rotate(12deg)"></div></div>
  <div style="height:${64 * fs}px;border:${2.4 * fs}px solid ${C6.ink};border-top:none;border-radius:0 0 ${12 * fs}px ${12 * fs}px;background:${C6.gold};display:flex;align-items:center;gap:${10 * fs}px;padding:0 ${12 * fs}px">
    <span style="width:${44 * fs}px;height:${34 * fs}px;border-radius:${6 * fs}px;background:${C6.ink};display:grid;place-content:center;color:${C6.gold};font:800 ${9 * fs}px var(--sans)">PLAN</span><span style="flex:1"></span>${[C6.red, C6.paper, C6.paper].map(c => `<span style="width:${16 * fs}px;height:${16 * fs}px;border-radius:50%;background:${c};border:${2 * fs}px solid ${C6.ink}"></span>`).join('')}</div></div>` }
const grabbed7 = fs => `<div style="display:flex;align-items:center;gap:${12 * fs}px;padding:${10 * fs}px;border-radius:${20 * fs}px;background:#fff;box-shadow:0 6px 16px rgba(48,36,33,.08)">${capsule('arbor', 52 * fs)}<div style="flex:1"><div style="font:600 ${10 * fs}px var(--sans);letter-spacing:.1em;color:${C6.red}">YOU GRABBED</div><div style="font:400 ${20 * fs}px/1.05 var(--serif)">Wisteria walk</div><div style="font:500 ${11 * fs}px var(--sans);color:${C6.muted}">Sat 1:30 · fits your free Saturday</div></div>${cb('arrow', 38 * fs, C6.red, '#fff')}</div>`
O7.P3 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${H6('Can’t decide?', 'grab one', 30)}</div><div style="padding:28px 0 0;display:grid;justify-items:center">${machine7(220, 1)}</div><div style="padding:14px 14px 0">${grabbed7(.9)}</div>`),
  dk6(C6.paper, `<div style="position:absolute;left:70px;top:44px">${machine7(330, 1.45)}</div><div style="position:absolute;left:480px;top:40px;width:440px">${H6('Can’t decide?', 'grab one', 66)}<div style="font:500 15px var(--sans);color:${C6.muted};margin-top:16px;width:380px">Every capsule holds a photo of something that fits your week. Pull the lever and the claw brings one back.</div><div style="margin-top:26px">${grabbed7(1.2)}</div></div>`)]

// ---------------- 4 · The lens, over a wall of photos ----------------
const WALL = ['rosegarden', 'observatory', 'dog', 'wisteria', 'fountain', 'rose', 'mission', 'budgie', 'arbor', 'rosegate', 'grotto', 'rosegarden']
const wall = (w, h, c, ex = '') => `<div style="position:absolute;inset:0;display:grid;grid-template-columns:repeat(${c},1fr);gap:4px;${ex}">${WALL.slice(0, c * Math.ceil(12 / c)).map((n, i) => `<div class="ph-${n}" style="background-size:cover;background-position:50% 45%;border-radius:6px"></div>`).join('')}</div>`
const lens7 = (w, h, c, lx, ly, lw, lh, fs) => `<div style="position:relative;width:${w}px;height:${h}px;border-radius:${18 * fs}px;overflow:hidden">${wall(w, h, c, 'filter:blur(5px) saturate(.6);opacity:.65')}<div style="position:absolute;left:${lx}px;top:${ly}px;width:${lw}px;height:${lh}px;border-radius:${lw / 2}px;overflow:hidden;box-shadow:0 0 0 ${3 * fs}px #fff,0 10px 24px rgba(48,36,33,.25)"><div style="position:absolute;left:${-lx}px;top:${-ly}px;width:${w}px;height:${h}px">${wall(w, h, c)}</div></div><div style="position:absolute;left:${lx + lw / 2}px;top:${ly + lh + 8 * fs}px;transform:translateX(-50%);padding:${4 * fs}px ${10 * fs}px;border-radius:999px;background:${C6.ink};color:#fff;font:600 ${10 * fs}px var(--sans);white-space:nowrap">2:10 → 4:40 · 3 fit</div></div>`
O7.P4 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${H6('Drag the lens', 'over your gap', 28)}</div><div style="padding:14px 14px 0">${lens7(252, 290, 3, 64, 56, 124, 150, 1)}</div><div style="padding:16px 18px 0"><div style="display:flex;justify-content:space-between;font:600 11px var(--sans)"><span>Start</span><span>2:10</span></div><div style="height:4px;border-radius:2px;background:${C6.line};margin:8px 0 14px;position:relative"><i style="position:absolute;left:0;width:30%;height:100%;background:${C6.red};border-radius:2px"></i><i style="position:absolute;left:30%;top:-7px;width:18px;height:18px;border-radius:50%;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.2)"></i></div><div style="display:flex;justify-content:space-between;font:600 11px var(--sans)"><span>Length</span><span>2h 30</span></div><div style="height:4px;border-radius:2px;background:${C6.line};margin-top:8px;position:relative"><i style="position:absolute;left:0;width:58%;height:100%;background:${C6.red};border-radius:2px"></i><i style="position:absolute;left:58%;top:-7px;width:18px;height:18px;border-radius:50%;background:#fff;box-shadow:0 2px 6px rgba(0,0,0,.2)"></i></div></div>${tab6(0)}`),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:50px;width:290px">${H6('Drag the lens', 'over your gap', 54)}<div style="font:500 14px var(--sans);color:${C6.muted};margin-top:14px">Everything on today is a photo behind the glass. What sits under the lens fits the time you set.</div><div style="margin-top:22px;display:flex;gap:8px">${chip6('2:10 pm', 1)}${chip6('2h 30', 0)}${chip6('≤ 10 min walk', 0)}</div></div><div style="position:absolute;left:400px;top:24px">${lens7(540, 500, 4, 170, 120, 220, 250, 1.4)}</div>`)]

// ---------------- 5 · Where you overlap, in pictures ----------------
const ov = (n, who, when, sub, w, h, fs, fx = 50, fy = 45) => `<div style="position:relative;width:${w}px;height:${h}px;border-radius:${22 * fs}px;overflow:hidden;box-shadow:0 10px 24px rgba(48,36,33,.14)">${pic(n, w, h, fx, fy)}<div style="position:absolute;left:${12 * fs}px;top:${12 * fs}px">${avs(who, 30 * fs)}</div><div style="position:absolute;left:${10 * fs}px;right:${10 * fs}px;bottom:${10 * fs}px;background:rgba(251,246,237,.94);border-radius:${14 * fs}px;padding:${10 * fs}px ${12 * fs}px"><div style="font:600 ${9.5 * fs}px var(--sans);color:${C6.muted}">Overlap with ${who === 'JK' ? 'Kai' : who === 'JA' ? 'Ari' : 'Priya'}</div><div style="font:400 ${20 * fs}px/1.05 var(--serif)">${when}</div><div style="font:600 ${10 * fs}px var(--sans);margin-top:${2 * fs}px">${sub}</div></div></div>`
O7.P5 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${H6('See where you', 'overlap', 28)}<div style="font:500 11px var(--sans);color:${C6.muted};margin-top:6px">Only shared free time, never anyone’s schedule.</div></div><div style="padding:14px 14px 0;display:grid;gap:12px">${ov('arbor', 'JK', 'Thursday 3 → 5', 'Wisteria walk fits both of you', 252, 210, 1)}${ov('observatory', 'JA', 'Friday after 8', 'Open night at Ricard', 252, 150, .9, 40, 60)}</div>${tab6(0)}`),
  dk6(C6.paper, `<div style="position:absolute;left:56px;top:28px">${H6('See where you', 'overlap', 50)}</div><div style="position:absolute;left:56px;top:170px;display:flex;gap:18px">${ov('arbor', 'JK', 'Thu 3 → 5', 'Wisteria walk fits both', 280, 360, 1.15)}${ov('observatory', 'JA', 'Fri after 8', 'Open night at Ricard', 280, 360, 1.15, 40, 60)}${ov('rosegarden', 'JP', 'Sat 1 → 4', 'Rose garden sketch', 280, 360, 1.15, 50, 55)}</div>`)]

// ---------------- 6 · "Still on?" with the photo ----------------
const lockBg = `linear-gradient(170deg,#3a2621,#7a3b2a 55%,#2a1e1c)`
const notif = (fs) => `<div style="border-radius:${22 * fs}px;background:rgba(251,246,237,.92);overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.25)">${pic('arbor', 260 * fs, 120 * fs, 50, 40)}<div style="padding:${12 * fs}px ${14 * fs}px"><div style="display:flex;align-items:center;gap:${8 * fs}px;font:700 ${10 * fs}px var(--sans);letter-spacing:.06em;color:${C6.muted}"><span style="width:${18 * fs}px;height:${18 * fs}px;border-radius:${5 * fs}px;background:${C6.red};color:#fff;display:grid;place-content:center;font:900 ${10 * fs}px var(--sans)">S</span>SIDEQUEST<span style="flex:1"></span>now</div><div style="font:700 ${14 * fs}px/1.25 var(--sans);margin-top:${6 * fs}px;color:${C6.ink}">Wisteria walk is tomorrow at 1:30</div><div style="font:500 ${12.5 * fs}px/1.35 var(--sans);color:${C6.ink};margin-top:${2 * fs}px">Still on? Kai is going. The flowers are about a week from gone.</div></div></div><div style="display:flex;gap:${8 * fs}px;margin-top:${10 * fs}px"><span style="flex:1;text-align:center;padding:${12 * fs}px;border-radius:999px;background:${C6.red};color:#fff;font:700 ${14 * fs}px var(--sans)">Still on</span><span style="flex:1;text-align:center;padding:${12 * fs}px;border-radius:999px;background:rgba(251,246,237,.92);color:${C6.ink};font:700 ${14 * fs}px var(--sans)">Drop it</span></div>`
O7.P6 = [phoneW(`<div style="position:absolute;inset:0;background:${lockBg}"></div>`, `<div style="text-align:center;color:#fff;padding-top:30px"><div style="font:600 13px var(--sans);opacity:.85">Friday, November 13</div><div style="font:300 76px/1 var(--sans);letter-spacing:-2px">8:05</div></div><div style="padding:18px 10px 0">${notif(1)}</div>`, 1),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:60px;width:330px">${H6('Still on?', 'two days out', 56)}<div style="font:500 14px var(--sans);color:${C6.muted};margin-top:14px">The nudge carries the photo of the plan, so you remember why you said yes. Two verbs, no app to open.</div></div><div style="position:absolute;left:520px;top:20px;width:420px;height:500px;border-radius:26px;background:${lockBg};padding:26px 30px;box-sizing:border-box"><div style="text-align:center;color:#fff"><div style="font:600 14px var(--sans);opacity:.85">Friday, November 13</div><div style="font:300 64px/1 var(--sans)">8:05</div></div><div style="margin-top:14px">${notif(1.38)}</div></div>`)]

// ---------------- 7 · Post: your photo becomes a stamp ----------------
const stamp7 = (n, w, h, fs, fx = 50, fy = 45, rot = -3, label = '') => { const m = 9 * fs, d = 10 * fs
  return `<div style="position:relative;width:${w}px;height:${h}px;padding:${m}px;box-sizing:border-box;background:radial-gradient(circle,${C6.paper} ${3 * fs}px,transparent ${3.4 * fs}px) ${-d / 2}px ${-d / 2}px/${d}px ${d}px,#fff;transform:rotate(${rot}deg);filter:drop-shadow(0 8px 14px rgba(48,36,33,.16))">${pic(n, w - 2 * m, h - 2 * m - (label ? 22 * fs : 0), fx, fy)}${label ? `<div style="display:flex;justify-content:space-between;align-items:center;height:${22 * fs}px;font:400 ${12 * fs}px var(--serif)"><span>${label}</span><span style="font:700 ${9 * fs}px var(--sans);color:${C6.red}">SQ</span></div>` : ''}</div>` }
O7.P7 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${kick('POST · 2 OF 4')}<div style="margin-top:6px">${H6('Make it a', 'stamp', 30)}</div><div style="font:500 11.5px var(--sans);color:${C6.muted};margin-top:6px;width:230px">Your photo goes on the card. Drag it inside the frame to choose what shows.</div></div><div style="position:relative;height:250px;margin-top:10px"><div style="position:absolute;left:48px;top:10px">${stamp7('rosegarden', 184, 220, 1, 55, 50, -3, 'Rose garden sketch')}</div><div style="position:absolute;left:182px;top:186px">${sticky7(0, 0, 90, 'drag to move', 5, .75)}</div></div><div style="padding:6px 16px 0;display:flex;gap:8px;align-items:center"><span style="width:52px;height:52px;border-radius:10px;border:2px dashed ${C6.line};display:grid;place-content:center;font:400 22px var(--serif)">+</span>${['rose', 'fountain', 'rosegate'].map(n => `<span style="border-radius:10px;overflow:hidden;opacity:.8">${pic(n, 52, 52)}</span>`).join('')}</div><div style="position:absolute;left:16px;right:16px;bottom:22px;display:flex;gap:8px">${btn7('Use this', 1, 0, 1)}${btn7('Skip', .9, 1)}</div>`),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:46px;width:330px">${kick('POST · STEP 2 OF 4', C6.red, 1.2)}<div style="margin-top:10px">${H6('Make it a', 'stamp', 58)}</div><div style="font:500 14px var(--sans);color:${C6.muted};margin-top:12px">Drop a photo and it becomes the stamp on your event card. Drag it inside the frame. No photo? The drawing for your category goes on instead.</div><div style="margin-top:22px;display:flex;gap:10px">${btn7('Use this photo', 1.1)}${btn7('Keep the drawing', 1.1, 1)}</div></div><div style="position:absolute;left:470px;top:30px">${stamp7('rosegarden', 300, 360, 1.5, 55, 50, -3, 'Rose garden sketch')}</div><div style="position:absolute;left:600px;top:420px">${sticky7(0, 0, 150, 'drag the photo to move it', 5, 1)}</div><div style="position:absolute;left:800px;top:60px;display:grid;gap:10px">${['rose', 'fountain', 'rosegate'].map(n => `<span style="border-radius:12px;overflow:hidden;opacity:.85;box-shadow:0 4px 10px rgba(0,0,0,.1)">${pic(n, 80, 80)}</span>`).join('')}<span style="width:80px;height:80px;border-radius:12px;border:2px dashed rgba(48,36,33,.25);display:grid;place-content:center;font:400 30px var(--serif)">+</span></div>`, 'Post')]

// ---------------- 8 · Post: one point decides every crop ----------------
const viewf = (w, h, fs, fx = .58, fy = .42) => `<div style="position:relative;width:${w}px;height:${h}px">${pic('rosegarden', w, h, 50, 50, `border-radius:${10 * fs}px`)}${[[0, 0, 0], [1, 0, 90], [1, 1, 180], [0, 1, 270]].map(([x, y, r]) => `<span style="position:absolute;left:${x * w - (x ? 22 : -6) * fs}px;top:${y * h - (y ? 22 : -6) * fs}px;width:${16 * fs}px;height:${16 * fs}px;border-left:${3 * fs}px solid #fff;border-top:${3 * fs}px solid #fff;transform:rotate(${r}deg)"></span>`).join('')}${penRing(w * fx - 30 * fs, h * fy - 26 * fs, 60 * fs, 52 * fs)}</div>`
const crops = (fs) => `<div style="display:flex;gap:${10 * fs}px;align-items:flex-end">${[[96, 72, '4:3 card'], [96, 54, 'detail'], [44, 44, 'row']].map(([w, h, t]) => `<div><div style="border-radius:${8 * fs}px;overflow:hidden;box-shadow:0 4px 10px rgba(0,0,0,.12)">${pic('rosegarden', w * fs, h * fs, 62, 40)}</div><div style="font:600 ${9.5 * fs}px var(--sans);color:${C6.muted};margin-top:${4 * fs}px">${t}</div></div>`).join('')}</div>`
O7.P8 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${kick('POST · 2 OF 4')}<div style="margin-top:6px">${H6('Circle what', 'matters', 30)}</div></div><div style="padding:12px 16px 0">${viewf(248, 186, 1)}</div><div style="padding:14px 16px 0">${crops(.95)}</div><div style="position:absolute;left:150px;top:470px">${sticky7(0, 0, 120, 'every shape crops around your circle', 4, .7)}</div><div style="position:absolute;left:16px;right:16px;bottom:22px">${btn7('Looks right', 1, 0, 1)}</div>`),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:46px;width:290px">${kick('POST · STEP 2 OF 4', C6.red, 1.2)}<div style="margin-top:10px">${H6('Circle what', 'matters', 58)}</div><div style="font:500 14px var(--sans);color:${C6.muted};margin-top:12px">Tap once on the part that must always show. The card, the event page and the list all crop around it.</div><div style="margin-top:22px">${btn7('Looks right', 1.1)}</div></div><div style="position:absolute;left:390px;top:36px">${viewf(380, 285, 1.4)}</div><div style="position:absolute;left:390px;top:350px">${crops(1.35)}</div><div style="position:absolute;left:800px;top:380px">${sticky7(0, 0, 150, 'one circle, every shape', 4, 1)}</div>`, 'Post')]

// ---------------- 9 · The event as a ticket ----------------
const tix = (w, fs, n = 'observatory') => `<div style="position:relative;width:${w}px;filter:drop-shadow(0 12px 20px rgba(48,36,33,.16))"><div style="background:#fff;border-radius:${18 * fs}px ${18 * fs}px 0 0;overflow:hidden">${pic(n, w, w * .62, 40, 60)}<div style="padding:${12 * fs}px ${16 * fs}px ${14 * fs}px;position:relative">${kick('FRI · RICARD OBSERVATORY', C6.red, fs)}<div style="font:400 ${26 * fs}px/1 var(--serif);margin-top:${6 * fs}px">Open night</div><div style="font:500 ${11 * fs}px var(--sans);color:${C6.muted};margin-top:${4 * fs}px">The big dome opens if it’s clear. Bring a jacket.</div><span style="position:absolute;right:${12 * fs}px;top:${-30 * fs}px;padding:${4 * fs}px ${8 * fs}px;border:${1.5 * fs}px solid ${C6.blue};color:${C6.blue};border-radius:${4 * fs}px;font:800 ${8.5 * fs}px var(--sans);letter-spacing:.1em;transform:rotate(-8deg);background:rgba(255,255,255,.9)">VIA SCU EVENTS</span></div></div><div style="height:${16 * fs}px;background:radial-gradient(circle at 0 50%,transparent ${9 * fs}px,#fff ${9.5 * fs}px) left/51% 100% no-repeat,radial-gradient(circle at 100% 50%,transparent ${9 * fs}px,#fff ${9.5 * fs}px) right/51% 100% no-repeat;position:relative"><i style="position:absolute;left:${16 * fs}px;right:${16 * fs}px;top:50%;border-top:${1.5 * fs}px dashed ${C6.line}"></i></div><div style="background:#fff;border-radius:0 0 ${18 * fs}px ${18 * fs}px;padding:${12 * fs}px ${16 * fs}px;display:flex;align-items:center;gap:${12 * fs}px"><div>${mono6('8:00', 34 * fs)}<span style="font:600 ${12 * fs}px var(--sans);color:${C6.muted}"> pm</span></div><div style="flex:1;font:600 ${11 * fs}px var(--sans)">${avs('JKA', 22 * fs)} <span style="color:${C6.muted}">+9 going</span></div>${cb('plus', 40 * fs, C6.red, '#fff')}</div></div>`
O7.P9 = [ph6(C6.paper, `<div style="padding:8px 16px 0;display:flex;justify-content:space-between">${back6()}${cb('share', 38)}</div><div style="padding:12px 18px 0">${tix(244, .95)}</div>${tab6(0)}`),
  dk6('#f5efe4', `<div style="position:absolute;left:70px;top:30px">${tix(380, 1.35)}</div><div style="position:absolute;left:560px;top:50px;width:380px">${H6('Fits your', 'evening', 54)}<div style="font:500 14px var(--sans);color:${C6.muted};margin-top:14px">You’re free from 7:30. Ricard is 6 minutes from Benson.</div><div style="margin-top:22px">${folder6('Going', `<div style="display:flex;align-items:center;gap:10px">${avs('JKAM', 32)}<span style="font:600 13px var(--sans)">Kai, Ari, Maya and 8 more</span></div>`, 1.1, '#fff', '40%')}</div><div style="margin-top:18px;font:600 12px var(--sans);color:${C6.muted}">Photo via SCU Events · <u>Report photo</u></div></div>`)]

// ---------------- 10 · Paste a link, the picture develops ----------------
const polaroid = (n, w, fs, rot = 3, cap = 'via SCU Events', dev = 1) => `<div style="width:${w}px;padding:${10 * fs}px ${10 * fs}px ${40 * fs}px;background:#fffdf8;box-shadow:0 12px 26px rgba(48,36,33,.18);transform:rotate(${rot}deg);position:relative">${pic(n, w - 20 * fs, w - 20 * fs, 50, 40, `filter:sepia(${1 - dev}) brightness(${.7 + .3 * dev}) contrast(${.8 + .2 * dev})`)}<div style="position:absolute;left:${12 * fs}px;bottom:${12 * fs}px;font:italic 400 ${15 * fs}px var(--serif);color:${C6.ink}">${cap}</div></div>`
O7.P10 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${kick('POST · FROM A LINK')}<div style="margin-top:6px">${H6('Paste it,', 'watch it develop', 26)}</div></div><div style="padding:12px 16px 0"><div style="display:flex;align-items:center;gap:8px;padding:10px 14px;border-radius:999px;background:#fff;box-shadow:0 2px 8px rgba(48,36,33,.08);font:500 12px var(--sans)">${I6('pin', 14, C6.red)}events.scu.edu/…/advent-concert</div></div><div style="position:relative;height:300px"><div style="position:absolute;left:42px;top:24px">${polaroid('mission', 200, 1, 3, 'Advent concert · via SCU Events', .85)}</div><div style="position:absolute;left:150px;top:250px">${sticky7(0, 0, 112, 'we credit the page it came from', -4, .7)}</div></div><div style="position:absolute;left:16px;right:16px;bottom:22px;display:flex;gap:8px">${btn7('Use it', 1, 0, 1)}${btn7('Upload', .9, 1)}</div>`),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:50px;width:350px">${kick('POST · FROM A LINK', C6.red, 1.2)}<div style="margin-top:10px">${H6('Paste it,', 'watch it develop', 52)}</div><div style="margin-top:20px;display:flex;align-items:center;gap:10px;padding:12px 16px;border-radius:999px;background:#fff;box-shadow:0 2px 8px rgba(48,36,33,.08);font:500 14px var(--sans)">${I6('pin', 16, C6.red)}events.scu.edu/…/advent-concert</div><div style="font:500 13px var(--sans);color:${C6.muted};margin-top:14px">Title, time and place come in too. Instagram posts can’t be pulled in, so upload those yourself.</div><div style="margin-top:20px;display:flex;gap:10px">${btn7('Use it', 1.1)}${btn7('Use my own photo', 1.1, 1)}</div></div><div style="position:absolute;left:520px;top:30px">${polaroid('mission', 300, 1.4, 3, 'Advent concert · via SCU Events', 1)}</div><div style="position:absolute;left:780px;top:60px">${polaroid('mission', 130, .8, -8, '', .25)}</div><div style="position:absolute;left:800px;top:400px">${sticky7(0, 0, 150, 'credited to the page it came from', -4, 1)}</div>`, 'Post')]

// ---------------- 11 · Flyers taped up whole, logos as pins ----------------
const flyer7 = (w, fs) => `<div style="position:relative;width:${w}px;height:${w * 1.3}px;background:${C6.blue};padding:${10 * fs}px;box-sizing:border-box;color:#fff;box-shadow:0 8px 16px rgba(48,36,33,.16)"><div class="ph-rose" style="height:46%;border-radius:2px;background-size:cover;background-position:50% 45%"></div><div style="font:800 ${w * .14}px/1 var(--sans);margin-top:${8 * fs}px;letter-spacing:-.02em">FALL JAM</div><div style="font:500 ${w * .055}px/1.3 var(--sans);margin-top:${4 * fs}px;opacity:.9">Persimmon jam workshop<br>Benson patio · Thu 4:30</div></div>`
const pin7 = (t, s, c) => `<span style="width:${s}px;height:${s}px;border-radius:50%;background:${c};color:#fff;display:grid;place-content:center;font:800 ${s * .3}px var(--sans);box-shadow:inset 0 -${s * .08}px 0 rgba(0,0,0,.2),inset 0 0 0 ${s * .06}px rgba(255,255,255,.4),0 4px 8px rgba(0,0,0,.2)">${t}</span>`
O7.P11 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${H6('Flyers stay', 'whole', 30)}<div style="font:500 11.5px var(--sans);color:${C6.muted};margin-top:6px;width:240px">Most club pictures are flyers or logos. We tape flyers up as they are and make logos into pins.</div></div><div style="position:relative;height:300px;margin-top:10px"><div style="position:absolute;left:20px;top:20px;transform:rotate(-4deg)">${flyer7(130, .9)}</div>${tape(48, 10, 70, -8)}<div style="position:absolute;left:168px;top:40px">${penRing(0, 0, 96, 60, 4)}<div style="padding:16px 14px;font:400 15px/1.1 var(--serif)">Thu 4:30</div></div><div style="position:absolute;left:170px;top:150px;display:grid;justify-items:center;gap:6px">${pin7('PC', 64, C6.blue)}<span style="font:600 10px var(--sans);color:${C6.muted}">Photo Club</span></div></div>${tab6(0)}`),
  dk6('#efe3d0', `<div style="position:absolute;left:60px;top:50px;width:300px">${H6('Flyers stay', 'whole', 58)}<div style="font:500 14px var(--sans);color:${C6.muted};margin-top:14px">Of five events in the SCU feed on Nov 7, one picture was a photo. Cropping a flyer cuts its words, so we tape it up as it is. A logo becomes a pin on the host’s name.</div></div><div style="position:absolute;left:420px;top:40px;transform:rotate(-4deg)">${flyer7(220, 1.4)}</div>${tape(470, 28, 110, -8)}<div style="position:absolute;left:690px;top:70px;transform:rotate(3deg)">${flyer7(160, 1)}</div>${tape(720, 58, 80, 6, 'rgba(213,223,233,.8)')}<div style="position:absolute;left:880px;top:320px;display:grid;justify-items:center;gap:8px">${pin7('PC', 84, C6.blue)}<span style="font:600 12px var(--sans);color:${C6.muted}">Photo Club</span></div><div style="position:absolute;left:720px;top:340px;display:grid;justify-items:center;gap:8px">${pin7('AC', 70, C6.terra)}<span style="font:600 12px var(--sans);color:${C6.muted}">Art Club</span></div>`)]

// ---------------- 12 · Report, kept calm ----------------
const reasons7 = ['Not from this event', 'Someone in it didn’t agree', 'Offensive or unsafe', 'It’s my photo, uncredited']
O7.P12 = [ph6(C6.paper, `<div style="padding:12px 18px 0;display:flex;gap:12px;align-items:center">${shapePic('squircle', 'dog', 70, 55, 40, -4)}<div>${blob('round', '#c9d7c3', 46, 'meh')}</div></div><div style="padding:12px 18px 0">${H6('Something off', 'about this photo?', 26)}<div style="font:500 11.5px var(--sans);color:${C6.muted};margin-top:6px">The event stays up. Only the photo gets checked, and it’s hidden for you now.</div></div><div style="padding:14px 16px 0;display:flex;flex-wrap:wrap;gap:8px">${reasons7.map((r, i) => chip6(r, i === 1, .95, C6.red)).join('')}</div><div style="position:absolute;left:16px;right:16px;bottom:22px;display:flex;gap:8px">${btn7('Report photo', 1, 0, 1)}${btn7('Cancel', .9, 1)}</div>`),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:46px;display:flex;gap:16px;align-items:flex-end">${shapePic('squircle', 'dog', 220, 55, 40, -4)}${blob('round', '#c9d7c3', 90, 'meh', 6)}</div><div style="position:absolute;left:520px;top:50px;width:420px">${H6('Something off', 'about this photo?', 50)}<div style="font:500 14px var(--sans);color:${C6.muted};margin-top:12px">The event stays up. Only the photo gets checked, and it’s hidden for you right now.</div><div style="margin-top:20px;display:flex;flex-wrap:wrap;gap:10px">${reasons7.map((r, i) => chip6(r, i === 1, 1.1, C6.red)).join('')}</div><div style="margin-top:26px;display:flex;gap:10px">${btn7('Report photo', 1.1)}${btn7('Cancel', 1.1, 1)}</div></div>`)]

// ---------------- 13 · The photo check, as a pile ----------------
const pileCard = (n, t, who, why, w, fs, rot, z, dx = 0, dy = 0) => `<div style="position:absolute;left:${dx}px;top:${dy}px;width:${w}px;transform:rotate(${rot}deg);z-index:${z};background:#fff;border-radius:${18 * fs}px;overflow:hidden;box-shadow:0 10px 24px rgba(48,36,33,.14)">${pic(n, w, w * .8)}<div style="padding:${10 * fs}px ${14 * fs}px ${12 * fs}px"><div style="font:400 ${18 * fs}px var(--serif)">${t}</div><div style="font:500 ${10.5 * fs}px var(--sans);color:${C6.muted}">${who}</div><div style="font:700 ${9.5 * fs}px var(--sans);letter-spacing:.08em;color:${why.includes('REPORT') ? C6.red : C6.sage};margin-top:${4 * fs}px">${why}</div></div></div>`
const qpile = (w, fs) => `<div style="position:relative;width:${w}px;height:${w * 1.08}px">${pileCard('fountain', 'Fountain clean-up', 'Sustainability · new host', 'FIRST UPLOAD', w, fs, 8, 1, 26 * fs, 18 * fs)}${pileCard('rosegarden', 'Rose garden sketch', 'Art Club · new host', 'FIRST UPLOAD', w, fs, -7, 2, -22 * fs, 8 * fs)}${pileCard('budgie', 'Pet portraits', 'Photo Club', '2 REPORTS · NOT FROM THIS EVENT', w, fs, 1, 3)}<span style="position:absolute;left:${w * .56}px;top:${w * .1}px;z-index:4;padding:${5 * fs}px ${10 * fs}px;border:${2.5 * fs}px solid ${C6.red};border-radius:${6 * fs}px;color:${C6.red};font:800 ${15 * fs}px var(--sans);letter-spacing:.12em;transform:rotate(14deg);background:rgba(255,255,255,.75)">NOPE?</span></div>`
O7.P13 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${kick('PHOTO CHECK · TEAM ONLY')}<div style="margin-top:6px">${H6('Keep or', 'take down?', 28)}</div></div><div style="padding:18px 34px 0">${qpile(212, .9)}</div><div style="position:absolute;left:16px;right:16px;bottom:22px;display:flex;gap:8px">${btn7('← Remove', .95, 1)}${btn7('Keep →', .95, 0, 1)}</div>`),
  dk6(C6.paper, `<div style="position:absolute;left:60px;top:46px;width:320px">${kick('PHOTO CHECK · TEAM ONLY', C6.red, 1.2)}<div style="margin-top:10px">${H6('3 waiting,', 'one reported', 52)}</div><div style="font:500 14px var(--sans);color:${C6.muted};margin-top:12px">Swipe right to keep, left to take down. Taking down deletes the file and tells the host why.</div><div style="margin-top:22px;display:flex;gap:10px">${btn7('← Take down', 1.1, 1)}${btn7('Keep →', 1.1)}</div></div><div style="position:absolute;left:520px;top:30px">${qpile(320, 1.2)}</div>`)]

// ---------------- 14 · Your week, kept (recap) ----------------
const scrap = (w, fs) => `<div style="position:relative;width:${w}px;height:${w * 1.25}px;background:#fffdf8;border-radius:${10 * fs}px;box-shadow:0 14px 30px rgba(48,36,33,.16);overflow:hidden;${GRID}">
  <div style="position:absolute;left:${w * .06}px;top:${w * .06}px;transform:rotate(-4deg)">${stamp7('observatory', w * .44, w * .52, fs * .7, 40, 60, 0)}</div>
  <div style="position:absolute;left:${w * .5}px;top:${w * .12}px;transform:rotate(4deg)">${stamp7('rose', w * .42, w * .5, fs * .7, 50, 55, 0)}</div>
  <div style="position:absolute;left:${w * .2}px;top:${w * .58}px;transform:rotate(-1deg)">${stamp7('arbor', w * .5, w * .42, fs * .7, 50, 45, 0)}</div>
  ${tape(w * .14, w * .03, w * .2, -10)}${tape(w * .64, w * .09, w * .18, 12, 'rgba(213,223,233,.85)')}
  <div style="position:absolute;right:${w * .05}px;top:${w * .7}px">${blob('star', C6.gold, 40 * fs, 'happy', 12)}</div>
  <div style="position:absolute;left:${w * .07}px;bottom:${w * .05}px"><div class="cap9" style="font:400 ${10 * fs}px/2 var(--serif);letter-spacing:.16em">your week, in the gaps</div><div style="font:400 ${20 * fs}px var(--serif);position:relative">3 side quests · <span style="position:relative">6 hours${penRing(-8 * fs, -8 * fs, 76 * fs, 36 * fs, 3)}</span></div></div></div>`
O7.P14 = [ph6(C6.paper, `<div style="padding:10px 18px 0">${kick('SUNDAY RECAP')}<div style="margin-top:6px">${H6('Your week,', 'kept', 30)}</div></div><div style="padding:14px 34px 0">${scrap(212, .9)}</div><div style="position:absolute;left:16px;right:16px;bottom:22px;display:flex;gap:8px">${btn7('Share', 1, 0, 1)}${btn7('Swap photos', .9, 1)}</div>`),
  dk6('#f5efe4', `<div style="position:absolute;left:60px;top:60px;width:340px">${kick('SUNDAY RECAP', C6.red, 1.2)}<div style="margin-top:10px">${H6('Your week,', 'kept', 60)}</div><div style="font:500 14px var(--sans);color:${C6.muted};margin-top:12px">Made from the photos you took at each thing: stamps, tape and one red circle round the number worth bragging about.</div><div style="margin-top:22px;display:flex;gap:10px">${btn7('Share', 1.1)}${btn7('Swap photos', 1.1, 1)}</div></div><div style="position:absolute;left:540px;top:18px">${scrap(360, 1.5)}</div>`)]

SEC7.push({ h: 'Discover', say: 'The mechanics you kept, now carrying real photos: shape filters cut from photos, the free-hours board with pictures on the right, the claw full of photo capsules, the lens over a wall of photos, overlap cards, and “Still on?” with the picture.', o: [['P1', 'Shape filters, cut from photos', 'Your kept shape filters, but each shape is a photo of something on today. Tap the ones that look good.'], ['P2', 'Free hours, matched, with pictures', 'Your kept mapping board. The targets now show what each thing looks like, so a glance is enough.'], ['P3', 'The claw, full of photo capsules', 'Your kept claw machine. Capsules hold photos of things that fit, mixed in with the shape characters.'], ['P4', 'The lens, over a wall of photos', 'The lens from round 4: everything on today is a blurred photo wall, and what sits under the glass fits your gap.'], ['P5', 'Overlap cards, in pictures', 'See-where-you-overlap, with the photo of the thing you could do together as the card.'], ['P6', 'Still on? With the photo', 'Your kept lock-screen nudge, now carrying the photo of the plan so you remember why you said yes.']] })
SEC7.push({ h: 'Post, events and the rest', say: 'Posting a photo, showing an event, flyers, reports, the team’s check, and the recap, in tickets, stamps, polaroids, tape, pins and sticky notes from your references.', o: [['P7', 'Your photo becomes a stamp', 'Drop a photo and it becomes the perforated stamp on your card. Drag inside the frame. Or keep the drawing.'], ['P8', 'Circle what matters', 'One red pen circle on the photo decides the crop for the card, the event page and the list row.'], ['P9', 'The event as a ticket', 'Photo on top, a tear line, the stub with a big 8:00 and who’s going. The credit is a little rubber stamp.'], ['P10', 'Paste a link, watch it develop', 'A pasted event link turns into a polaroid that develops, credited in its margin.'], ['P11', 'Flyers taped up whole', 'Flyers are taped up as they are with the time circled in red pen. Logos become pins.'], ['P12', 'Something off about this photo?', 'Report in the same voice as everything else: a worried character, four chip reasons, two buttons.'], ['P13', 'The photo check, as a pile', 'For the team: a pile of photos to swipe, keep or take down, with the reason printed on each.'], ['P14', 'Your week, kept', 'The recap as a scrapbook page: your photos as stamps, tape, a character, a red circle round the hours.']] })
