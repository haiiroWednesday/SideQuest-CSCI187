
// =================== ROUND 8 (review: Round 12) · louder, and thought through ===================
// Built from Cynthia's reference screens: whole-screen color, numbers as the hero, tilted sticky cards,
// sticker piles, corner-arrow tiles, hatched charts. Checked against the CSCI 187 UX lenses
// (layout, hierarchy, controls, feedback, style, wording) and the Laws of UX board.
// Every option is [phone, desktop, phone in its empty or error state].
const SEC8 = [], O8 = {}
const C8 = Object.assign({}, C6, { maroon: '#751728', pink: '#f3e4dc', night: '#241b19' })
const N8 = (t, s, c = C8.ink, ex = '') => `<span style="font:400 ${s}px/.82 var(--serif);letter-spacing:-.035em;color:${c};${ex}">${t}</span>`
const K8 = (t, c = C8.red, fs = 1) => `<div style="font:700 ${10.5 * fs}px/1 var(--sans);letter-spacing:.14em;color:${c}">${t}</div>`
const B8 = (t, bg = C8.ink, col = '#fff', fs = 1, full, arrow = 1) => `<span style="display:inline-flex;align-items:center;justify-content:center;gap:${8 * fs}px;${full ? 'width:100%;box-sizing:border-box;' : ''}min-height:${46 * fs}px;padding:0 ${20 * fs}px;border-radius:999px;background:${bg};color:${col};font:700 ${14 * fs}px var(--sans);white-space:nowrap;${bg === 'none' ? `box-shadow:inset 0 0 0 ${1.6 * fs}px ${col}` : ''}">${t}${arrow ? I6('arrow', 16 * fs) : ''}</span>`
const ne8 = (s = 34, bg = '#fff', col = C8.ink) => cb('ne', s, bg, col, 0)
const hatch8 = (c = 'rgba(48,36,33,.28)', gap = 7) => `repeating-linear-gradient(135deg,${c} 0 1.6px,transparent 1.6px ${gap}px)`
const nav8 = (on = 0, dark) => `<div style="position:absolute;left:14px;right:14px;bottom:12px;height:58px;border-radius:29px;background:${dark ? '#17110f' : '#fff'};box-shadow:0 10px 24px rgba(36,27,25,.22);display:flex;align-items:center;justify-content:space-between;padding:0 8px;z-index:6">${[['home', 'Discover'], ['plus', 'Post'], ['cal', 'Schedule'], ['user', 'Friends']].map(([k, t], i) => i === on
  ? `<span style="display:inline-flex;align-items:center;gap:7px;height:42px;padding:0 16px;border-radius:21px;background:${dark ? C8.gold : C8.ink};color:${dark ? C8.ink : '#fff'};font:700 12.5px var(--sans)">${I6(k, 18)}${t}</span>`
  : `<span style="display:grid;justify-items:center;gap:2px;width:52px;font:600 9px var(--sans);color:${dark ? 'rgba(255,255,255,.62)' : '#6f6660'}">${I6(k, 19)}${t}</span>`).join('')}</div>`
// phone: body is 280 x 556 under the status bar
const P8 = (bg, inner, { light = false, nav = 0, navDark = false } = {}) => phoneW(`<div style="position:absolute;inset:0;background:${bg}"></div>`, `<div style="position:absolute;left:0;right:0;top:44px;bottom:0">${inner}</div>${nav === null ? '' : nav8(nav, navDark)}`, light)
const D8 = (bg, inner, on = 'Discover', dark) => dk6(bg, inner, on, dark)
const at = (x, y, inner, ex = '') => `<div style="position:absolute;left:${x}px;top:${y}px;${ex}">${inner}</div>`
const stkr = (n, s, rot = 0, round = 1, fx = 50, fy = 45) => `<div style="width:${s}px;height:${s}px;padding:${Math.max(3, s * .06)}px;box-sizing:border-box;background:#fff;border-radius:${round ? '50%' : s * .22 + 'px'};transform:rotate(${rot}deg);box-shadow:0 5px 12px rgba(36,27,25,.28)">${pic(n, s - 2 * Math.max(3, s * .06), s - 2 * Math.max(3, s * .06), fx, fy, `border-radius:${round ? '50%' : s * .17 + 'px'}`)}</div>`
const EV8 = [['2:30', '3:00', 'Therapy dogs', 'Library lawn', 'dog', 4, 55, 40], ['3:00', '4:00', 'Rose garden sketch', 'Mission Gardens', 'rosegarden', 6, 50, 55], ['3:30', '4:30', 'Ceramics open studio', 'Arts 104', 'rosegate', 8, 50, 50], ['4:00', '4:30', 'Fountain clean-up', 'Mission lawn', 'fountain', 5, 50, 50], ['2:15', '3:15', 'Wisteria walk', 'Mission arbor', 'arbor', 3, 50, 45]]

// ---------------- D1 · Tonight, by the number ----------------
const band8 = (n, label, sub, fs, o = {}) => `<div style="display:flex;align-items:flex-end;gap:${8 * fs}px;height:${104 * fs}px"><div style="width:${116 * fs}px;text-align:right;flex:none">${N8(n, 124 * fs, o.ncol || '#fff')}</div><div style="flex:1;min-height:${72 * fs}px;border-radius:${20 * fs}px 0 0 ${20 * fs}px;background:${o.bg || 'rgba(255,255,255,.1)'};color:${o.col || '#fff'};padding:${12 * fs}px ${44 * fs}px ${12 * fs}px ${14 * fs}px;box-sizing:border-box;position:relative"><div style="font:700 ${15 * fs}px/1.1 var(--sans)">${label}</div><div style="font:500 ${11 * fs}px/1.25 var(--sans);opacity:.8;margin-top:${3 * fs}px">${sub}</div>${o.extra || ''}</div></div>`
const bands8 = fs => band8('12', 'on tonight', 'across campus', fs, { extra: at(0, 0, '', `left:auto;right:${10 * fs}px;top:${22 * fs}px`).replace('></div>', `>${ne8(28 * fs, 'rgba(255,255,255,.14)', '#fff')}</div>`) })
  + band8('5', 'fit your gap', '2:10 to 4:40, under 8 min away', fs, { bg: C8.gold, col: C8.ink, ncol: C8.gold, extra: `<div style="position:absolute;right:${10 * fs}px;top:${20 * fs}px">${cb('arrow', 32 * fs, C8.ink, '#fff', 0)}</div>` })
  + band8('2', 'with friends', 'Kai and Ari', fs, { extra: `<div style="position:absolute;right:${10 * fs}px;top:${24 * fs}px">${avs('KA', 22 * fs, C8.maroon)}</div>` })
const mini8 = ([a, b, t, p], fs = 1, w = 106) => `<div style="flex:none;width:${w * fs}px;background:${C8.paper};color:${C8.ink};border-radius:${14 * fs}px;padding:${10 * fs}px ${11 * fs}px;box-sizing:border-box"><div>${N8(a, 26 * fs)}</div><div style="font:700 ${11 * fs}px/1.15 var(--sans);margin-top:${4 * fs}px">${t}</div><div style="font:500 ${9.5 * fs}px var(--sans);color:${C8.muted};margin-top:${2 * fs}px">${p}</div></div>`
const row8 = ([a, b, t, p, n, walk, fx, fy], fs = 1, first) => `<div style="display:flex;align-items:center;gap:${14 * fs}px;padding:${10 * fs}px ${12 * fs}px;border-radius:${18 * fs}px;${first ? `background:#fff;box-shadow:0 6px 16px rgba(48,36,33,.1)` : ''}">${pic(n, 62 * fs, 62 * fs, fx, fy, `border-radius:${14 * fs}px;flex:none`)}<div style="width:${86 * fs}px;flex:none">${N8(a, 38 * fs)}<div style="font:500 ${10.5 * fs}px var(--sans);color:${C8.muted}">until ${b}</div></div><div style="flex:1;min-width:0"><div style="font:400 ${21 * fs}px/1.05 var(--serif)">${t}</div><div style="font:500 ${11.5 * fs}px var(--sans);color:${C8.muted};margin-top:${3 * fs}px">${p} · ${walk} min walk</div></div>${first ? B8('I’m in', C8.red, '#fff', .82 * fs, 0, 0) : cb('arrow', 34 * fs, C8.stub, C8.ink, 0)}</div>`
O8.A1 = [
  P8(C8.maroon, `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 18px 0">${K8('TONIGHT · WED NOV 11', C8.gold)}${av6('J', 28, C8.gold, C8.maroon).replace('color:#fff', `color:${C8.ink}`)}</div><div style="margin-top:6px">${bands8(1)}</div><div style="padding:22px 0 0 16px">${K8('THE 5, SOONEST FIRST', 'rgba(255,255,255,.7)')}<div style="display:flex;gap:8px;margin-top:10px;overflow:hidden">${[EV8[0], EV8[1], EV8[2]].map(e => mini8(e)).join('')}</div></div>`, { light: true, navDark: true }),
  D8(C8.maroon, `${at(0, 26, `<div style="width:470px">${bands8(1.42)}</div>`)}${at(40, 500, `<div style="font:500 13px var(--sans);color:rgba(255,255,255,.7)">Each number is a filter. Tap one and the list on the right changes.</div>`)}${at(520, 16, `<div style="width:456px;height:536px;background:${C8.paper};border-radius:26px;padding:20px 16px;box-sizing:border-box"><div style="display:flex;justify-content:space-between;align-items:center;padding:0 10px 12px">${`<div style="font:400 28px var(--serif)">5 that fit <i style="color:${C8.red}">2:10 to 4:40</i></div>`}${chip6('Soonest', 1, .9)}</div>${EV8.map((e, i) => row8(e, 1.02, !i)).join('')}</div>`)}`, 'Discover', 1),
  P8(C8.maroon, `<div style="padding:6px 18px 0">${K8('TONIGHT · WED NOV 11', C8.gold)}</div><div style="position:relative;height:230px;margin-top:8px"><div style="position:absolute;left:28px;top:0">${N8('0', 270, '#fff')}</div><div style="position:absolute;left:150px;top:6px">${blob('cloud', '#c9d7c3', 92, 'sleepy', 8)}</div></div><div style="padding:0 20px"><div style="font:400 30px/1.05 var(--serif);color:#fff">Nothing on tonight.</div><div style="font:500 13px/1.4 var(--sans);color:rgba(255,255,255,.78);margin-top:8px">Wednesdays are quiet. Tomorrow has 7, and 3 of them fit your afternoon.</div><div style="margin-top:18px;display:grid;gap:10px">${B8('See tomorrow’s 7', C8.gold, C8.ink, 1, 1)}${B8('Post something for tonight', 'none', '#fff', 1, 1, 0)}</div></div>`, { light: true, navDark: true })]

// ---------------- D2 · Three stickies for your gap ----------------
// Fanned so each note's time and name stay readable. No headline: the gap sits in one pill, the notes do the talking.
const stk8 = (bg, col, [a, b, t, p, n, walk, fx, fy], rot, x, y, w, fs, front) => `<div style="position:absolute;left:${x}px;top:${y}px;width:${w}px;height:${front ? w * .88 : w * .7}px;background:${bg};color:${col};border-radius:${4 * fs}px ${4 * fs}px ${22 * fs}px ${4 * fs}px;transform:rotate(${rot}deg);box-shadow:0 12px 24px rgba(48,36,33,.24);padding:${12 * fs}px ${16 * fs}px;box-sizing:border-box"><div style="display:flex;align-items:baseline;gap:${8 * fs}px;white-space:nowrap">${N8(a, 26 * fs, col)}<span style="font:400 ${front ? 27 * fs : 21 * fs}px/1 var(--serif)">${front ? '' : t}</span></div>${front ? `<div style="font:400 ${30 * fs}px/.98 var(--serif);margin-top:${6 * fs}px;width:64%">${t}</div><div style="position:absolute;left:${16 * fs}px;bottom:${14 * fs}px;font:600 ${11.5 * fs}px/1.35 var(--sans)">${p}<br><span style="opacity:.7;font-weight:500">until ${b} · ${walk} min walk</span></div><div style="position:absolute;right:${12 * fs}px;bottom:${12 * fs}px">${cb('arrow', 40 * fs, C8.red, '#fff', 0)}</div><div style="position:absolute;right:${10 * fs}px;top:${10 * fs}px">${stkr(n, 70 * fs, 7, 1, fx, fy)}</div>` : ''}</div>`
const gapPill8 = (t, sub, fs = 1) => `<span style="display:inline-flex;align-items:center;gap:${8 * fs}px;padding:${7 * fs}px ${7 * fs}px ${7 * fs}px ${14 * fs}px;border-radius:999px;background:${C8.ink};color:#fff;font:700 ${12.5 * fs}px var(--sans);white-space:nowrap">${t}<span style="padding:${4 * fs}px ${9 * fs}px;border-radius:999px;background:${C8.gold};color:${C8.ink}">${sub}</span></span>`
const fan8 = (fs, x = 0, y = 0) => `${stk8(C8.sage, '#fff', EV8[2], -7, x + 14 * fs, y, 214 * fs, fs)}${stk8(C8.pink, C8.ink, EV8[0], 5, x + 44 * fs, y + 58 * fs, 214 * fs, fs)}${stk8(C8.paper, C8.ink, EV8[1], -2, x + 26 * fs, y + 120 * fs, 228 * fs, fs, 1)}`
O8.A2 = [
  P8(C8.gold, `<div style="text-align:center;padding-top:8px">${gapPill8('2:10 to 4:40', '2h 30 free')}</div><div style="position:relative;height:330px;margin-top:14px">${fan8(1)}</div><div style="display:flex;justify-content:space-between;align-items:center;padding:0 22px"><span style="font:400 20px/1.1 var(--serif)">Three that fit.<br>Two more behind.</span>${B8('Shuffle', 'none', C8.ink, .86, 0, 0)}</div>`, {}),
  D8(C8.gold, `<div style="position:absolute;left:0;top:0;width:1000px;height:569px">${stk8(C8.sage, '#fff', EV8[2], -6, 70, 44, 300, 1.35)}${stk8(C8.pink, C8.ink, EV8[0], 4, 640, 30, 300, 1.35)}${stk8(C8.paper, C8.ink, EV8[1], -2, 318, 96, 360, 1.6, 1)}</div>${at(70, 290, `<div style="width:230px;font:500 14px/1.5 var(--sans)">Picked from 12 on today. They start after 2:10, end before Stats at 4:40, and sit under 8 minutes from Benson.</div>`)}${at(0, 470, `<div style="width:1000px;display:flex;justify-content:center;align-items:center;gap:14px">${gapPill8('2:10 to 4:40', '2h 30 free', 1.15)}${B8('Take the 3:00', C8.ink, '#fff', 1.05)}${B8('Shuffle', 'none', C8.ink, 1.05, 0, 0)}</div>`)}`),
  P8(C8.gold, `<div style="text-align:center;padding-top:8px">${gapPill8('2:10 to 2:30', '20 min free')}</div><div style="position:relative;height:290px"><div style="position:absolute;left:34px;top:46px;width:212px;background:${C8.paper};border-radius:4px 4px 22px 4px;transform:rotate(-4deg);box-shadow:0 12px 24px rgba(48,36,33,.24);padding:18px;box-sizing:border-box"><div style="font:400 29px/1.02 var(--serif)">Twenty minutes is too short for anything on campus.</div><div style="font:600 12px/1.4 var(--sans);color:${C8.muted};margin-top:10px">Your longest gap today is 6:00 to 7:30. Four things fit it.</div></div><div style="position:absolute;right:22px;top:14px">${blob('tri', C8.sage, 62, 'meh', 12)}</div></div><div style="padding:0 20px;display:grid;gap:10px">${B8('Plan the 6:00 gap', C8.ink, '#fff', 1, 1)}${B8('Show everything today', 'none', C8.ink, 1, 1, 0)}</div>`, {})]

// ---------------- D3 · The gap is the hero ----------------
// A small Gantt: time runs left to right from 2:00 to 5:00, one row per event, walk time hatched in front.
const mins = t => { const [h, m] = t.split(':').map(Number); return (h - 2) * 60 + m }
const gantt8 = (w, rows, fs, pick = 1) => { const pm = w / 180, rh = 36 * fs, H = rows.length * rh + 26 * fs
  return `<div style="position:relative;width:${w}px;height:${H}px">
  ${[0, 60, 120, 180].map((m, i) => `<span style="position:absolute;left:${m * pm}px;top:0;bottom:${18 * fs}px;border-left:1px solid rgba(48,36,33,.14)"></span><span style="position:absolute;left:${m * pm - 8 * fs}px;bottom:0;width:${16 * fs}px;text-align:center;font:600 ${10 * fs}px var(--sans);color:${C8.muted}">${2 + i}</span>`).join('')}
  <span style="position:absolute;left:0;top:0;width:${10 * pm}px;bottom:${18 * fs}px;background:${hatch8()}"></span><span style="position:absolute;left:${160 * pm}px;right:0;top:0;bottom:${18 * fs}px;background:${hatch8()}"></span>
  ${rows.map(([a, b, t, p, n, walk], i) => { const x = mins(a) * pm, ww = (mins(b) - mins(a)) * pm, on = i === pick, right = x >= w * .45
    return `<span style="position:absolute;${right ? `right:${w - x - ww}px;text-align:right` : `left:${x}px`};top:${i * rh + 1 * fs}px;font:${on ? 700 : 600} ${10.5 * fs}px/1 var(--sans);color:${on ? C8.red : C8.ink};white-space:nowrap">${a} ${t}</span><span style="position:absolute;left:${x - walk * pm}px;top:${i * rh + 15 * fs}px;width:${walk * pm}px;height:${12 * fs}px;background:${hatch8(C8.goldI, 5)};border-radius:${4 * fs}px 0 0 ${4 * fs}px"></span><span style="position:absolute;left:${x}px;top:${i * rh + 14 * fs}px;width:${ww}px;height:${14 * fs}px;border-radius:${5 * fs}px;background:${on ? C8.red : C8.sage}"></span>` }).join('')}
  <span style="position:absolute;left:${10 * pm}px;top:${-4 * fs}px;bottom:${18 * fs}px;border-left:${2 * fs}px solid ${C8.ink}"></span><span style="position:absolute;left:${160 * pm}px;top:${-4 * fs}px;bottom:${18 * fs}px;border-left:${2 * fs}px dashed ${C8.ink}"></span></div>` }
const clock8 = (h, m, fs, c = C8.ink) => `<div style="display:flex;align-items:flex-end;gap:${4 * fs}px"><div>${N8(h, 150 * fs, c)}<div style="font:600 ${10 * fs}px var(--sans);color:${C8.muted};margin-top:${6 * fs}px">hours</div></div>${N8(':', 110 * fs, c, `margin-bottom:${26 * fs}px`)}<div>${N8(m, 150 * fs, c)}<div style="font:600 ${10 * fs}px var(--sans);color:${C8.muted};margin-top:${6 * fs}px">minutes</div></div></div>`
O8.A3 = [
  P8(C8.sticky, `<div style="display:grid;justify-items:center;padding-top:6px">${K8('YOU’RE FREE FOR')}<div style="margin-top:10px">${clock8('2', '30', 1)}</div></div><div style="padding:14px 14px 0"><div style="background:#fff;border-radius:18px;padding:14px 12px 10px;box-shadow:0 6px 16px rgba(48,36,33,.08)"><div style="display:flex;justify-content:space-between;font:600 10px var(--sans);color:${C8.muted};margin-bottom:8px"><span>now 2:10</span><span>Stats 4:40</span></div>${gantt8(228, [EV8[0], EV8[1], EV8[2]], 1)}</div></div><div style="padding:12px 20px 0">${B8('Take the 3:00', C8.ink, '#fff', .95, 1)}</div>`, {}),
  D8(C8.sticky, `${at(40, 60, `<div style="width:380px;display:grid;justify-items:center">${K8('YOU’RE FREE FOR', C8.red, 1.2)}<div style="margin-top:14px">${clock8('2', '30', 1.35)}</div><div style="font:500 15px/1.45 var(--sans);margin-top:18px;text-align:center;width:300px">Chem just ended. <b>Stats starts 4:40</b> in Kenna.</div><div style="margin-top:22px;display:flex;gap:10px">${B8('Take the 3:00', C8.ink, '#fff', 1.05)}${B8('All 12 today', 'none', C8.ink, 1.05, 0, 0)}</div></div>`)}${at(440, 24, `<div style="width:520px;background:#fff;border-radius:24px;padding:22px 24px 16px;box-shadow:0 10px 26px rgba(48,36,33,.1);box-sizing:border-box"><div style="display:flex;justify-content:space-between;font:600 12px var(--sans);color:${C8.muted};margin-bottom:12px"><span>now 2:10</span><span>Stats 4:40</span></div>${gantt8(472, EV8, 2.1)}<div style="display:flex;gap:16px;margin-top:14px;font:600 11px var(--sans);color:${C8.muted}"><span><i style="display:inline-block;width:14px;height:10px;background:${C8.red};border-radius:3px;vertical-align:-1px"></i> picked</span><span><i style="display:inline-block;width:14px;height:10px;background:${C8.sage};border-radius:3px;vertical-align:-1px"></i> fits</span><span><i style="display:inline-block;width:14px;height:10px;background:${hatch8(C8.goldI, 5)};vertical-align:-1px"></i> the walk there</span><span><i style="display:inline-block;width:14px;height:10px;background:${hatch8()};vertical-align:-1px"></i> class</span></div></div>`)}`),
  P8(C8.sticky, `<div style="display:grid;justify-items:center;padding-top:6px">${K8('YOU’RE FREE FOR')}<div style="margin-top:10px">${clock8('0', '20', 1, C8.muted)}</div></div><div style="padding:18px 22px 0;text-align:center"><div style="font:400 28px/1.08 var(--serif)">Not enough for anything, and that’s fine.</div><div style="font:500 13px/1.45 var(--sans);color:${C8.muted};margin-top:8px">The closest event is a 9 minute walk. Your next gap with room is <b style="color:${C8.ink}">6:00 to 7:30</b>.</div></div><div style="padding:18px 20px 0;display:grid;gap:10px">${B8('Plan the 6:00 gap', C8.ink, '#fff', 1, 1)}${B8('Nudge me at 5:45', 'none', C8.ink, 1, 1, 0)}</div>`, {})]

// ---------------- D4 · The sticker pile ----------------
const tag8 = (t, bg, col, rot, fs = 1) => `<span style="display:inline-block;padding:${6 * fs}px ${12 * fs}px;border-radius:${8 * fs}px;background:${bg};color:${col};font:800 ${11 * fs}px var(--sans);letter-spacing:.06em;transform:rotate(${rot}deg);box-shadow:0 4px 10px rgba(36,27,25,.25);white-space:nowrap">${t}</span>`
const pile8 = (w, h, fs) => { const X = w / 280, Y = h / 300
  return `<div style="position:relative;width:${w}px;height:${h}px">
  ${at(6 * X, 172 * Y, stkr('rosegarden', 96 * fs, -10, 0, 50, 55))}${at(176 * X, 0, stkr('observatory', 92 * fs, 8, 1, 40, 60))}${at(14 * X, 8 * Y, stkr('dog', 84 * fs, -6, 1, 55, 40))}${at(184 * X, 200 * Y, stkr('arbor', 88 * fs, 12, 0))}${at(104 * X, 220 * Y, stkr('fountain', 70 * fs, -4, 1))}
  ${at(112 * X, 2 * Y, pin7('PC', 50 * fs, C8.blue))}${at(230 * X, 100 * Y, pin7('AC', 42 * fs, C8.terra))}
  ${at(88 * X, 58 * Y, blob('star', C8.gold, 50 * fs, 'wow', -12))}${at(6 * X, 100 * Y, blob('round', '#c9d7c3', 40 * fs, 'happy', 10))}${at(166 * X, 268 * Y, blob('cloud', '#e9c46a', 44 * fs, 'sleepy', -8))}
  ${at(150 * X, 180 * Y, tag8('FREE FOOD', C8.paper, C8.red, -7, fs))}${at(20 * X, 274 * Y, tag8('+3 FRIENDS', C8.ink, '#fff', 5, fs))}
  <div style="position:absolute;left:50%;top:44%;transform:translate(-50%,-50%) rotate(-4deg)"><span style="display:inline-flex;align-items:center;gap:${10 * fs}px;padding:${14 * fs}px ${22 * fs}px;border-radius:999px;background:${C8.gold};color:${C8.ink};box-shadow:0 12px 26px rgba(36,27,25,.35);white-space:nowrap">${N8('5', 44 * fs)}<span style="font:700 ${14 * fs}px/1.1 var(--sans)">fit you<br>this week</span>${cb('arrow', 34 * fs, C8.ink, '#fff', 0)}</span></div></div>` }
const seg8 = (a, b, fs = 1) => `<span style="display:inline-flex;padding:${3 * fs}px;border-radius:999px;background:rgba(255,255,255,.16)"><span style="padding:${6 * fs}px ${12 * fs}px;border-radius:999px;background:#fff;color:${C8.ink};font:700 ${11 * fs}px var(--sans)">${a}</span><span style="padding:${6 * fs}px ${12 * fs}px;color:#fff;font:700 ${11 * fs}px var(--sans)">${b}</span></span>`
O8.A4 = [
  P8(C8.sage, `<div style="display:flex;justify-content:space-between;align-items:flex-start;padding:6px 18px 0"><div style="font:400 50px/.9 var(--serif);color:#fff;letter-spacing:-.02em">What’s<br>on</div>${seg8('Pile', 'List')}</div><div style="margin-top:2px">${pile8(280, 310, 1)}</div><div style="padding:0 18px;font:400 50px/.9 var(--serif);color:#fff;letter-spacing:-.02em;text-align:right">this week</div>`, { light: true, navDark: true }),
  D8(C8.sage, `${at(56, 44, `<div style="font:400 104px/.86 var(--serif);color:#fff;letter-spacing:-.03em">What’s<br>on this<br>week</div><div style="margin-top:22px">${seg8('Pile', 'List', 1.2)}</div><div style="font:500 14px/1.45 var(--sans);color:rgba(255,255,255,.8);margin-top:16px;width:300px">Every sticker is an event: photos from hosts, pins for clubs. Tap one to peel it off. List shows the same things in rows.</div>`)}${at(400, 10, pile8(580, 540, 1.75))}`, 'Discover', 1),
  P8(C8.sage, `<div style="display:flex;justify-content:space-between;align-items:flex-start;padding:6px 18px 0"><div style="font:400 50px/.9 var(--serif);color:#fff;letter-spacing:-.02em">Quiet<br>week</div>${seg8('Pile', 'List')}</div><div style="position:relative;height:210px">${at(60, 110, blob('round', '#c9d7c3', 64, 'sleepy', -8))}${at(132, 96, blob('star', C8.gold, 76, 'meh', 10))}${at(84, 30, tag8('NOTHING POSTED YET', C8.paper, C8.ink, -5))}</div><div style="padding:0 20px"><div style="font:500 13px/1.45 var(--sans);color:rgba(255,255,255,.85)">Finals week does this. The SCU calendar adds new events every morning at 6.</div><div style="margin-top:16px;display:grid;gap:10px">${B8('Post the first one', C8.gold, C8.ink, 1, 1)}${B8('See next week', 'none', '#fff', 1, 1, 0)}</div></div>`, { light: true, navDark: true })]

// ---------------- D5 · Home in tiles ----------------
// One tile per question. Saturated blocks from our palette, a number as each tile's headline, a corner arrow to go deeper.
const tile8 = (bg, inner, h, fs = 1, col = '#fff', btn = 1) => `<div style="position:relative;height:${h}px;background:${bg};color:${col};border-radius:${24 * fs}px;padding:${14 * fs}px;box-sizing:border-box;overflow:hidden">${inner}${btn ? `<div style="position:absolute;right:${10 * fs}px;top:${10 * fs}px">${ne8(30 * fs, bg === C8.gold || bg === '#fff' ? C8.ink : 'rgba(255,255,255,.18)', '#fff')}</div>` : ''}</div>`
const tl8 = (t, fs = 1) => `<div style="font:700 ${11 * fs}px var(--sans);opacity:.85">${t}</div>`
const ring8 = (s, pct, c = C8.gold) => `<svg width="${s}" height="${s}" viewBox="0 0 40 40"><circle cx="20" cy="20" r="16" fill="none" stroke="rgba(255,255,255,.22)" stroke-width="5"/><circle cx="20" cy="20" r="16" fill="none" stroke="${c}" stroke-width="5" stroke-linecap="round" stroke-dasharray="${pct} 100.5" transform="rotate(-90 20 20)"/></svg>`
const T8 = {
  gap: (h, fs) => tile8(C8.red, `${tl8('Your next gap', fs)}<div style="position:absolute;left:${14 * fs}px;bottom:${12 * fs}px">${N8('2:10', 78 * fs, '#fff')}</div><div style="position:absolute;right:${14 * fs}px;bottom:${14 * fs}px;display:grid;justify-items:end;gap:${6 * fs}px">${ring8(38 * fs, 70)}<div style="text-align:right;font:700 ${11 * fs}px/1.25 var(--sans)">2h 30 free</div></div>`, h, fs),
  fit: (h, fs) => tile8(C8.sage, `${tl8('Fit that gap', fs)}<div style="position:absolute;left:${14 * fs}px;bottom:${10 * fs}px">${N8('5', 92 * fs, C8.gold)}</div><div style="position:absolute;right:${10 * fs}px;bottom:${10 * fs}px;display:flex">${[['round', '#c9d7c3', 'happy'], ['star', C8.gold, 'wow'], ['cloud', C8.paper, 'happy']].map(([k, c, m], i) => `<span style="margin-left:${i ? -9 * fs : 0}px">${blob(k, c, 32 * fs, m)}</span>`).join('')}</div>`, h, fs),
  kai: (h, fs) => tile8(C8.gold, `${tl8('Also free', fs)}<div style="margin-top:${10 * fs}px">${avs('KA', 32 * fs, C8.gold)}</div><div style="position:absolute;left:${14 * fs}px;bottom:${12 * fs}px;font:400 ${25 * fs}px/1 var(--serif)">Kai, 3 to 5</div>`, h, fs, C8.ink),
  leave: (h, fs) => tile8(C8.night, `${tl8('Leave by', fs)}<div style="position:absolute;left:${14 * fs}px;bottom:${10 * fs}px;display:flex;align-items:flex-end;gap:${10 * fs}px">${N8('2:52', 58 * fs, C8.gold)}<div style="font:600 ${11.5 * fs}px/1.3 var(--sans);padding-bottom:${3 * fs}px">Rose garden sketch<br><span style="opacity:.7;font-weight:500">6 min from Benson</span></div></div>`, h, fs),
  some: (h, fs) => tile8(C8.blue, `${tl8('Someday', fs)}<div style="position:absolute;left:${14 * fs}px;bottom:${12 * fs}px;font:400 ${24 * fs}px/1.02 var(--serif)">2 ideas are<br>ready this week</div>`, h, fs),
  night: (h, fs) => tile8('#fff', `${tl8('On tonight', fs)}<div style="position:absolute;left:${14 * fs}px;bottom:${10 * fs}px;display:flex;align-items:flex-end;gap:${10 * fs}px">${N8('12', 76 * fs, C8.ink)}<div style="font:600 ${12 * fs}px/1.3 var(--sans);padding-bottom:${4 * fs}px">events<br>on campus</div></div>`, h, fs, C8.ink) }
const ghost8 = (t, sub, h, fs = 1) => `<div style="height:${h}px;border:${1.6 * fs}px dashed rgba(48,36,33,.3);border-radius:${24 * fs}px;padding:${14 * fs}px;box-sizing:border-box"><div style="font:700 ${11 * fs}px var(--sans);color:${C8.muted}">${t}</div><div style="font:500 ${11.5 * fs}px/1.35 var(--sans);color:${C8.muted};margin-top:${6 * fs}px">${sub}</div></div>`
const day8 = (fs = 1) => `<div style="display:flex;justify-content:space-between;align-items:center"><span style="font:700 ${11 * fs}px var(--sans);letter-spacing:.14em">WED · NOV 11 · 2:10 PM</span>${av6('J', 28 * fs, C8.red)}</div>`
O8.A5 = [
  P8(C8.paper, `<div style="padding:6px 18px 0">${day8()}</div><div style="padding:12px 14px 0;display:grid;gap:8px">${T8.gap(132, 1)}<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">${T8.fit(128, 1)}${T8.kai(128, 1)}</div>${T8.leave(104, 1)}</div>`, {}),
  D8(C8.paper, `${at(44, 6, `<div style="width:912px">${day8(1.15)}</div>`)}<div style="position:absolute;left:44px;top:48px;width:912px;display:grid;grid-template-columns:1.45fr 1fr 1fr;gap:14px"><div style="display:grid;gap:14px">${T8.gap(290, 1.7)}${T8.leave(194, 1.5)}</div><div style="display:grid;gap:14px">${T8.fit(242, 1.6)}${T8.some(242, 1.5)}</div><div style="display:grid;gap:14px">${T8.kai(242, 1.5)}${T8.night(242, 1.5)}</div></div>`),
  P8(C8.paper, `<div style="padding:6px 18px 0">${day8()}</div><div style="padding:12px 14px 0;display:grid;gap:8px">${tile8(C8.red, `${tl8('Start here')}<div style="font:400 28px/1.02 var(--serif);margin-top:10px;width:210px">Add your classes and your gaps show up.</div><div style="position:absolute;left:14px;bottom:14px">${B8('Add classes', C8.gold, C8.ink, .84)}</div>`, 168, 1, '#fff', 0)}<div style="display:grid;grid-template-columns:1fr 1fr;gap:8px">${ghost8('Fit that gap', 'Events that fit will count up here.', 100)}${ghost8('Also free', 'Add a friend to see shared time.', 100)}</div>${T8.night(100, 1)}</div>`, {})]
