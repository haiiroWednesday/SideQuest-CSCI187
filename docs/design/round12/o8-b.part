
// ---------------- E1 · The event as a poster with a stub ----------------
const stat8 = (n, l, fs = 1, c = C8.ink) => `<div style="flex:1;text-align:center">${N8(n, 46 * fs, c)}<div style="font:600 ${10.5 * fs}px var(--sans);color:${C8.muted};margin-top:${6 * fs}px">${l}</div></div>`
const sep8 = fs => `<span style="width:1px;background:${C8.line};margin:${4 * fs}px 0"></span>`
const tear8 = (bg, fs = 1) => `<div style="position:relative;height:${18 * fs}px"><i style="position:absolute;left:${16 * fs}px;right:${16 * fs}px;top:50%;border-top:${1.6 * fs}px dashed rgba(48,36,33,.28)"></i><i style="position:absolute;left:${-9 * fs}px;top:0;width:${18 * fs}px;height:${18 * fs}px;border-radius:50%;background:${bg}"></i><i style="position:absolute;right:${-9 * fs}px;top:0;width:${18 * fs}px;height:${18 * fs}px;border-radius:50%;background:${bg}"></i></div>`
const stampC = (t, fs = 1, c = '#fff') => `<span style="display:inline-block;padding:${4 * fs}px ${8 * fs}px;border:${1.5 * fs}px solid ${c};color:${c};border-radius:${4 * fs}px;font:800 ${8.5 * fs}px var(--sans);letter-spacing:.1em;transform:rotate(-6deg);white-space:nowrap">${t}</span>`
const poster8 = (w, h, fs, off) => `<div style="position:relative;width:${w}px;height:${h}px;overflow:hidden">${pic('observatory', w, h, 40, 60, off ? 'filter:grayscale(1) brightness(.8)' : '')}<div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(36,27,25,.35) 0,rgba(36,27,25,0) 34%,rgba(36,27,25,.82) 100%)"></div>
  <div style="position:absolute;left:${16 * fs}px;top:${48 * fs}px">${back6(fs, 1).replace('rgba(255,255,255,.1)', 'rgba(255,255,255,.92)').replace('color:#fff', `color:${C8.ink}`)}</div><div style="position:absolute;right:${16 * fs}px;top:${48 * fs}px">${cb('share', 38 * fs, 'rgba(255,255,255,.92)')}</div>
  ${off ? `<div style="position:absolute;left:-10%;right:-10%;top:42%;transform:rotate(-8deg);background:${C8.red};color:#fff;text-align:center;font:800 ${15 * fs}px/${34 * fs}px var(--sans);letter-spacing:.3em">CANCELLED</div>` : `<div style="position:absolute;right:${14 * fs}px;top:${104 * fs}px">${stampC('PHOTO VIA SCU EVENTS', fs)}</div>`}
  <div style="position:absolute;left:${18 * fs}px;right:${18 * fs}px;bottom:${16 * fs}px">${K8('FRI NOV 13 · RICARD OBSERVATORY', C8.gold, fs)}<div style="font:400 ${56 * fs}px/.92 var(--serif);color:#fff;letter-spacing:-.02em;margin-top:${8 * fs}px;${off ? 'text-decoration:line-through;text-decoration-thickness:2px;opacity:.8' : ''}">Open night</div></div></div>`
O8.B1 = [
  P8(C8.night, `<div style="position:absolute;left:0;top:-44px">${poster8(280, 318, 1)}</div><div style="position:absolute;left:0;right:0;top:274px;bottom:0;background:${C8.paper};border-radius:0 0 34px 34px"><div style="display:flex;padding:16px 10px 8px">${stat8('8:00', 'starts, pm')}${sep8(1)}${stat8('1h', 'long')}${sep8(1)}${stat8('6', 'min walk')}</div>${tear8(C8.night)}<div style="display:flex;align-items:center;gap:10px;padding:8px 18px 0">${avs('KAM', 28, C8.paper)}<div style="font:600 12.5px/1.25 var(--sans)">Kai, Ari and 7 more<br><span style="font-weight:500;color:${C8.muted}">You’re free from 7:30</span></div></div><div style="display:flex;gap:8px;padding:14px 16px 0"><span style="flex:1">${B8('I’m in', C8.red, '#fff', 1, 1, 0)}</span>${B8('Maybe', 'none', C8.ink, 1, 0, 0)}</div><div style="text-align:center;font:500 10.5px var(--sans);color:${C8.muted};margin-top:10px">Saves it to My Schedule. No sign-up needed.</div></div>`, { light: true, nav: null }),
  D8(C8.night, `<div style="position:absolute;left:0;top:0">${poster8(520, 569, 1.5).replace(/top:72px/g, 'top:20px').replace('top:156px', 'top:26px;right:90px')}</div><div style="position:absolute;left:520px;top:0;width:480px;height:569px;background:${C8.paper};box-sizing:border-box;padding:34px 36px"><div style="display:flex">${stat8('8:00', 'starts, pm', 1.5)}${sep8(1.5)}${stat8('1h', 'long', 1.5)}${sep8(1.5)}${stat8('6', 'min walk', 1.5)}</div><div style="margin:18px -36px 0">${tear8(C8.night, 1.5)}</div><div style="font:400 30px/1.1 var(--serif);margin-top:18px">It fits your evening. <i style="color:${C8.red}">You’re free from 7:30.</i></div><div style="font:500 14px/1.5 var(--sans);color:${C8.muted};margin-top:10px">The big dome opens if the sky is clear. Bring a jacket, the roof is cold.</div><div style="display:flex;align-items:center;gap:12px;margin-top:20px">${avs('KAM', 34, C8.paper)}<div style="font:600 14px var(--sans)">Kai, Ari, Maya and 6 more are in</div></div><div style="display:flex;gap:10px;margin-top:26px">${B8('I’m in', C8.red, '#fff', 1.15, 0, 0).replace('padding:0 23px', 'padding:0 64px')}${B8('Maybe', 'none', C8.ink, 1.15, 0, 0)}</div><div style="font:500 12px var(--sans);color:${C8.muted};margin-top:14px">Saves it to My Schedule. No sign-up needed. · <u>Report photo</u></div></div>`, 'Discover', 1),
  P8(C8.night, `<div style="position:absolute;left:0;top:-44px">${poster8(280, 318, 1, 1)}</div><div style="position:absolute;left:0;right:0;top:274px;bottom:0;background:${C8.paper};border-radius:0 0 34px 34px;padding:18px 18px 0;box-sizing:border-box"><div style="font:400 27px/1.08 var(--serif)">The host cancelled this on Thursday.</div><div style="font:500 13px/1.45 var(--sans);color:${C8.muted};margin-top:8px">It’s off your schedule, and your Friday evening is free again from 7:30.</div><div style="display:grid;gap:9px;margin-top:16px">${B8('3 like this, this week', C8.ink, '#fff', 1, 1)}${B8('Tell me if it comes back', 'none', C8.ink, 1, 1, 0)}</div></div>`, { light: true, nav: null })]

// ---------------- E2 · Does it fit? ----------------
// One strip of your afternoon, top to bottom. Classes are hatched, the walk is striped gold, the event is solid.
const strip8 = (w, fs, { s, e, name, to, back, bad }) => { const pm = 1.5 * fs, H = 180 * pm, y = t => mins(t) * pm, lab = 34 * fs, tw = w - lab
  const seg = (y0, h, bg, txt, col = C8.ink, ex = '') => `<div style="position:absolute;left:${lab}px;top:${y0}px;width:${tw}px;height:${h}px;background:${bg};color:${col};font:700 ${10.5 * fs}px/1.1 var(--sans);box-sizing:border-box;padding:${Math.min(6 * fs, h / 4)}px ${10 * fs}px;overflow:hidden;${ex}">${txt}</div>`
  const endY = Math.min(y(e), H), over = bad ? y(e) - y('4:40') : 0
  return `<div style="position:relative;width:${w}px;height:${H}px"><div style="position:absolute;left:${lab}px;top:0;width:${tw}px;height:${H}px;background:#fff;border-radius:${14 * fs}px"></div>
  ${['2', '3', '4', '5'].map((t, i) => `<span style="position:absolute;left:0;top:${i * 60 * pm - 6 * fs}px;font:600 ${10.5 * fs}px var(--sans);color:${C8.muted}">${t}:00</span>${i && i < 3 ? `<i style="position:absolute;left:${lab}px;right:0;top:${i * 60 * pm}px;border-top:1px solid ${C8.line}"></i>` : ''}`).join('')}
  ${seg(0, y('2:10'), hatch8(), 'Chem', C8.muted, `border-radius:${14 * fs}px ${14 * fs}px 0 0`)}
  ${seg(y(s) - to * pm, to * pm, hatch8(C8.goldI, 5), '')}<span style="position:absolute;left:${lab + 10 * fs}px;top:${y(s) - to * pm - 15 * fs}px;font:600 ${10 * fs}px var(--sans);color:${C8.goldI}">${to} min walk</span>
  ${seg(y(s), endY - y(s) - over, bad ? C8.muted : C8.sage, `<span style="font:400 ${19 * fs}px var(--serif)">${name}</span><br><span style="font-weight:500;opacity:.85">${s} to ${e}</span>`, '#fff', `border-radius:${10 * fs}px ${10 * fs}px ${bad ? 0 : 10 * fs}px ${bad ? 0 : 10 * fs}px`)}
  ${bad ? seg(y('4:40'), over, C8.red, '', '#fff', `border-radius:0 0 ${10 * fs}px ${10 * fs}px;background-image:${hatch8('rgba(255,255,255,.35)', 6)}`) : seg(y(e), back * pm, hatch8(C8.goldI, 5), '') + `<span style="position:absolute;left:${lab + 10 * fs}px;top:${y(e) + back * pm + 3 * fs}px;font:600 ${10 * fs}px var(--sans);color:${C8.goldI}">${back} min walk back</span>`}
  ${bad ? '' : seg(y('4:40'), H - y('4:40'), hatch8(), '', C8.muted, `border-radius:0 0 ${14 * fs}px ${14 * fs}px`)}
  <i style="position:absolute;left:${lab - 6 * fs}px;right:${-6 * fs}px;top:${y('4:40')}px;border-top:${2 * fs}px solid ${C8.ink}"></i><span style="position:absolute;right:${6 * fs}px;top:${y('4:40') + 4 * fs}px;font:700 ${10 * fs}px var(--sans);color:${bad ? '#fff' : C8.ink}">Stats 4:40</span></div>` }
const FITOK = { s: '3:15', e: '4:15', name: 'Ceramics', to: 8, back: 11 }, FITBAD = { s: '3:45', e: '5:00', name: 'Board games', to: 6, back: 0, bad: 1 }
const crumb8 = (t, fs = 1) => `<div style="display:flex;align-items:center;gap:${10 * fs}px">${back6(fs)}<span style="font:600 ${12.5 * fs}px var(--sans)">${t}</span></div>`
const verdict8 = (n, c, a, b, fs = 1) => `<div>${N8(n, 102 * fs, c)}<div style="font:700 ${16 * fs}px/1.15 var(--sans);margin-top:${10 * fs}px">${a}</div><div style="font:500 ${11.5 * fs}px/1.4 var(--sans);color:${C8.muted};margin-top:${8 * fs}px">${b}</div></div>`
O8.B2 = [
  P8(C8.blueT, `<div style="padding:4px 18px 0">${crumb8('Ceramics open studio · Arts 104')}</div><div style="display:flex;gap:12px;padding:18px 14px 0 14px"><div style="flex:none">${strip8(142, 1.12, FITOK)}</div><div style="flex:1;min-width:0;padding-top:90px">${verdict8('14', C8.sage, 'minutes to spare', 'Leave Benson at 3:07. Back at Kenna by 4:26.')}</div></div><div style="padding:22px 18px 0;display:flex;gap:8px"><span style="flex:1">${B8('Pencil it in', C8.ink, '#fff', 1, 1, 0)}</span>${B8('Not this one', 'none', C8.ink, 1, 0, 0)}</div>`, { nav: null }),
  D8(C8.blueT, `${at(56, 22, crumb8('Ceramics open studio · Arts 104', 1.15))}${at(70, 86, strip8(300, 1.72, FITOK))}${at(430, 150, `<div style="width:300px">${verdict8('14', C8.sage, 'minutes to spare', 'Leave Benson at 3:07. You’re back at Kenna by 4:26, before Stats.', 1.9)}<div style="display:flex;gap:10px;margin-top:24px">${B8('Pencil it in', C8.ink, '#fff', 1.1, 0, 0)}${B8('Not this one', 'none', C8.ink, 1.1, 0, 0)}</div></div>`)}${at(790, 86, `<div style="width:170px"><div style="font:700 11px var(--sans);letter-spacing:.12em;color:${C8.muted}">ALSO FITS</div>${[EV8[1], EV8[0], EV8[4]].map(e => `<div style="background:#fff;border-radius:16px;padding:12px 14px;margin-top:10px">${N8(e[0], 30)}<div style="font:700 13px/1.2 var(--sans);margin-top:4px">${e[2]}</div><div style="font:500 11px var(--sans);color:${C8.muted};margin-top:2px">${e[5]} min walk</div></div>`).join('')}</div>`)}`),
  P8(C8.blueT, `<div style="padding:4px 18px 0">${crumb8('Board games · Benson 103')}</div><div style="display:flex;gap:12px;padding:18px 14px 0 14px"><div style="flex:none">${strip8(142, 1.12, FITBAD)}</div><div style="flex:1;min-width:0;padding-top:90px">${verdict8('20', C8.red, 'minutes into Stats', 'It ends at 5:00. Stats starts at 4:40.')}</div></div><div style="padding:22px 18px 0;display:grid;gap:8px">${B8('Go, and leave at 4:30', C8.ink, '#fff', 1, 1, 0)}${B8('Show me ones that fit', 'none', C8.ink, 1, 1)}</div>`, { nav: null })]

// ---------------- S1 · Leave in 12 ----------------
const route8 = (fs, w) => `<div style="position:relative;width:${w}px;height:${46 * fs}px"><i style="position:absolute;left:${7 * fs}px;right:${7 * fs}px;top:${6 * fs}px;border-top:${2.4 * fs}px dashed rgba(255,255,255,.5)"></i><i style="position:absolute;left:0;top:0;width:${14 * fs}px;height:${14 * fs}px;border-radius:50%;background:#fff"></i><i style="position:absolute;right:0;top:0;width:${14 * fs}px;height:${14 * fs}px;border-radius:50%;background:${C8.gold}"></i><span style="position:absolute;left:50%;top:${-9 * fs}px;transform:translateX(-50%);display:inline-flex;align-items:center;gap:${5 * fs}px;padding:${5 * fs}px ${10 * fs}px;border-radius:999px;background:#3a2d2a;color:#fff;font:700 ${11 * fs}px var(--sans)">${I6('walk', 14 * fs)}6 min</span><span style="position:absolute;left:0;top:${22 * fs}px;font:600 ${11.5 * fs}px var(--sans);color:#fff">Benson<br><span style="opacity:.6;font-weight:500">you, now</span></span><span style="position:absolute;right:0;top:${22 * fs}px;text-align:right;font:600 ${11.5 * fs}px var(--sans);color:#fff">Mission Gardens<br><span style="opacity:.6;font-weight:500">starts 3:00</span></span></div>`
const tri8 = (fs, on = 0) => `<div style="display:flex;padding:${4 * fs}px;border-radius:999px;background:rgba(255,255,255,.1)">${['Still on', 'Running late', 'Drop it'].map((t, i) => `<span style="flex:1;text-align:center;padding:${11 * fs}px 0;border-radius:999px;font:700 ${12.5 * fs}px var(--sans);${i === on ? `background:${C8.gold};color:${C8.ink}` : 'color:rgba(255,255,255,.8)'}">${t}</span>`).join('')}</div>`
const next8 = (a, t, p, fs = 1) => `<div style="position:relative;flex:1;background:rgba(255,255,255,.08);border-radius:${18 * fs}px;padding:${12 * fs}px;color:#fff"><div style="font:600 ${10 * fs}px var(--sans);opacity:.65">${a}</div><div style="font:400 ${19 * fs}px/1.05 var(--serif);margin-top:${6 * fs}px;width:80%">${t}</div><div style="font:500 ${10.5 * fs}px var(--sans);opacity:.65;margin-top:${3 * fs}px">${p}</div><div style="position:absolute;right:${8 * fs}px;top:${8 * fs}px">${ne8(26 * fs, 'rgba(255,255,255,.14)', '#fff')}</div></div>`
const leave8 = fs => `<div style="display:flex;align-items:flex-end;gap:${12 * fs}px">${N8('12', 196 * fs, C8.gold)}<div style="font:700 ${17 * fs}px/1.15 var(--sans);color:#fff;padding-bottom:${10 * fs}px">minutes<br>until you<br>leave</div></div>`
O8.B3 = [
  P8(C8.night, `<div style="padding:6px 20px 0">${K8('NEXT UP · ROSE GARDEN SKETCH', C8.gold)}<div style="margin-top:10px">${leave8(1)}</div></div><div style="padding:30px 22px 0">${route8(1, 236)}</div><div style="padding:22px 16px 0">${tri8(1)}</div><div style="display:flex;gap:8px;padding:12px 16px 0">${next8('TODAY 6:00', 'Therapy dogs', 'Library lawn')}${next8('SAT 1:30', 'Wisteria walk', 'Mission arbor')}</div>`, { light: true, nav: 2, navDark: true }),
  D8(C8.night, `${at(56, 30, `${K8('NEXT UP · ROSE GARDEN SKETCH', C8.gold, 1.2)}<div style="margin-top:16px">${leave8(1.5)}</div><div style="margin-top:44px">${route8(1.3, 400)}</div><div style="margin-top:36px;width:400px">${tri8(1.2)}</div>`)}${at(540, 30, `<div style="width:410px">${K8('AFTER THAT', 'rgba(255,255,255,.6)', 1.2)}<div style="display:grid;gap:12px;margin-top:14px">${[['TODAY 6:00 TO 6:30', 'Therapy dogs', 'Library lawn · 4 min walk'], ['SAT 1:30 TO 2:30', 'Wisteria walk', 'Mission arbor · with Kai'], ['SUN 8:00 PM', 'Open night', 'Ricard Observatory · maybe']].map(r => `<div style="display:flex">${next8(r[0], r[1], r[2], 1.35)}</div>`).join('')}</div><div style="font:500 13px/1.5 var(--sans);color:rgba(255,255,255,.6);margin-top:16px">“Running late” tells Kai you’ll be 10 minutes behind. “Drop it” frees the hour and asks nothing.</div></div>`)}`, 'My Schedule', 1),
  P8(C8.night, `<div style="padding:6px 20px 0">${K8('MY SCHEDULE', C8.gold)}<div style="position:relative;height:190px;margin-top:10px">${N8('0', 230, 'rgba(255,255,255,.16)')}<div style="position:absolute;left:96px;top:60px">${blob('round', C8.gold, 84, 'happy', -6)}</div></div><div style="font:400 30px/1.05 var(--serif);color:#fff">Nothing planned, and a gap at 2:10.</div><div style="font:500 13px/1.45 var(--sans);color:rgba(255,255,255,.72);margin-top:8px">Five things fit it. Anything you pick shows up here with a time to leave.</div><div style="display:grid;gap:10px;margin-top:18px">${B8('Find something for 2:10', C8.gold, C8.ink, 1, 1)}${B8('Open my Someday list', 'none', '#fff', 1, 1, 0)}</div></div>`, { light: true, nav: 2, navDark: true })]

// ---------------- S2 · The week in columns ----------------
// 8 am at the top of each column, 10 pm at the bottom. A block is one plan.
const DAYS8 = ['M', 'T', 'W', 'T', 'F', 'S', 'S']
const week8 = (w, h, fs, plans, warn) => { const cw = (w - 6 * 6 * fs) / 7
  return `<div style="display:flex;gap:${6 * fs}px">${DAYS8.map((d, i) => `<div style="width:${cw}px"><div style="text-align:center;font:700 ${11 * fs}px var(--sans);margin-bottom:${5 * fs}px;${i === 2 ? `color:${C8.red}` : ''}">${d}</div><div style="position:relative;height:${h}px;border:${2 * fs}px solid ${warn && i === 4 ? C8.red : C8.ink};border-radius:${12 * fs}px;background:${i === 2 ? C8.gold : '#fff'};box-sizing:border-box;overflow:hidden">${plans.filter(p => p[0] === i).map(([_, a, b, c, lbl]) => `<span style="position:absolute;left:${3 * fs}px;right:${3 * fs}px;top:${a * h}px;height:${(b - a) * h}px;border-radius:${6 * fs}px;background:${c};color:#fff;font:700 ${9 * fs}px/1.1 var(--sans);padding:${3 * fs}px;box-sizing:border-box;overflow:hidden">${lbl || ''}</span>`).join('')}</div></div>`).join('')}</div>` }
const PL8 = [[0, .2, .34, C8.muted], [2, .4, .56, C8.ink], [2, .68, .8, C8.ink], [4, .38, .54, C8.ink], [5, .3, .46, C8.sage], [6, .78, .94, C8.sage]]
const PL8B = [[0, .2, .34, C8.muted], [2, .4, .56, C8.ink], [4, .34, .5, C8.ink], [4, .42, .64, C8.red], [5, .3, .46, C8.sage]]
const plan8 = (a, t, p, fs = 1, done) => `<div style="display:flex;align-items:center;gap:${12 * fs}px;background:#fff;border:${2 * fs}px solid ${C8.ink};border-radius:${16 * fs}px;padding:${10 * fs}px ${12 * fs}px"><div style="width:${64 * fs}px;flex:none"><div style="font:700 ${9.5 * fs}px var(--sans);color:${C8.red}">${a[0]}</div>${N8(a[1], 28 * fs)}</div><div style="flex:1"><div style="font:400 ${19 * fs}px/1.05 var(--serif)">${t}</div><div style="font:500 ${10.5 * fs}px var(--sans);color:${C8.muted};margin-top:${2 * fs}px">${p}</div></div><span style="width:${26 * fs}px;height:${26 * fs}px;border-radius:${8 * fs}px;border:${2 * fs}px solid ${C8.ink};display:grid;place-content:center;${done ? `background:${C8.ink};color:#fff` : ''}">${done ? I6('check', 14 * fs) : ''}</span></div>`
const streak8 = (fs = 1) => `<span style="display:inline-flex;align-items:center;gap:${6 * fs}px;padding:${7 * fs}px ${12 * fs}px;border-radius:999px;background:${C8.ink};color:#fff;font:700 ${11.5 * fs}px var(--sans)">${I6('fire', 15 * fs, C8.gold)}3 weeks running</span>`
O8.B4 = [
  P8(C8.sageT, `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 18px 0"><span style="font:700 11px var(--sans);letter-spacing:.14em">NOV 9 TO 15</span>${streak8()}</div><div style="padding:12px 16px 0">${week8(248, 196, 1, PL8)}</div><div style="padding:12px 16px 0;display:grid;gap:8px">${plan8(['TODAY', '3:00'], 'Rose garden sketch', 'Mission Gardens · leave 2:52')}${plan8(['FRI', '2:30'], 'Art workshop', 'Benson 101')}</div>`, { nav: 2 }),
  D8(C8.sageT, `${at(56, 16, `<div style="width:540px;display:flex;justify-content:space-between;align-items:center"><span style="font:700 13px var(--sans);letter-spacing:.14em">NOV 9 TO 15</span>${streak8(1.15)}</div>`)}${at(56, 66, week8(540, 440, 1.7, [[0, .2, .34, C8.muted, 'Went: jam'], [2, .4, .56, C8.ink, 'Rose sketch'], [2, .68, .8, C8.ink, 'Dogs'], [4, .38, .54, C8.ink, 'Art'], [5, .3, .46, C8.sage, 'Wisteria'], [6, .78, .94, C8.sage, 'Open night']]))}${at(640, 66, `<div style="width:310px;display:grid;gap:12px">${K8('COMING UP', C8.muted, 1.2)}${plan8(['TODAY', '3:00'], 'Rose garden sketch', 'Mission Gardens · leave 2:52', 1.2)}${plan8(['TODAY', '6:00'], 'Therapy dogs', 'Library lawn', 1.2)}${plan8(['FRI', '2:30'], 'Art workshop', 'Benson 101', 1.2)}<div style="font:500 13px/1.45 var(--sans);color:${C8.muted}">8 am sits at the top of each column and 10 pm at the bottom. Green blocks are maybes. Tick a plan when you went: one tick keeps the streak.</div></div>`)}`, 'My Schedule'),
  P8(C8.sageT, `<div style="display:flex;justify-content:space-between;align-items:center;padding:6px 18px 0"><span style="font:700 11px var(--sans);letter-spacing:.14em">NOV 9 TO 15</span>${streak8()}</div><div style="padding:12px 16px 0">${week8(248, 176, 1, PL8B, 1)}</div><div style="padding:12px 16px 0"><div style="background:#fff;border:2px solid ${C8.red};border-radius:16px;padding:14px"><div style="font:400 23px/1.05 var(--serif)">Friday has a 45 minute overlap.</div><div style="font:500 12px/1.4 var(--sans);color:${C8.muted};margin-top:6px">Art workshop ends 3:30. Board games starts 2:45. You can’t be at both the whole time.</div><div style="display:flex;gap:8px;margin-top:12px">${B8('Pick one', C8.ink, '#fff', .86, 0, 0)}${B8('Keep both', 'none', C8.ink, .86, 0, 0)}</div></div></div>`, { nav: 2 })]
