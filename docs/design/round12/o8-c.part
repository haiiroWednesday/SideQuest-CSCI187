
// ---------------- P1 · Fill in the poster ----------------
// The form is the thing you are making. Filled blanks are solid, empty ones are dashed gold, wrong ones are red.
const fld8 = (t, state = 'ok', fs = 1) => { const st = state === 'ok' ? `background:#fff;border:${1.6 * fs}px solid ${C8.ink};color:${C8.ink}` : state === 'empty' ? `background:${C8.sticky};border:${1.6 * fs}px dashed ${C8.goldI};color:${C8.goldI}` : `background:#fdf1ef;border:${1.6 * fs}px solid ${C8.red};color:${C8.maroon}`
  return `<span style="display:inline-flex;align-items:center;gap:${4 * fs}px;padding:${3 * fs}px ${9 * fs}px;border-radius:${9 * fs}px;font:700 ${13 * fs}px var(--sans);white-space:nowrap;vertical-align:middle;${st}">${state === 'empty' ? '+ ' : ''}${t}</span>` }
const prog8 = (n, fs = 1, of = 5) => `<div style="display:flex;gap:${4 * fs}px">${Array.from({ length: of }, (_, i) => `<i style="flex:1;height:${6 * fs}px;border-radius:${3 * fs}px;background:${i < n ? C8.gold : 'rgba(255,255,255,.25)'}"></i>`).join('')}</div>`
const sheet8 = (w, fs, mode) => `<div style="width:${w}px;background:${C8.paper};border-radius:${20 * fs}px;box-shadow:0 16px 34px rgba(36,27,25,.3);overflow:hidden">
  ${mode === 'bad' ? pic('rosegarden', w, 84 * fs, 50, 55) : `<div style="height:${72 * fs}px;margin:${12 * fs}px ${12 * fs}px 0;border:${1.6 * fs}px dashed rgba(48,36,33,.3);border-radius:${12 * fs}px;display:grid;place-content:center;text-align:center;font:600 ${11.5 * fs}px/1.3 var(--sans);color:${C8.muted}">+ Add a photo or flyer<br><span style="font-weight:500">optional, a drawing goes here if you skip it</span></div>`}
  <div style="padding:${14 * fs}px ${16 * fs}px ${16 * fs}px"><div style="font:400 ${34 * fs}px/1 var(--serif);border-bottom:${1.6 * fs}px solid ${C8.ink};padding-bottom:${6 * fs}px;display:flex;justify-content:space-between;align-items:flex-end">Rose garden sketch<span style="color:${C8.muted}">${I6('check', 16 * fs, C8.sage)}</span></div>
  <div style="font:500 ${13.5 * fs}px/${2.5} var(--sans);margin-top:${8 * fs}px">on ${fld8('Fri, Dec 4', 'ok', fs)} from ${fld8('3:00 pm', mode === 'bad' ? 'bad' : 'ok', fs)}<br>to ${fld8(mode === 'bad' ? '2:00 pm' : 'end time', mode === 'bad' ? 'bad' : 'empty', fs)} at ${fld8(mode === 'bad' ? 'Mission Gardens' : 'where?', mode === 'bad' ? 'ok' : 'empty', fs)}<br>hosted by ${fld8('Art Club', 'ok', fs)}</div>
  ${mode === 'bad' ? `<div style="margin-top:${8 * fs}px;padding:${10 * fs}px ${12 * fs}px;border-radius:${12 * fs}px;background:#fdf1ef;color:${C8.maroon};font:600 ${12 * fs}px/1.35 var(--sans)">It ends an hour before it starts. Did you mean 4:00 pm?<div style="margin-top:${8 * fs}px">${B8('Use 4:00 pm', C8.red, '#fff', .74 * fs, 0, 0)}</div></div>` : ''}</div></div>`
const check8 = (t, ok, fs = 1) => `<div style="display:flex;align-items:center;gap:${10 * fs}px;font:600 ${14 * fs}px var(--sans);color:${ok ? '#fff' : C8.gold}"><span style="width:${22 * fs}px;height:${22 * fs}px;border-radius:50%;display:grid;place-content:center;${ok ? `background:#fff;color:${C8.red}` : `border:${1.6 * fs}px dashed ${C8.gold}`}">${ok ? I6('check', 13 * fs) : ''}</span>${t}</div>`
O8.C1 = [
  P8(C8.red, `<div style="padding:6px 18px 0"><div style="display:flex;justify-content:space-between;align-items:center">${K8('POST · 3 OF 5 FILLED', '#fff')}${cb('x', 30, 'rgba(255,255,255,.16)', '#fff', 0)}</div><div style="margin-top:10px">${prog8(3)}</div></div><div style="padding:14px 16px 0">${sheet8(248, 1)}</div><div style="padding:12px 18px 0"><div style="font:600 12.5px var(--sans);color:#fff">Two blanks left: end time and place.</div><div style="margin-top:10px">${B8('Next: end time', C8.gold, C8.ink, 1, 1)}</div></div>`, { light: true, nav: null }),
  D8(C8.red, `${at(56, 26, `<div style="width:420px">${K8('POST AN EVENT · 3 OF 5 FILLED', '#fff', 1.2)}<div style="margin-top:12px">${prog8(3, 1.3)}</div><div style="margin-top:18px">${sheet8(420, 1.42)}</div></div>`)}${at(540, 30, `<div style="width:400px"><div style="font:500 15px/1.5 var(--sans);color:rgba(255,255,255,.9)">The card on the left is what students will see. Tap any blank to fill it. Dashed gold means still empty.</div><div style="display:grid;gap:12px;margin-top:22px">${check8('Name', 1)}${check8('Date', 1)}${check8('Start time', 1)}${check8('End time', 0)}${check8('Place', 0)}</div><div style="margin-top:24px;display:flex;gap:10px;align-items:center">${B8('Next: end time', C8.gold, C8.ink, 1.1)}<span style="font:600 13px var(--sans);color:rgba(255,255,255,.75)">Post unlocks at 5 of 5</span></div></div>`)}`, 'Post', 1),
  P8(C8.red, `<div style="padding:6px 18px 0"><div style="display:flex;justify-content:space-between;align-items:center">${K8('POST · 5 OF 5 FILLED', '#fff')}${cb('x', 30, 'rgba(255,255,255,.16)', '#fff', 0)}</div><div style="margin-top:10px">${prog8(5)}</div></div><div style="padding:14px 16px 0">${sheet8(248, 1, 'bad')}</div><div style="padding:12px 18px 0">${B8('Fix the time to post', 'none', '#fff', 1, 1, 0)}</div>`, { light: true, nav: null })]

// ---------------- P2 · One question at a time ----------------
const dots8 = (n, of = 5) => `<span style="display:inline-flex;gap:5px;align-items:center">${Array.from({ length: of }, (_, i) => `<i style="width:${i === n ? 22 : 7}px;height:7px;border-radius:4px;background:${i <= n ? C8.ink : 'rgba(48,36,33,.22)'}"></i>`).join('')}<span style="font:600 11px var(--sans);margin-left:6px">${n + 1} of ${of}</span></span>`
const tbox8 = (t, l, fs = 1, bad) => `<div style="flex:1;background:#fff;border-radius:${18 * fs}px;padding:${10 * fs}px ${14 * fs}px;${bad ? `box-shadow:inset 0 0 0 ${2 * fs}px ${C8.red}` : ''}"><div style="font:600 ${10.5 * fs}px var(--sans);color:${bad ? C8.red : C8.muted}">${l}</div>${N8(t, 50 * fs, bad ? C8.maroon : C8.ink)}<span style="font:600 ${12 * fs}px var(--sans);color:${C8.muted}"> pm</span></div>`
const stub8 = (fs, when, where) => `<div style="background:${C8.paper};border-radius:${16 * fs}px;padding:${12 * fs}px ${14 * fs}px;box-shadow:0 8px 18px rgba(48,36,33,.14)"><div style="font:700 ${9.5 * fs}px var(--sans);letter-spacing:.12em;color:${C8.muted}">YOUR EVENT SO FAR</div><div style="font:400 ${22 * fs}px/1.05 var(--serif);margin-top:${5 * fs}px">Rose garden sketch</div><div style="display:flex;gap:${6 * fs}px;margin-top:${8 * fs}px;flex-wrap:wrap">${fld8('Art Club', 'ok', fs * .8)}${fld8(when || 'when', when ? 'ok' : 'empty', fs * .8)}${fld8(where || 'where', where ? 'ok' : 'empty', fs * .8)}</div></div>`
const q8 = (fs, bad) => `<div style="font:400 ${58 * fs}px/.95 var(--serif);letter-spacing:-.02em;text-align:center">When is it?</div><div style="display:flex;gap:${6 * fs}px;margin-top:${16 * fs}px;flex-wrap:wrap;justify-content:center">${chip6('Today', bad, fs, bad ? C8.red : C8.ink)}${chip6('Tomorrow', 0, fs)}${chip6('Fri, Dec 4', !bad, fs)}${chip6('Pick a date', 0, fs)}</div><div style="display:flex;gap:${8 * fs}px;align-items:center;margin-top:${12 * fs}px">${tbox8(bad ? '1:00' : '3:00', 'starts', fs, bad)}${I6('arrow', 18 * fs)}${tbox8(bad ? '2:00' : '4:00', 'ends', fs)}</div>`
O8.C2 = [
  P8(C8.pink, `<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 18px 0">${back6()}${dots8(1)}</div><div style="padding:16px 18px 0">${q8(1)}<div style="font:600 12px var(--sans);color:${C8.sage};margin-top:8px;text-align:center">One hour, on a Friday afternoon.</div></div><div style="position:absolute;left:16px;right:16px;bottom:92px">${stub8(1)}</div><div style="position:absolute;left:18px;right:18px;bottom:22px;display:flex;justify-content:space-between;align-items:center"><span style="font:600 13px var(--sans);text-decoration:underline">Save as draft</span>${B8('Next: where', C8.ink, '#fff', 1)}</div>`, { nav: null }),
  D8(C8.pink, `${at(56, 30, `<div style="width:440px">${dots8(1)}<div style="margin-top:22px">${q8(1.45)}</div><div style="font:600 15px var(--sans);color:${C8.sage};margin-top:14px">One hour, on a Friday afternoon.</div><div style="display:flex;gap:14px;align-items:center;margin-top:34px">${B8('Next: where', C8.ink, '#fff', 1.15)}<span style="font:600 14px var(--sans);text-decoration:underline">Back</span><span style="font:600 14px var(--sans);text-decoration:underline">Save as draft</span></div></div>`)}${at(580, 60, `<div style="width:360px;transform:rotate(2deg)">${stub8(1.6, 'Fri 3 to 4')}</div>`)}${at(580, 300, `<div style="width:360px;font:500 14px/1.5 var(--sans);color:${C8.muted}">Five short questions: name, when, where, who’s hosting, a photo. The card fills in as you go, and you can tap any part of it to change an answer.</div>`)}`, 'Post'),
  P8(C8.pink, `<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 18px 0">${back6()}${dots8(1)}</div><div style="padding:16px 18px 0">${q8(1, 1)}<div style="margin-top:10px;padding:10px 12px;border-radius:12px;background:#fdf1ef;color:${C8.maroon};font:600 12px/1.35 var(--sans)">1:00 pm today already passed. It’s 2:10 now.<div style="display:flex;gap:6px;margin-top:8px">${B8('Today 3:00', C8.red, '#fff', .74, 0, 0)}${B8('Tomorrow 1:00', 'none', C8.maroon, .74, 0, 0)}</div></div></div><div style="position:absolute;left:18px;right:18px;bottom:22px;display:flex;justify-content:space-between;align-items:center"><span style="font:600 13px var(--sans);text-decoration:underline">Save as draft</span>${B8('Next: where', 'none', C8.muted, 1)}</div>`, { nav: null })]

// ---------------- F1 · Who's free right now ----------------
// Circle size is how long each person is free from now. Bigger circle, more time.
const circ8 = (x, y, d, bg, name, t, fs, col = '#fff', dashed) => `<div style="position:absolute;left:${x * fs}px;top:${y * fs}px;width:${d * fs}px;height:${d * fs}px;border-radius:50%;${dashed ? `border:${1.8 * fs}px dashed rgba(255,255,255,.55);box-sizing:border-box;color:rgba(255,255,255,.8)` : `background:${bg};color:${col};box-shadow:0 8px 18px rgba(20,30,45,.25)`};display:grid;place-content:center;text-align:center"><div style="font:400 ${Math.max(15, d * .2) * fs}px/1 var(--serif)">${name}</div><div style="font:700 ${Math.max(9.5, d * .095) * fs}px var(--sans);margin-top:${3 * fs}px;opacity:.9">${t}</div></div>`
const bubbles8 = fs => `<div style="position:relative;width:${280 * fs}px;height:${240 * fs}px">${circ8(18, 8, 112, C8.sage, 'Kai', '2h', fs)}${circ8(178, 4, 84, C8.terra, 'Ari', '45 min', fs)}${circ8(74, 74, 140, C8.gold, 'You', '2h 30', fs, C8.ink)}${circ8(198, 138, 66, C8.paper, 'Maya', '20 min', fs, C8.ink)}${circ8(14, 172, 56, '', 'Sam', 'busy', fs, '#fff', 1)}</div>`
const nobody8 = fs => `<div style="position:relative;width:${280 * fs}px;height:${200 * fs}px">${circ8(30, 20, 70, '', 'Kai', 'till 3:30', fs, '#fff', 1)}${circ8(180, 10, 70, '', 'Ari', 'till 3:00', fs, '#fff', 1)}${circ8(190, 110, 62, '', 'Maya', 'till 5', fs, '#fff', 1)}${circ8(84, 64, 116, C8.gold, 'You', '2h 30', fs, C8.ink)}<div style="position:absolute;left:${28 * fs}px;top:${140 * fs}px">${blob('cloud', '#c9d7c3', 50 * fs, 'sleepy', -8)}</div></div>`
const frow8 = (l, name, till, pct, c, fs = 1) => `<div style="display:flex;align-items:center;gap:${12 * fs}px">${av6(l, 30 * fs, c, C8.blue)}<div style="width:${54 * fs}px;font:600 ${13 * fs}px var(--sans);color:#fff">${name}</div><div style="flex:1;height:${14 * fs}px;border-radius:${7 * fs}px;background:rgba(255,255,255,.14)"><i style="display:block;width:${pct}%;height:100%;border-radius:${7 * fs}px;background:${pct ? c : 'none'}"></i></div><div style="width:${64 * fs}px;text-align:right;font:600 ${12 * fs}px var(--sans);color:rgba(255,255,255,.85)">${till}</div></div>`
const both8 = (fs = 1) => `<div style="display:flex;align-items:center;gap:${12 * fs}px;background:${C8.paper};border-radius:${20 * fs}px;padding:${12 * fs}px ${14 * fs}px">${avs('JK', 30 * fs, C8.paper)}<div style="flex:1"><div style="font:400 ${21 * fs}px/1.05 var(--serif)">You and Kai, until 4:10</div><div style="font:500 ${11.5 * fs}px var(--sans);color:${C8.muted};margin-top:${2 * fs}px">3 things fit you both</div></div>${cb('arrow', 38 * fs, C8.red, '#fff', 0)}</div>`
const now8 = (t, fs = 1) => `<div style="text-align:center;font:700 ${11 * fs}px var(--sans);letter-spacing:.14em;color:#fff">${t}</div>`
O8.C3 = [
  P8(C8.blue, `<div style="padding-top:10px">${now8('FREE RIGHT NOW · 2:10 PM')}</div><div style="margin-top:14px">${bubbles8(1)}</div><div style="padding:14px 14px 0">${both8()}</div><div style="text-align:center;font:500 11px var(--sans);color:rgba(255,255,255,.75);margin-top:12px">Bigger circle, more free time.<br>Friends see free or busy, never why.</div>`, { light: true, nav: 3, navDark: true }),
  D8(C8.blue, `${at(30, 60, bubbles8(1.75))}${at(560, 40, `<div style="width:400px"><div style="font:700 13px var(--sans);letter-spacing:.14em;color:#fff">FREE RIGHT NOW · 2:10 PM</div><div style="display:grid;gap:16px;margin-top:22px">${frow8('J', 'You', 'till 4:40', 100, C8.gold, 1.2)}${frow8('K', 'Kai', 'till 4:10', 80, '#8fae8f', 1.2)}${frow8('A', 'Ari', 'till 2:55', 30, C8.terra, 1.2)}${frow8('M', 'Maya', 'till 2:30', 13, C8.paper, 1.2)}${frow8('S', 'Sam', 'busy', 0, '#7a5a8a', 1.2)}</div><div style="margin-top:28px">${both8(1.25)}</div><div style="font:500 13px/1.5 var(--sans);color:rgba(255,255,255,.75);margin-top:14px">Circle size and bar length both mean time free from now. Friends see free or busy, never why.</div></div>`)}`, 'Discover', 1),
  P8(C8.blue, `<div style="padding-top:10px">${now8('NOBODY’S FREE RIGHT NOW')}</div><div style="margin-top:14px">${nobody8(1)}</div><div style="padding:8px 20px 0"><div style="font:400 26px/1.08 var(--serif);color:#fff">Ari is out first, at 3:00.</div><div style="font:500 13px/1.45 var(--sans);color:rgba(255,255,255,.85);margin-top:6px">You’d have an hour and forty together.</div><div style="display:grid;gap:10px;margin-top:14px">${B8('Nudge me at 3:00', C8.gold, C8.ink, 1, 1, 0)}${B8('Go solo: 5 fit you', 'none', '#fff', 1, 1)}</div></div>`, { light: true, nav: 3, navDark: true })]

var SAY8 = { A1: 'a night with nothing on', A2: 'a gap too short for anything', A3: 'a 20 minute gap', A4: 'a week with nothing posted', A5: 'day one, before any setup', B1: 'the day the host cancels', B2: 'an event that runs into class', B3: 'a day with nothing planned', B4: 'a day two plans overlap', C1: 'an end time before the start', C2: 'a time that already passed', C3: 'a moment no friend is free', G1: 'a gap too short for anything', G2: 'the day every spot is taken', G3: 'a week with no plans', G4: 'an event we can’t categorise' }
SEC8.push({ h: 'Discover', say: 'Five ways to open the app. Each fills the whole screen with one answer to “what can I do in the time I have?”', o: [
  ['A1', 'Tonight, by the number', 'Three giant numbers on SCU maroon: 12 on tonight, 5 that fit your gap, 2 with friends. Each is a filter you tap. The gold one is the main action. Why it should work: three choices instead of a long list (Hick’s law), and the eye lands on gold first (visual hierarchy).'],
  ['A2', 'Three stickies for your gap', 'Three tilted sticky notes picked for your free time. The front one carries the photo and the red arrow. Shuffle swaps them. Why: a short hand of options beats a feed when you only have two hours (choice overload), and each whole card is one big tap target (Fitts’s law).'],
  ['A3', 'The gap is the hero', 'Your free time as a giant clock, then a small chart of what fits between now and your next class. Bars are events at their true length. Striped gold in front of each bar is the walk. Why: the chart matches the data, with one shared time axis and a legend (the course’s chart rules).'],
  ['A4', 'The sticker pile', 'Events as a pile of stickers: photo stickers from hosts, pins for clubs, tags like FREE FOOD. The gold pill in the middle is the shortcut to what fits you. The Pile / List switch gives the same events as plain rows. Why: fun pulls people in, and List keeps the familiar pattern one tap away (Jakob’s law).'],
  ['A5', 'Home in tiles', 'One tile per question: when’s my next gap, how many fit, who else is free, when do I leave. Each tile has a corner arrow that opens the screen behind it. Why: grouping related facts in their own boxes makes a page scannable (chunking, common region).']] })
SEC8.push({ h: 'One event', say: 'What you see after tapping an event, and the answer to “can I make it?”', o: [
  ['B1', 'The poster with a stub', 'The host’s photo as a full poster with the title on it. Below, a ticket stub with the three facts you decide on: start, length, walk. One red button, one quiet one. Why: the primary action is the only red thing on the stub (visual hierarchy), and the line under the button says what tapping it does (wording).'],
  ['B2', 'Does it fit?', 'Your afternoon as one strip. Classes are hatched, the walk is striped gold, the event is solid green. The headline gives the verdict in words. Why: you can see the answer without doing time math in your head (recognition over recall).']] })
SEC8.push({ h: 'My Schedule', say: 'What’s next, and the week at a glance.', o: [
  ['B3', 'Leave in 12', 'A giant countdown to when you need to walk out the door, the route under it, and one three-way switch: Still on, Running late, Drop it. Why: the app tells you its status the second you open it (system feedback), and the three options sit in one control because they are one decision.'],
  ['B4', 'The week in columns', 'Seven thick-outlined columns, 8 am at the top and 10 pm at the bottom. A block is a plan, today is gold. Tick a plan when you went. Why: it follows the calendar layout everyone already knows (conventions), with a streak to keep it going (goal-gradient).']] })
SEC8.push({ h: 'Post and Friends', say: 'Making an event without a wall of form fields, and seeing who is around.', o: [
  ['C1', 'Fill in the poster', 'The form is the card students will see. Filled blanks are solid, empty ones are dashed gold, and the button always names the next blank. Why: you see the result while you type, and the progress bar shows how close you are (goal-gradient effect).'],
  ['C2', 'One question at a time', 'Five short questions with big tap targets, one per screen. Your answers collect on a card at the bottom. Why: one decision at a time is easier on a phone (chunking), and quick picks like Today and Tomorrow save typing.'],
  ['C3', 'Who’s free right now', 'A circle per friend, sized by how long they are free from now. The card under it turns the biggest overlap into something to do. Why: size stands for one thing only, time, and desktop repeats it as sorted bars so nobody has to guess.']] })
SEC8.push({ h: 'Glass', say: 'Your frosted-glass posters, as screens. What sits inside a glass is blurred, what pokes over the rim is sharp, and the type is small and centred. Drawn in code, so any event can have one.', o: [
  ['G1', 'One glass at a time', 'Discover as a single poster: one event, one glass, tiny facts above it, the name under it. Swipe for the next, and the neighbours peek in from the edges. Why: one decision per screen (Hick’s law), with the edges hinting there is more to swipe.'],
  ['G2', 'The event as one glass', 'The event page as a jar. The fuller it is, the fewer spots are left, and the name runs up the side like the label on a cup. Three facts and one button underneath. Why: fill level stands for one thing only, and the sentence under it says so in words.'],
  ['G3', 'The week as a tray', 'Seven glasses, one per day. Each orb is a plan, and today’s glass is the big one with the straw. The orb colours match the lines below. Why: you can count your week at a glance, and an empty glass is an honest picture of a free day.'],
  ['G4', 'Any event gets a glass', 'This answers your question about events we import later. The category picks the vessel and colours, and the event’s ID decides what floats inside, so the same event always looks the same and no two match. Why: it is consistent, it costs nothing per event, and nobody has to draw anything.']] })
