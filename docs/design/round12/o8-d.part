  D8(G8.ground, `${at(0, 16, `<div style="width:1000px">${colo8('EVERY EVENT GETS A GLASS<br>MADE BY RULE, NOT BY HAND', 'CATEGORY PICKS THE VESSEL<br>THE EVENT ID PICKS WHAT FLOATS', 1.2)}</div>`)}<div style="position:absolute;left:30px;top:74px;width:940px;display:grid;grid-template-columns:repeat(5,1fr);gap:22px 0">${ANY8.map(a => acell8(a, 104, 1.05)).join('')}</div>`),
  P8(G8.ground, `<div style="padding-top:10px">${colo8('JUST IMPORTED<br>NO CATEGORY YET', 'FRI<br>DEC 4')}<div style="margin-top:8px">${ast8(16)}</div></div><div style="display:grid;justify-content:center;margin-top:10px">${glass8(138, { orbs: [[50, 110, 56, '#e9e6df']], pool: 0, straw: 0, sparks: [[36, .3, 7], [66, .62, 8]], label: 'FRI 4' })}</div><div style="margin-top:14px">${ttl8('Quarterly Town Hall', 23)}</div><div style="text-align:center;font:500 12px/1.45 var(--sans);color:#7b756f;margin:8px 30px 0">We couldn’t tell what kind of event this is, so it gets the plain glass with its date. A host can pick a category any time.</div><div style="display:flex;justify-content:center;margin-top:12px">${B8('Pick a category', 'none', G8.ink, .9, 0, 0)}</div>`, {})]
