
// ---------------- GLASS · frosted vessels with soft blurred contents ----------------
// What sits inside the glass is blurred. What pokes over the rim stays sharp. The contents are drawn twice:
// once sharp and clipped to the air above the rim, once blurred and clipped to the glass.
const G8 = { ground: '#f5f5f1', ink: '#2b2624', food: ['#f29a3f', '#f6c945', '#e9573f', '#fff0c4'], arts: ['#e56a8a', '#b79ae6', '#f0a36b', '#ffe3ec'], out: ['#86c66f', '#f2de4c', '#6fd6c4', '#eefbd8'], night: ['#5b8def', '#9a7bf0', '#f48fb1', '#e4ecff'], sq: ['#c9364a', '#e8aa24', '#7ea07e', '#f6cfc6'] }
const rpoly = (pts, rad) => { const n = pts.length; let d = ''
  for (let i = 0; i < n; i++) { const p = pts[i], a = pts[(i + n - 1) % n], b = pts[(i + 1) % n], r = rad[i]
    const u = (q) => { const dx = q[0] - p[0], dy = q[1] - p[1], l = Math.hypot(dx, dy) || 1; return [p[0] + dx / l * Math.min(r, l / 2), p[1] + dy / l * Math.min(r, l / 2)] }
    const s = u(a), e = u(b); d += `${i ? 'L' : 'M'}${s[0].toFixed(1)} ${s[1].toFixed(1)}Q${p[0].toFixed(1)} ${p[1].toFixed(1)} ${e[0].toFixed(1)} ${e[1].toFixed(1)}` }
  return d + 'Z' }
const VES = {
  tumbler: (w, h) => rpoly([[0, 0], [w, 0], [w * .86, h], [w * .14, h]], [w * .05, w * .05, w * .16, w * .16]),
  cup: (w, h) => rpoly([[w * .04, 0], [w * .96, 0], [w * .82, h], [w * .18, h]], [w * .03, w * .03, w * .14, w * .14]),
  jar: (w, h) => rpoly([[w * .16, 0], [w * .84, 0], [w * .84, h * .1], [w, h * .26], [w, h], [0, h], [0, h * .26], [w * .16, h * .1]], [w * .04, w * .04, w * .06, w * .2, w * .2, w * .2, w * .2, w * .06]),
  mug: (w, h) => rpoly([[0, 0], [w, 0], [w, h], [0, h]], [w * .05, w * .05, w * .22, w * .22]) }
const spark8 = (x, y, s, o = 1) => `<svg style="position:absolute;left:${x - s / 2}px;top:${y - s / 2}px;opacity:${o};filter:drop-shadow(0 0 ${s * .25}px #fff)" width="${s}" height="${s}" viewBox="0 0 20 20"><path d="M10 0C10.6 6 14 9.4 20 10C14 10.6 10.6 14 10 20C9.4 14 6 10.6 0 10C6 9.4 9.4 6 10 0Z" fill="#fff"/></svg>`
// an orb: a soft fruit-like disc. [x, y, d, color, style]  style 'half' gives the cut-fruit centre
const orb8 = ([x, y, d, c, st], k) => `<span style="position:absolute;left:${(x - d / 2) * k}px;top:${(y - d / 2) * k}px;width:${d * k}px;height:${d * k}px;border-radius:50%;background:${st === 'half' ? `radial-gradient(circle at 46% 54%,rgba(190,60,20,.55) 0 18%,rgba(255,255,255,0) 44%),radial-gradient(circle at 34% 30%,rgba(255,255,255,.5) 0,rgba(255,255,255,0) 46%),${c}` : `radial-gradient(circle at 34% 30%,rgba(255,255,255,.55) 0,rgba(255,255,255,0) 50%),${c}`}"></span>`
// glass(w): drawn on a 100 x (air + 150) grid scaled by k = w / 100. rim sits at y = air.
const glass8 = (w, o = {}) => { const k = w / 100, air = o.air ?? 34, gh = o.h || 150, H = (air + gh) * k, rim = air * k, kind = o.kind || 'tumbler', path = VES[kind](w, gh * k), id = 'g8' + (glass8.n = (glass8.n || 0) + 1)
  const cols = o.cols || G8.food, orbs = o.orbs || [[38, air + 4, 46, cols[0], 'half'], [42, air + 68, 44, cols[3]], [70, air + 64, 38, cols[1], 'half'], [34, air + 98, 34, cols[2]]]
  const pool = o.pool === 0 ? '' : `<span style="position:absolute;left:${-10 * k}px;right:${-10 * k}px;top:${(air + gh * (1 - (o.fill ?? .34))) * k}px;bottom:${-10 * k}px;background:linear-gradient(180deg,rgba(255,255,255,0),${o.poolCol || cols[0]} 70%)"></span>`
  const straw = o.straw === 0 ? '' : o.straw === 'bar'
    ? `<span style="position:absolute;left:${24 * k}px;top:${(air - 30) * k}px;width:${6.5 * k}px;height:${118 * k}px;border-radius:${3 * k}px;background:${o.strawCol || '#7fe0d2'};transform:rotate(-5deg);transform-origin:50% 100%"></span>`
    : (() => { const x = o.sx ?? 60, y = air; return `<svg style="position:absolute;left:0;top:0;overflow:visible" width="${w}" height="${H}" viewBox="0 0 100 ${air + gh}"><path d="M${x} ${air + gh - 12}L${x + 13} ${y + 4}C${x + 15} ${y - 8} ${x + 9} ${y - 17} ${x + 17} ${y - 19}C${x + 26} ${y - 21} ${x + 29} ${y - 9} ${x + 22} ${y - 6}C${x + 15} ${y - 4} ${x + 15} ${y - 14} ${x + 24} ${y - 24}L${x + 34} ${y - 37}" fill="none" stroke="${o.strawCol || G8.ink}" stroke-width="4.4" stroke-linecap="round" stroke-linejoin="round"/></svg>` })()
  const stuff = pool + orbs.map(b => orb8(b, k)).join('') + straw
  const lid = kind === 'cup' ? `<span style="position:absolute;left:${-3 * k}px;top:${rim - 9 * k}px;width:${106 * k}px;height:${13 * k}px;border-radius:${6 * k}px;background:rgba(255,255,255,.82);box-shadow:0 ${1 * k}px ${4 * k}px rgba(120,130,150,.2)"></span><span style="position:absolute;left:${56 * k}px;top:${rim - 15 * k}px;width:${28 * k}px;height:${8 * k}px;border-radius:${4 * k}px;background:${o.strawCol || '#7fe0d2'}"></span>` : ''
  const handle = kind === 'mug' ? `<span style="position:absolute;left:${96 * k}px;top:${rim + gh * .22 * k}px;width:${26 * k}px;height:${gh * .46 * k}px;border:${7 * k}px solid rgba(255,255,255,.8);border-left:0;border-radius:0 ${22 * k}px ${22 * k}px 0;box-sizing:border-box;filter:drop-shadow(0 ${2 * k}px ${4 * k}px rgba(120,130,150,.25))"></span>` : ''
  return `<div style="position:relative;width:${w}px;height:${H}px">
  <span style="position:absolute;left:${10 * k}px;right:${10 * k}px;top:${H - 6 * k}px;height:${10 * k}px;border-radius:50%;background:rgba(90,96,110,.16);filter:blur(${6 * k}px)"></span>${handle}
  <svg style="position:absolute;left:0;top:${rim}px;overflow:visible;filter:blur(${5 * k}px)" width="${w}" height="${gh * k}"><path d="${path}" fill="rgba(96,104,124,.2)" transform="translate(0 ${3 * k})"/></svg>
  <div style="position:absolute;inset:0;clip-path:inset(${-60 * k}px ${-60 * k}px ${H - rim}px ${-60 * k}px)">${orbs.map(b => orb8(b, k)).join('') + straw}</div>
  <div style="position:absolute;left:0;top:${rim}px;width:${w}px;height:${gh * k}px;clip-path:path('${path}');background:rgba(255,255,255,.62)"><div style="position:absolute;left:0;top:${-rim}px;width:${w}px;height:${H}px;filter:blur(${(o.blur ?? 5.2) * k}px)">${stuff}</div>
    <div style="position:absolute;inset:0;background:linear-gradient(100deg,rgba(255,255,255,.5) 0,rgba(255,255,255,.12) 22%,rgba(255,255,255,.2) 70%,rgba(255,255,255,.5) 100%)"></div>${kind === 'cup' ? `<div style="position:absolute;inset:0;background:repeating-linear-gradient(90deg,rgba(255,255,255,.3) 0 ${1.2 * k}px,rgba(255,255,255,0) ${1.2 * k}px ${9 * k}px)"></div>` : ''}</div>
  <svg style="position:absolute;left:0;top:${rim}px;overflow:visible" width="${w}" height="${gh * k}"><path d="${path}" fill="none" stroke="rgba(255,255,255,.95)" stroke-width="${1.6 * k}"/><path d="${path}" fill="none" stroke="rgba(150,158,176,.28)" stroke-width="${.5 * k}"/></svg>${lid}
  ${(o.sparks ?? [[30, .15, 7], [66, .27, 6], [50, .35, 8], [74, .5, 7], [28, .55, 6], [36, .8, 9], [68, .88, 7], [48, .94, 6]]).map(([x, fy, s]) => spark8(x * k, (air + fy * gh) * k, s * k, .95)).join('')}
  ${o.label ? `<span style="position:absolute;${o.vlabel ? `left:${72 * k}px;top:${(air + gh - 16) * k}px;transform-origin:0 0;transform:rotate(-90deg)` : `left:0;right:0;top:${(air + 30) * k}px;text-align:center`};font:700 ${8.4 * k}px var(--sans);color:#fff;letter-spacing:.01em;white-space:nowrap;text-shadow:0 0 ${4 * k}px rgba(90,50,20,.28)">${o.label}</span>` : ''}</div>` }
// tiny centred poster type, set in two ragged columns like a colophon
const colo8 = (l, r, fs = 1, c = G8.ink) => `<div style="display:flex;justify-content:center;gap:${22 * fs}px;font:700 ${8.6 * fs}px/1.22 var(--sans);letter-spacing:.02em;color:${c}"><span style="text-align:left">${l}</span><span style="text-align:right">${r}</span></div>`
const ast8 = (s, c = G8.ink) => `<svg width="${s}" height="${s}" viewBox="0 0 20 20" style="display:block;margin:0 auto"><path d="M10 2V18M3 6L17 14M17 6L3 14" stroke="${c}" stroke-width="3.2" stroke-linecap="round"/></svg>`
const ttl8 = (t, s, c = G8.ink) => `<div style="text-align:center;font:400 ${s}px/1.1 var(--sans);letter-spacing:.01em;color:${c}">${t}</div>`

const rng8 = s => () => (s = (s * 1664525 + 1013904223) >>> 0) / 4294967296
const mix8 = (seed, cols, air = 34, gh = 150, n = 4, topper = 1) => { const r = rng8(seed), o = []
  if (topper) o.push([32 + r() * 12, air + 2 + r() * 5, 40 + r() * 8, cols[0], r() > .4 ? 'half' : ''])
  for (let i = 0; i < n; i++) o.push([30 + ((i % 2) ? 34 : 6) + r() * 10, air + gh * (.36 + .5 * (i / Math.max(1, n - 1))) + (r() - .5) * 8, 28 + r() * 14, cols[(i + 1) % cols.length], r() > .6 ? 'half' : ''])
  return o }
// any event gets a glass: the category picks the vessel and colours, the event id seeds what floats in it
const KIND8 = { food: 'tumbler', arts: 'jar', out: 'cup', night: 'mug', sq: 'tumbler' }
const gen8 = (w, cat, seed, o = {}) => { const kind = KIND8[cat], gh = o.h || (kind === 'mug' ? 112 : 132), air = o.air ?? 26
  return glass8(w, Object.assign({ kind, cols: G8[cat], h: gh, air, orbs: mix8(seed, G8[cat], air, gh, 3 + seed % 2, kind !== 'cup'), straw: kind === 'mug' ? 0 : kind === 'cup' ? 'bar' : undefined, strawCol: kind === 'cup' ? G8[cat][2] : undefined, sx: 56 }, o)) }
const gcap8 = (t, sub, fs = 1, w) => `<div style="text-align:center;${w ? `width:${w}px;` : ''}margin-top:${8 * fs}px"><div style="font:400 ${14 * fs}px/1.15 var(--sans);color:${G8.ink}">${t}</div><div style="font:700 ${7.6 * fs}px var(--sans);letter-spacing:.08em;color:#8d8781;margin-top:${4 * fs}px">${sub}</div></div>`
const rbtn8 = (k, s = 46) => cb(k, s, '#fff', G8.ink)

// ---------------- G1 · One glass at a time ----------------
const EMPTY8 = { orbs: [], pool: 0, straw: 0, sparks: [[52, .55, 9]] }
O8.G1 = [
  P8(G8.ground, `<div style="padding-top:10px">${colo8('WED NOV 11<br>MISSION GARDENS<br>6 MIN WALK', 'FREE<br>2:10 TO<br>4:40')}<div style="margin-top:8px">${ast8(16)}</div></div><div style="position:relative;height:262px"><div style="position:absolute;left:-52px;top:76px;opacity:.55">${gen8(84, 'arts', 7, { sparks: [] })}</div><div style="position:absolute;left:248px;top:70px;opacity:.55">${gen8(84, 'out', 4, { sparks: [] })}</div><div style="position:absolute;left:71px;top:4px">${glass8(138, { label: '3:00' })}</div></div><div style="margin-top:12px">${ttl8('Rose Garden Sketch', 23)}</div><div style="text-align:center;font:700 8.6px var(--sans);letter-spacing:.1em;color:#8d8781;margin-top:7px">1 OF 5 THAT FIT</div><div style="display:flex;justify-content:center;align-items:center;gap:10px;margin-top:14px">${rbtn8('x')}${B8('I’m in', G8.ink, '#fff', 1, 0, 0).replace('padding:0 20px', 'padding:0 38px')}${rbtn8('arrow')}</div>`, {}),
  D8(G8.ground, `${at(0, 22, `<div style="width:1000px">${colo8('WED NOV 11<br>FREE 2:10 TO 4:40', '5 THAT<br>FIT', 1.25)}<div style="margin-top:10px">${ast8(20)}</div></div>`)}
    ${[[70, 250, 96, 'night', 9, 'Open Night', '8:00 · RICARD'], [232, 214, 124, 'arts', 7, 'Ceramics Open Studio', '3:30 · ARTS 104'], [644, 214, 124, 'out', 4, 'Wisteria Walk', '2:15 · MISSION ARBOR'], [834, 250, 96, 'food', 12, 'Fountain Clean-up', '4:00 · MISSION LAWN']].map(([x, y, w, c, sd, t, sub]) => at(x, y, `<div style="opacity:.78">${gen8(w, c, sd, { sparks: [] })}</div>${gcap8(t, sub, w / 124, w)}`)).join('')}
    ${at(410, 96, glass8(180, { label: '3:00' }))}${at(300, 440, `<div style="width:400px">${ttl8('Rose Garden Sketch', 30)}<div style="display:flex;justify-content:center;align-items:center;gap:12px;margin-top:16px">${rbtn8('x', 44)}${B8('I’m in', G8.ink, '#fff', 1, 0, 0).replace('padding:0 20px', 'padding:0 44px')}${rbtn8('arrow', 44)}</div></div>`)}`),
  P8(G8.ground, `<div style="padding-top:10px">${colo8('WED NOV 11<br>NOTHING FITS', 'FREE<br>20 MIN')}<div style="margin-top:8px">${ast8(16)}</div></div><div style="display:grid;justify-content:center;margin-top:14px">${glass8(138, EMPTY8)}</div><div style="margin-top:14px">${ttl8('Nothing Poured Yet', 23)}</div><div style="text-align:center;font:500 12px/1.45 var(--sans);color:#7b756f;margin:8px 30px 0">Twenty minutes is too short for anything on campus. The next pour is at 6:00.</div><div style="display:flex;justify-content:center;margin-top:14px">${B8('See the 6:00 gap', G8.ink, '#fff', 1)}</div>`, {})]

// ---------------- G2 · The event page as one glass ----------------
// The fuller the glass, the fewer spots are left. The name runs up the side.
const fact8 = (a, b, fs = 1) => `<div style="text-align:center"><div style="font:700 ${8.2 * fs}px var(--sans);letter-spacing:.1em;color:#8d8781">${a}</div><div style="font:400 ${17 * fs}px var(--sans);margin-top:${4 * fs}px;color:${G8.ink}">${b}</div></div>`
const side8 = (t, s, h) => `<div style="position:absolute;right:0;top:0;width:${s * 1.4}px;height:${h}px"><div style="position:absolute;left:50%;top:50%;transform:translate(-50%,-50%) rotate(-90deg);white-space:nowrap;font:400 ${s}px/1 var(--sans);letter-spacing:.01em;color:${G8.ink}">${t}</div></div>`
const JAR70 = { kind: 'jar', cols: G8.arts, fill: .74, orbs: [[40, 38, 44, G8.arts[0], 'half'], [36, 96, 40, G8.arts[3]], [66, 104, 36, G8.arts[1]], [42, 140, 38, G8.arts[2], 'half'], [68, 150, 30, G8.arts[0]]], sx: 58 }
const JARFULL = { kind: 'jar', cols: G8.arts, fill: .97, straw: 0, orbs: [[34, 46, 40, G8.arts[0], 'half'], [64, 50, 36, G8.arts[1]], [36, 84, 40, G8.arts[3]], [66, 90, 38, G8.arts[2], 'half'], [40, 122, 40, G8.arts[1]], [68, 128, 36, G8.arts[0], 'half'], [44, 158, 38, G8.arts[2]], [70, 162, 32, G8.arts[3]]] }
O8.G2 = [
  P8('#f8f3f3', `<div style="display:flex;justify-content:space-between;padding:4px 16px 0">${back6()}${rbtn8('share', 38)}</div><div style="position:relative;height:300px;margin-top:2px"><div style="position:absolute;left:38px;top:10px">${glass8(150, JAR70)}</div>${side8('Ceramics Open Studio', 25, 300).replace('right:0', 'right:14px')}</div><div style="display:flex;justify-content:center;gap:26px;margin-top:6px">${fact8('STARTS', '3:30')}${fact8('LASTS', '1 hour')}${fact8('WALK', '8 min')}</div><div style="text-align:center;font:500 11.5px/1.4 var(--sans);color:#7b756f;margin:12px 28px 0">14 of 20 spots are taken. The fuller the glass, the fewer are left.</div><div style="padding:14px 18px 0">${B8('I’m in', G8.ink, '#fff', 1, 1, 0)}</div>`, { nav: null }),
  D8('#f8f3f3', `${at(120, 30, `<div style="position:relative;width:420px;height:480px"><div style="position:absolute;left:60px;top:20px">${glass8(240, JAR70)}</div>${side8('Ceramics Open Studio', 40, 480)}</div>`)}${at(600, 120, `<div style="width:320px"><div style="display:flex;justify-content:space-between">${fact8('STARTS', '3:30', 1.9)}${fact8('LASTS', '1 hour', 1.9)}${fact8('WALK', '8 min', 1.9)}</div><div style="font:500 15px/1.5 var(--sans);color:#7b756f;margin-top:28px">14 of 20 spots are taken. The fuller the glass, the fewer are left. Arts 104, hosted by the Art Club. Clay and aprons are there.</div><div style="display:flex;gap:10px;margin-top:26px">${B8('I’m in', G8.ink, '#fff', 1.1, 0, 0).replace('padding:0 22px', 'padding:0 56px')}${rbtn8('share', 50)}</div></div>`)}`),
  P8('#f8f3f3', `<div style="display:flex;justify-content:space-between;padding:4px 16px 0">${back6()}${rbtn8('share', 38)}</div><div style="position:relative;height:300px;margin-top:2px"><div style="position:absolute;left:38px;top:10px">${glass8(150, JARFULL)}</div>${side8('Ceramics Open Studio', 25, 300).replace('right:0', 'right:14px')}</div><div style="margin-top:6px">${ttl8('Full to the Brim', 21)}</div><div style="text-align:center;font:500 11.5px/1.4 var(--sans);color:#7b756f;margin:8px 28px 0">All 20 spots are taken. Three people are ahead of you on the waitlist.</div><div style="padding:14px 18px 0;display:grid;gap:8px">${B8('Join the waitlist', G8.ink, '#fff', 1, 1, 0)}${B8('Two like it, with room', 'none', G8.ink, 1, 1)}</div>`, { nav: null })]

// ---------------- G3 · The week as a tray of glasses ----------------
// One orb per plan. Today's glass is the big one, and each orb's colour matches its line underneath.
const dayg8 = (w, n, seed, o = {}) => glass8(w, Object.assign({ kind: 'tumbler', h: 120, air: 22, cols: G8.sq, pool: 0, blur: 3.6, straw: 0, sparks: n ? [[30, .26, 7], [68, .6, 7]] : [], orbs: Array.from({ length: n }, (_, i) => [38 + (i % 2) * 26, 22 + 120 * (.74 - i * .34), 46, G8.sq[i % 3]]) }, o))
const WK8 = [['M', 1], ['T', 0], ['T', 1], ['F', 2], ['S', 1], ['S', 0]]
const pl8 = (c, a, t, fs = 1) => `<div style="display:flex;align-items:center;gap:${10 * fs}px;padding:${9 * fs}px 0;border-top:1px solid rgba(43,38,36,.1)"><i style="width:${12 * fs}px;height:${12 * fs}px;border-radius:50%;background:${c};filter:blur(${1.2 * fs}px)"></i><span style="font:700 ${11 * fs}px var(--sans);width:${38 * fs}px">${a}</span><span style="font:400 ${14.5 * fs}px var(--sans)">${t}</span></div>`
O8.G3 = [
  P8(G8.ground, `<div style="padding-top:10px">${colo8('NOV 9 TO 15<br>MY SCHEDULE', '6 PLANS<br>THIS WEEK')}</div><div style="display:grid;justify-content:center;margin-top:34px">${dayg8(128, 2, 1, { straw: undefined, sx: 56, label: 'WED' })}</div><div style="display:flex;justify-content:center;gap:9px;margin-top:14px">${WK8.map(([d, n], i) => `<div>${dayg8(31, n, i)}<div style="text-align:center;font:700 8.6px var(--sans);margin-top:5px;color:${G8.ink}">${d}</div></div>`).join('')}</div><div style="padding:12px 24px 0">${pl8(G8.sq[0], '3:00', 'Rose garden sketch')}${pl8(G8.sq[1], '6:00', 'Therapy dogs')}</div>`, { nav: 2 }),
  D8(G8.ground, `${at(0, 20, `<div style="width:1000px">${colo8('NOV 9 TO 15<br>MY SCHEDULE', '6 PLANS<br>THIS WEEK', 1.25)}</div>`)}<div style="position:absolute;left:30px;top:96px;width:940px;display:flex;justify-content:space-between;align-items:flex-end">${[['MON', 1, ['Jam workshop']], ['TUE', 0, []], ['WED', 2, ['Rose garden sketch', 'Therapy dogs']], ['THU', 1, ['Ceramics']], ['FRI', 2, ['Art workshop', 'Open night']], ['SAT', 1, ['Wisteria walk']], ['SUN', 0, []]].map(([d, n, ps], i) => `<div style="width:${i === 2 ? 190 : 118}px;display:grid;justify-items:center">${dayg8(i === 2 ? 176 : 104, n, i, i === 2 ? { straw: undefined, sx: 56 } : {})}<div style="font:700 ${i === 2 ? 13 : 10}px var(--sans);letter-spacing:.1em;margin-top:12px;color:${G8.ink}">${d}</div><div style="height:60px;margin-top:8px;text-align:center;font:400 ${i === 2 ? 15 : 12}px/1.35 var(--sans);color:${n ? G8.ink : '#a7a19b'}">${n ? ps.join('<br>') : 'empty'}</div></div>`).join('')}</div>${at(0, 500, `<div style="width:1000px;text-align:center;font:500 13px var(--sans);color:#7b756f">One orb per plan. Tap a glass to open that day.</div>`)}`, 'My Schedule'),
  P8(G8.ground, `<div style="padding-top:10px">${colo8('NOV 9 TO 15<br>MY SCHEDULE', '0 PLANS<br>THIS WEEK')}</div><div style="display:grid;justify-content:center;margin-top:20px">${dayg8(116, 0, 1, { sparks: [[52, .5, 9]] })}</div><div style="display:flex;justify-content:center;gap:9px;margin-top:14px">${WK8.map(([d], i) => `<div>${dayg8(31, 0, i)}<div style="text-align:center;font:700 8.6px var(--sans);margin-top:5px;color:${G8.ink}">${d}</div></div>`).join('')}</div><div style="margin-top:16px">${ttl8('A Dry Week', 23)}</div><div style="text-align:center;font:500 12px/1.45 var(--sans);color:#7b756f;margin:8px 34px 0">Nothing planned yet. You have a gap today at 2:10, and five things fit it.</div><div style="display:flex;justify-content:center;margin-top:12px">${B8('Fill today’s glass', G8.ink, '#fff', 1)}</div>`, { nav: 2 })]

// ---------------- G4 · Any event gets a glass ----------------
const ANY8 = [['Persimmon Jam Workshop', 'food', 3, 'FOOD · TUMBLER'], ['Beekeeping Info Session', 'out', 8, 'OUTDOORS · CUP'], ['Advent Concert', 'night', 5, 'MUSIC · MUG'], ['Zine Night', 'arts', 11, 'ARTS · JAR'], ['Intramural Dodgeball', 'out', 14, 'OUTDOORS · CUP'], ['Resume Workshop', 'sq', 6, 'CAREER · TUMBLER'], ['Dumpling Social', 'food', 21, 'FOOD · TUMBLER'], ['Open Mic', 'night', 17, 'MUSIC · MUG'], ['Life Drawing', 'arts', 2, 'ARTS · JAR'], ['Garden Volunteer Day', 'out', 26, 'OUTDOORS · CUP']]
const acell8 = ([t, c, sd, sub], w, fs = 1) => `<div style="display:grid;justify-items:center"><div style="height:${(26 + 132) * w / 100}px;display:grid;align-items:end">${gen8(w, c, sd)}</div>${gcap8(t, sub, fs, w * 1.5)}</div>`
O8.G4 = [
