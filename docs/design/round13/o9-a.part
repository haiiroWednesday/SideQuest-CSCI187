
// =================== ROUND 9 (review: Round 13) · ideas, not layouts ===================
// Each option is one invention that changes how you use the app, the way the claw machine did.
// Most come from the name: a side quest is something a game offers you while you're on your way somewhere else.
const SEC9 = [], O9 = {}
const MONO = "'DM Mono',ui-monospace,Menlo,monospace", COND = "'Barlow Condensed','Arial Narrow',sans-serif"
const img9 = (n, w, ex = '') => `<div class="q-${n}" style="width:${w}px;${ex}"></div>`
const bg9 = (n, ex = '') => `<div class="ph-${n}" style="position:absolute;background-size:cover;${ex}"></div>`

// ---------------- Q1 · A stranger has a quest for you ----------------
const hud9 = (segs = 7, t = '2:30', fs = 1) => `<div style="display:inline-flex;align-items:center;gap:${7 * fs}px;padding:${6 * fs}px ${10 * fs}px;border-radius:${10 * fs}px;background:rgba(36,27,25,.78);color:#fff"><span style="font:700 ${9.5 * fs}px var(--sans);letter-spacing:.12em">FREE</span><span style="display:flex;gap:${2 * fs}px">${Array.from({ length: 10 }, (_, i) => `<i style="width:${7 * fs}px;height:${10 * fs}px;border-radius:${2 * fs}px;background:${i < segs ? (segs < 3 ? '#e9573f' : C8.gold) : 'rgba(255,255,255,.2)'}"></i>`).join('')}</span><span style="font:500 ${11 * fs}px ${MONO}">${t}</span></div>`
const log9 = (n, fs = 1) => `<span style="display:inline-flex;align-items:center;gap:${6 * fs}px;padding:${6 * fs}px ${10 * fs}px;border-radius:${10 * fs}px;background:rgba(36,27,25,.78);color:#fff;font:700 ${10.5 * fs}px var(--sans)">Quest log<span style="min-width:${16 * fs}px;height:${16 * fs}px;border-radius:${8 * fs}px;background:${C8.gold};color:${C8.ink};display:inline-grid;place-content:center;font-size:${9.5 * fs}px">${n}</span></span>`
const dlg9 = (who, text, choices, hint, fs = 1, sel = 0) => `<div style="position:relative;background:${C8.paper};border:${2.5 * fs}px solid ${C8.ink};border-radius:${16 * fs}px;box-shadow:0 0 0 ${3 * fs}px ${C8.paper},0 0 0 ${5 * fs}px ${C8.ink},0 ${14 * fs}px ${28 * fs}px rgba(0,0,0,.35);padding:${20 * fs}px ${15 * fs}px ${12 * fs}px">
  <span style="position:absolute;left:${14 * fs}px;top:${-14 * fs}px;padding:${5 * fs}px ${12 * fs}px;background:${C8.ink};color:#fff;border-radius:${8 * fs}px;font:700 ${10.5 * fs}px var(--sans);letter-spacing:.14em">${who}</span>
  <div style="font:400 ${19 * fs}px/1.22 var(--serif)">${text}<span style="display:inline-block;width:${8 * fs}px;height:${15 * fs}px;margin-left:${3 * fs}px;background:${C8.ink};vertical-align:${-2 * fs}px;animation:q9blink 1s steps(1) infinite"></span></div>
  <div style="display:grid;gap:${3 * fs}px;margin-top:${11 * fs}px">${choices.map((c, i) => `<div style="display:flex;align-items:center;gap:${8 * fs}px;padding:${8 * fs}px ${10 * fs}px;border-radius:${10 * fs}px;font:700 ${13.5 * fs}px var(--sans);${i === sel ? `background:${C8.ink};color:#fff` : ''}"><span style="width:${10 * fs}px;color:${C8.gold};${i === sel ? 'animation:q9nudge .8s ease-in-out infinite' : 'visibility:hidden'}">▶</span>${c}</div>`).join('')}</div>
  ${hint ? `<div style="font:500 ${10.5 * fs}px var(--sans);color:${C8.muted};margin-top:${8 * fs}px;text-align:right">${hint}</div>` : ''}</div>`
const npc9 = (kind, col, mood, s, bubble = '!', bcol = C8.red) => `<div style="position:relative;width:${s}px;height:${s}px"><span style="position:absolute;left:8%;right:8%;bottom:${-s * .06}px;height:${s * .16}px;border-radius:50%;background:rgba(0,0,0,.32);filter:blur(${s * .04}px)"></span><div style="position:relative;animation:q9bob 2.4s ease-in-out infinite">${blob(kind, col, s, mood)}</div><span style="position:absolute;left:${s * .72}px;top:${-s * .34}px;min-width:${s * .36}px;height:${s * .36}px;padding:0 ${s * .06}px;border-radius:${s * .18}px ${s * .18}px ${s * .18}px ${s * .04}px;background:${bcol};color:#fff;display:grid;place-content:center;font:700 ${s * .26}px var(--sans);box-shadow:0 ${s * .04}px ${s * .1}px rgba(0,0,0,.3);animation:q9bob 1.2s ease-in-out infinite">${bubble}</span></div>`
const scrim9 = `<div style="position:absolute;inset:0;background:linear-gradient(180deg,rgba(36,27,25,.25) 0,rgba(36,27,25,0) 22%,rgba(36,27,25,0) 46%,rgba(36,27,25,.6) 100%)"></div>`
const QTXT = 'We’re sketching the roses at 3:00. Pencils are on us. You’re free till 4:40, right?'
O9.Q1 = [
  P8(C8.night, `<div style="position:absolute;left:0;top:-44px;width:280px;height:600px">${bg9('rosegarden', 'inset:0;background-position:42% 50%')}${scrim9}</div>${at(10, 2, hud9(7, '2:30', .84))}${at(0, 2, log9(2, .84), 'left:auto;right:10px')}${at(34, 176, npc9('star', C8.gold, 'happy', 84))}<div style="position:absolute;left:12px;right:12px;bottom:16px">${dlg9('ART CLUB', QTXT, ['I’m in', 'Maybe', 'Not today'], '6 min walk · back by 4:12')}</div>`, { light: true, nav: null }),
  D8(C8.night, `<div style="position:absolute;inset:0;overflow:hidden">${bg9('rosegarden', 'inset:0;background-position:50% 62%')}${scrim9}</div>${at(28, 20, hud9(7, '2:30', 1.3))}${at(430, 96, npc9('star', C8.gold, 'happy', 130))}<div style="position:absolute;left:28px;bottom:28px;width:560px">${dlg9('ART CLUB', QTXT, ['I’m in', 'Maybe', 'Not today'], '6 min walk · back by 4:12', 1.28)}</div><div style="position:absolute;right:28px;top:20px;width:300px;background:rgba(36,27,25,.82);color:#fff;border-radius:18px;padding:18px"><div style="font:700 11px var(--sans);letter-spacing:.14em;color:${C8.gold}">QUEST LOG</div>${[['!', 'Rose garden sketch', 'Art Club · 3:00 · asking now', C8.red], ['2', 'Therapy dogs', 'Library lawn · 2:30 · Kai’s going', C8.sage], ['?', 'Open night', 'Ricard · 8:00 · you said maybe', '#6f6660']].map(([m, t, s, c]) => `<div style="display:flex;gap:12px;align-items:center;margin-top:14px"><span style="width:30px;height:30px;border-radius:50%;background:${c};display:grid;place-content:center;font:700 14px var(--sans);flex:none">${m}</span><div><div style="font:400 20px/1.05 var(--serif)">${t}</div><div style="font:500 11.5px var(--sans);opacity:.7;margin-top:2px">${s}</div></div></div>`).join('')}<div style="font:500 12px/1.45 var(--sans);opacity:.65;margin-top:16px">Arrow keys move, Enter answers. Every quest waits here until it starts.</div></div>`, 'Discover', 1),
  P8(C8.night, `<div style="position:absolute;left:0;top:-44px;width:280px;height:600px">${bg9('observatory', 'inset:0;background-position:40% 60%;filter:saturate(.7) brightness(.8)')}${scrim9}</div>${at(10, 2, hud9(1, '0:20', .84))}${at(0, 2, log9(0, .84), 'left:auto;right:10px')}${at(40, 196, npc9('cloud', '#c9d7c3', 'sleepy', 80, '…', '#6f6660'))}<div style="position:absolute;left:12px;right:12px;bottom:16px">${dlg9('THE QUAD', 'Quiet out here. Nothing starts in the next twenty minutes. A new quest turns up at 6:00.', ['Rest here', 'Wake me at 5:45', 'Show every quest today'], '')}</div>`, { light: true, nav: null })]

// ---------------- Q2 · The quest board, with tear-off tabs ----------------
const CORK = `background:radial-gradient(rgba(84,54,28,.2) 1px,transparent 1.5px) 0 0/7px 7px,radial-gradient(rgba(255,238,205,.3) 1px,transparent 1.5px) 3px 4px/9px 9px,radial-gradient(rgba(84,54,28,.12) 1.4px,transparent 2px) 5px 1px/13px 11px,#c9a374`
const pin9 = (c = C8.red, x = '50%') => `<span style="position:absolute;left:${x};top:-7px;margin-left:-8px;width:16px;height:16px;border-radius:50%;background:radial-gradient(circle at 35% 30%,rgba(255,255,255,.75) 0 16%,rgba(255,255,255,0) 20%),${c};box-shadow:1px 4px 3px rgba(40,20,5,.4);z-index:2"></span>`
// a row of tear-off tabs: torn ones leave a gap, so tabs left = spots left
const tabs9 = (n, torn, bg, col, fs = 1, label = 'I’M IN') => `<div style="display:flex;border-top:${1.2 * fs}px dashed ${col === '#fff' ? 'rgba(255,255,255,.6)' : 'rgba(48,36,33,.4)'}">${Array.from({ length: n }, (_, i) => `<span style="flex:1;height:${50 * fs}px;${torn.includes(i) ? 'visibility:hidden' : `background:${bg};border-left:${i ? 1 : 0}px dashed ${col === '#fff' ? 'rgba(255,255,255,.5)' : 'rgba(48,36,33,.35)'};transform:rotate(${((i * 7) % 5) - 2}deg);transform-origin:50% 0`};display:grid;place-content:center"><span style="writing-mode:vertical-rl;font:700 ${8.6 * fs}px var(--sans);letter-spacing:.1em;color:${col}">${label}</span></span>`).join('')}</div>`
const note9 = (x, y, w, rot, bg, inner, o = {}) => `<div style="position:absolute;left:${x}px;top:${y}px;width:${w}px;transform:rotate(${rot}deg);filter:drop-shadow(2px 6px 5px rgba(60,35,10,.35))">${pin9(o.pin || C8.red, o.pinX)}<div style="background:${bg};color:${o.col || C8.ink};padding:${o.pad ?? 12}px;${o.ex || ''}">${inner}</div>${o.tabs ? tabs9(o.tabs, o.torn || [], bg.includes('gradient') ? C8.paper : bg, o.col || C8.ink, o.fs || 1) : ''}</div>`
const RULED = `repeating-linear-gradient(180deg,rgba(47,93,138,0) 0 19px,rgba(47,93,138,.28) 19px 20px),${C8.paper}`
const card9 = (fs = 1) => `<div style="font:700 ${10 * fs}px var(--sans);letter-spacing:.12em;color:${C8.red}">TODAY · 3:00</div><div style="font:400 ${27 * fs}px/1 var(--serif);margin-top:${6 * fs}px">Rose garden sketch</div><div style="font:500 ${11.5 * fs}px/1.4 var(--sans);margin-top:${6 * fs}px">Mission Gardens. Pencils provided.<br><b>5 tabs left</b>, tear one to come.</div>`
const jam9 = (fs = 1) => `<div style="font:800 ${30 * fs}px/.9 var(--sans);letter-spacing:-.02em">FALL<br>JAM</div><div style="font:500 ${10.5 * fs}px/1.35 var(--sans);margin-top:${6 * fs}px;opacity:.92">Persimmon jam workshop<br>Benson patio · Thu 4:30</div>`
const wood9 = (t, fs = 1) => `<div style="height:${30 * fs}px;background:linear-gradient(180deg,#6a4631,#523423);color:#f3dcb8;display:flex;align-items:center;justify-content:center;gap:${10 * fs}px;font:700 ${10.5 * fs}px var(--sans);letter-spacing:.2em;box-shadow:0 3px 6px rgba(40,20,5,.35)">${t}</div>`
const brass9 = (t, fs = 1) => `<span style="display:inline-flex;align-items:center;gap:${8 * fs}px;padding:${11 * fs}px ${20 * fs}px;border-radius:999px;background:linear-gradient(180deg,#f3c452,#d9961c);color:${C8.ink};font:700 ${13.5 * fs}px var(--sans);box-shadow:inset 0 1px 0 rgba(255,255,255,.6),0 6px 12px rgba(40,20,5,.4)"><i style="width:${12 * fs}px;height:${12 * fs}px;border-radius:50%;background:${C8.red};box-shadow:inset -2px -2px 0 rgba(0,0,0,.2)"></i>${t}</span>`
O9.Q2 = [
  P8('#c9a374', `<div style="position:absolute;left:0;top:-44px;right:0;bottom:0;${CORK}"></div><div style="position:absolute;left:0;right:0;top:-2px">${wood9('QUEST BOARD · WED NOV 11')}</div>
    ${note9(14, 48, 176, -3, RULED, card9(), { tabs: 8, torn: [1, 4, 6] })}
    ${note9(176, 40, 96, 6, '#f7dc6f', `<div style="font:400 20px/1 var(--serif)">Therapy dogs</div><div style="font:600 10.5px/1.35 var(--sans);margin-top:6px">2:30 · Library lawn<br>just show up</div>`, { pin: C8.blue, pad: 10 })}
    ${note9(190, 172, 82, -5, '#fff', `${pic('dog', 70, 62, 55, 40)}<div style="font:400 12px var(--serif);text-align:center;margin-top:4px">today!</div>`, { pin: C8.gold, pad: 6 })}
    ${note9(16, 268, 138, 3, C8.blue, jam9(), { col: '#fff', tabs: 6, torn: [0, 1, 2, 3, 5], pin: C8.gold })}
    ${at(24, 428, `<div style="transform:rotate(-6deg);font:400 18px var(--serif);color:${C8.maroon}">1 left!</div>`)}
    ${note9(164, 300, 106, -6, C8.pink, `<div style="font:700 9px var(--sans);letter-spacing:.12em;color:${C8.red}">FRI · 8:00 PM</div><div style="font:400 21px/1 var(--serif);margin-top:4px">Open night</div><div style="font:500 10px var(--sans);margin-top:4px">Ricard Observatory</div>`, { pin: C8.sage, pad: 10, ex: 'border-radius:4px 14px 4px 14px' })}
    <div style="position:absolute;right:14px;bottom:86px">${brass9('Pin a notice')}</div>`, { light: true }),
  D8('#c9a374', `<div style="position:absolute;inset:0;${CORK};box-shadow:inset 0 0 0 12px #5a3a27,inset 0 0 0 14px #3f2819"></div>
    ${note9(60, 54, 250, -3, RULED, card9(1.35), { tabs: 8, torn: [1, 4, 6], fs: 1.3, pad: 18 })}
    ${note9(350, 44, 150, 5, '#f7dc6f', `<div style="font:400 28px/1 var(--serif)">Therapy dogs</div><div style="font:600 13px/1.4 var(--sans);margin-top:8px">2:30 · Library lawn<br>just show up</div>`, { pin: C8.blue, pad: 14 })}
    ${note9(540, 60, 130, -4, '#fff', `${pic('dog', 114, 100, 55, 40)}<div style="font:400 16px var(--serif);text-align:center;margin-top:6px">today!</div>`, { pin: C8.gold, pad: 8 })}
    ${note9(710, 46, 220, 3, C8.blue, jam9(1.5), { col: '#fff', tabs: 6, torn: [0, 1, 2, 3, 5], pin: C8.gold, fs: 1.3, pad: 18 })}
    ${at(880, 250, `<div style="transform:rotate(-8deg);font:400 24px var(--serif);color:${C8.maroon}">1 left!</div>`)}
    ${note9(360, 250, 170, -5, C8.pink, `<div style="font:700 11px var(--sans);letter-spacing:.12em;color:${C8.red}">FRI · 8:00 PM</div><div style="font:400 30px/1 var(--serif);margin-top:6px">Open night</div><div style="font:500 12.5px var(--sans);margin-top:6px">Ricard Observatory</div>`, { pin: C8.sage, pad: 16, ex: 'border-radius:4px 18px 4px 18px' })}
    ${note9(570, 250, 150, 4, C8.sageT, `<div style="font:400 24px/1.05 var(--serif)">Wisteria walk</div><div style="font:600 12px/1.4 var(--sans);margin-top:6px">Sat 1:30 · meet at the arbor</div>`, { pin: C8.red, pad: 14, tabs: 5, torn: [2], fs: 1.1 })}
    ${note9(70, 380, 200, 2, '#fff', `<div style="font:500 13px/1.45 var(--sans)"><b>How this board works.</b> Tear a tab and the event is yours. Tabs left are spots left. A notice with no tabs is open to anyone.</div>`, { pin: C8.ink, pad: 14 })}
    <div style="position:absolute;right:54px;bottom:44px">${brass9('Pin a notice', 1.25)}</div>`),
  P8('#c9a374', `<div style="position:absolute;left:0;top:-44px;right:0;bottom:0;${CORK}"></div><div style="position:absolute;left:0;right:0;top:-2px">${wood9('QUEST BOARD · WED NOV 11')}</div>
    ${[[30, 70, 120, 90, -3], [170, 60, 84, 84, 5], [40, 220, 110, 130, 2]].map(([x, y, w, h, r]) => `<div style="position:absolute;left:${x}px;top:${y}px;width:${w}px;height:${h}px;transform:rotate(${r}deg);background:rgba(255,240,210,.22);box-shadow:inset 0 0 0 1px rgba(84,54,28,.12)"></div><i style="position:absolute;left:${x + w / 2}px;top:${y + 2}px;width:4px;height:4px;border-radius:50%;background:rgba(60,35,10,.55)"></i>`).join('')}
    ${note9(66, 150, 160, -2, C8.paper, `<div style="font:400 25px/1.02 var(--serif)">Nothing’s pinned for today.</div><div style="font:500 11.5px/1.4 var(--sans);margin-top:8px">The pale patches are where yesterday’s notices were. Pin the first one and it’s the only thing 212 people see.</div>`, { pad: 14 })}
    <div style="position:absolute;left:0;right:0;bottom:84px;text-align:center">${brass9('Pin a notice')}</div>`, { light: true })]

// ---------------- Q3 · Main line, side quests ----------------
// Your day is a transit line. Classes are stations on the main line. A side quest is a branch that leaves and has to rejoin
// before the next station. The slanted, dashed parts are the walk. A friend's line that shares a station is a transfer.
const metro9 = (W, H, o) => { const { vert, k, a, base, lw, fs = 1 } = o, T = t => { const [h, m] = t.split(':').map(Number); return (h - 2) * 60 + m }
  const P = (t, lane) => { const u = a + (typeof t === 'number' ? t : T(t)) * k, v = base + lane * lw; return vert ? [v, u] : [u, v] }, S = p => p.map(n => n.toFixed(1)).join(' ')
  const br = o.branches.map(b => { const s = T(b.s), e = T(b.e), p0 = P(s - b.walk * 2.2, 0), p1 = P(s, b.lane), p2 = P(e, b.lane), late = b.late, p3 = late ? P(e + 6, b.lane) : P(e + b.walk * 2.2, 0), mid = P((s + e) / 2, b.lane)
    return `<path d="M${S(p0)}L${S(p1)}" stroke="${b.c}" stroke-width="${5 * fs}" stroke-dasharray="${2 * fs} ${7 * fs}" stroke-linecap="round" fill="none"/>${late ? '' : `<path d="M${S(p2)}L${S(p3)}" stroke="${b.c}" stroke-width="${5 * fs}" stroke-dasharray="${2 * fs} ${7 * fs}" stroke-linecap="round" fill="none"/>`}<path d="M${S(p1)}L${S(p2)}" stroke="${b.c}" stroke-width="${(b.on ? 9 : 6) * fs}" stroke-linecap="round" fill="none" ${late ? `stroke-dasharray="${10 * fs} ${6 * fs}"` : ''}/>
      ${late ? `<g transform="translate(${S(P(e, b.lane))})"><circle r="${9 * fs}" fill="${C8.red}"/><path d="M${-4 * fs} ${-4 * fs}L${4 * fs} ${4 * fs}M${4 * fs} ${-4 * fs}L${-4 * fs} ${4 * fs}" stroke="#fff" stroke-width="${2.4 * fs}" stroke-linecap="round"/></g>` : ''}
      <circle cx="${p1[0]}" cy="${p1[1]}" r="${5.5 * fs}" fill="#fff" stroke="${b.c}" stroke-width="${3 * fs}"/>${b.xfer ? `<circle cx="${mid[0]}" cy="${mid[1]}" r="${8 * fs}" fill="#fff" stroke="${C8.ink}" stroke-width="${2.6 * fs}"/><circle cx="${mid[0]}" cy="${mid[1]}" r="${3.4 * fs}" fill="${C8.ink}"/>` : ''}` }).join('')
  const labels = o.branches.map(b => { const s = T(b.s), e = T(b.e), p = P(vert ? (s + e) / 2 : s, b.lane)
    return `<div style="position:absolute;left:${p[0] + (vert ? (b.lx ?? 12) * fs : (b.lx ?? 0) * fs)}px;top:${p[1] + (vert ? (-15 + (b.dy || 0)) * fs : (b.ly ?? -44) * fs)}px;white-space:nowrap;background:${o.bg};padding:${2 * fs}px ${4 * fs}px;border-radius:${4 * fs}px"><div style="font:400 ${(b.on ? 19 : 16) * fs}px/1 var(--serif);color:${b.late ? C8.muted : C8.ink}">${b.name}</div><div style="font:600 ${9.5 * fs}px var(--sans);color:${b.late ? C8.red : b.c === C8.gold ? C8.goldI : b.c};margin-top:${2 * fs}px">${b.note}</div></div>` }).join('')
  const m0 = P(-12, 0), m1 = P(o.end ?? 192, 0)
  const st = o.stations.map(([t, name, sub, warn]) => { const p = P(t, 0); return `<circle cx="${p[0]}" cy="${p[1]}" r="${8 * fs}" fill="#fff" stroke="${warn ? C8.red : C8.ink}" stroke-width="${3 * fs}"/>` }).join('')
  const stl = o.stations.map(([t, name, sub, warn]) => { const p = P(t, 0); return `<div style="position:absolute;${vert ? `left:0;width:${p[0] - 14 * fs}px;top:${p[1] - 12 * fs}px;text-align:right` : `left:${p[0] - 50 * fs}px;width:${100 * fs}px;top:${p[1] + 14 * fs}px;text-align:center`}"><div style="font:700 ${11.5 * fs}px var(--sans);color:${warn ? C8.red : C8.ink}">${name}</div><div style="font:500 ${9.5 * fs}px var(--sans);color:${C8.muted}">${sub}</div></div>` }).join('')
  const now = P(o.now || '2:10', 0)
  const fr = (o.friends || []).map(f => `<path d="${f.d(P)}" stroke="${f.c}" stroke-width="${3.4 * fs}" fill="none" stroke-linecap="round" stroke-linejoin="round"/>`).join('')
  const frl = (o.friends || []).map(f => { const p = P(f.at[0], f.at[1]); return `<div style="position:absolute;left:${p[0] + (f.lx || 0) * fs}px;top:${p[1] + (f.ly || 0) * fs}px;font:700 ${10 * fs}px var(--sans);color:${f.c};white-space:nowrap;background:${o.bg};padding:0 ${3 * fs}px">${f.name}</div>` }).join('')
  return `<div style="position:relative;width:${W}px;height:${H}px"><svg width="${W}" height="${H}" style="position:absolute;left:0;top:0;overflow:visible">${fr}<path d="M${S(m0)}L${S(m1)}" stroke="${C8.maroon}" stroke-width="${11 * fs}" stroke-linecap="round"/>${br}${st}<circle cx="${now[0]}" cy="${now[1]}" r="${6 * fs}" fill="${C8.gold}" stroke="${C8.ink}" stroke-width="${2 * fs}"/><circle cx="${now[0]}" cy="${now[1]}" r="${6 * fs}" fill="none" stroke="${C8.gold}" stroke-width="${2 * fs}" style="transform-origin:${now[0]}px ${now[1]}px;animation:q9ping 1.8s ease-out infinite"/></svg>${stl}${labels}${frl}</div>` }
const BR9 = [{ s: '2:30', e: '3:00', lane: 1, walk: 4, c: C8.gold, name: 'Therapy dogs', note: '2:30 · 4 min walk' }, { s: '3:00', e: '4:00', lane: 2, walk: 6, c: C8.sage, name: 'Rose sketch', note: '3:00 · 34 min spare', on: 1 }, { s: '3:30', e: '4:30', lane: 1, walk: 3, c: C8.blue, name: 'Ceramics', note: '3:30 · Kai gets on here', xfer: 1, dy: 18 }]
const key9 = (fs = 1, c = C8.ink) => `<div style="display:flex;gap:${12 * fs}px;align-items:center;font:600 ${9.5 * fs}px var(--sans);color:${c}"><span style="display:inline-flex;align-items:center;gap:${5 * fs}px"><i style="width:${18 * fs}px;height:${6 * fs}px;border-radius:${3 * fs}px;background:${C8.maroon}"></i>your classes</span><span style="display:inline-flex;align-items:center;gap:${5 * fs}px"><i style="width:${18 * fs}px;height:${5 * fs}px;border-radius:${3 * fs}px;background:${C8.sage}"></i>a side quest</span><span style="display:inline-flex;align-items:center;gap:${5 * fs}px"><i style="width:${18 * fs}px;border-top:${3 * fs}px dotted ${C8.sage}"></i>the walk</span></div>`
const ride9 = (t, sub, btn, fs = 1, ghost) => `<div style="display:flex;align-items:center;gap:${12 * fs}px;background:#fff;border-radius:${20 * fs}px;padding:${12 * fs}px ${12 * fs}px ${12 * fs}px ${16 * fs}px;box-shadow:0 8px 20px rgba(48,36,33,.12)"><div style="flex:1"><div style="font:400 ${21 * fs}px/1.05 var(--serif)">${t}</div><div style="font:500 ${11 * fs}px var(--sans);color:${C8.muted};margin-top:${3 * fs}px">${sub}</div></div>${B8(btn, ghost ? 'none' : C8.sage, ghost ? C8.ink : '#fff', .84 * fs, 0, 0)}</div>`
O9.Q3 = [
  P8(C8.paper, `<div style="position:absolute;left:14px;top:4px">${key9()}</div><div style="position:absolute;left:0;top:26px">${metro9(280, 380, { vert: 1, k: 1.92, a: 24, base: 62, lw: 58, bg: C8.paper, branches: BR9, stations: [['2:10', 'Chem', 'ends 2:10'], ['4:40', 'Stats', '4:40']], end: 178 })}</div><div style="position:absolute;left:12px;right:12px;bottom:80px">${ride9('Ride the Rose line', 'Leave 2:54 · back on the main line by 4:06', 'Board')}</div>`, {}),
  D8(C8.paper, `<div style="position:absolute;left:0;top:0">${metro9(1000, 569, { vert: 0, k: 4.1, a: 110, base: 330, lw: -92, fs: 1.5, bg: C8.paper, end: 196, branches: [{ ...BR9[0], ly: -50, lx: -10 }, { ...BR9[1], ly: -56 }, { ...BR9[2], ly: -54, lx: 30 }], stations: [['2:10', 'Chem ends', '2:10'], ['4:40', 'Stats', '4:40 · Kenna']], friends: [{ c: C8.terra, name: 'Kai’s line', at: ['2:16', -1.05], ly: -20, d: P => `M-10 ${P(0, -1.05)[1]}L${P('3:08', -1.05).join(' ')}L${P('3:32', 1.08).join(' ')}L${P('4:28', 1.08).join(' ')}L${P('4:52', -1.05).join(' ')}L1010 ${P(0, -1.05)[1]}` }, { c: '#7a5a8a', name: 'Ari’s line', at: ['2:16', -1.6], ly: 8, d: P => `M-10 ${P(0, -1.6)[1]}L${P('2:08', -1.6).join(' ')}L${P('2:32', 1.08).join(' ')}L${P('2:58', 1.08).join(' ')}L${P('3:22', -1.6).join(' ')}L1010 ${P(0, -1.6)[1]}` }] })}</div>
    <div style="position:absolute;left:36px;top:20px;border:2px solid ${C8.ink};padding:12px 16px;background:${C8.paper}"><div style="font:400 30px/1 var(--serif)">Wednesday afternoon</div><div style="margin-top:10px">${key9(1.15)}</div><div style="font:600 11px var(--sans);margin-top:8px;display:flex;gap:14px"><span style="color:${C8.terra}">▬ Kai</span><span style="color:#7a5a8a">▬ Ari</span><span>◉ you’d be there together</span></div></div>
    <div style="position:absolute;right:36px;bottom:22px;width:400px">${ride9('Ride the Rose line', 'Leave 2:54 · back on the main line by 4:06', 'Board', 1.2)}</div>`),
  P8(C8.paper, `<div style="position:absolute;left:14px;top:4px">${key9()}</div><div style="position:absolute;left:0;top:26px">${metro9(280, 380, { vert: 1, k: 1.92, a: 24, base: 62, lw: 58, bg: C8.paper, end: 190, branches: [{ s: '3:45', e: '5:00', lane: 1, walk: 5, c: '#8d857f', name: 'Board games', note: 'ends 5:00, 20 min late', late: 1 }], stations: [['2:10', 'Chem', 'ends 2:10'], ['4:40', 'Stats', '4:40', 1]] })}</div><div style="position:absolute;left:12px;right:12px;bottom:80px">${ride9('This one can’t rejoin', 'The only line leaving this gap misses Stats.', 'Tomorrow', 1, 1)}</div>`, {})]

// ---------------- Q4 · Minutes are money ----------------
// Your gap is your balance. An event's price is its length plus the walk both ways. The plan prints as a receipt.
const VEND = [['ceramics', 'A1', 76, 'Ceramics'], ['roses', 'A2', 72, 'Rose sketch'], ['cup', 'A3', 38, 'Therapy dogs'], ['camera', 'B1', 55, 'Photo walk'], ['record', 'B2', 50, 'Listening hour'], ['picnic', 'B3', 130, 'Quad picnic'], ['bike', 'C1', 190, 'Reservoir ride'], ['dome', 'C2', 0, 'Open night'], ['bell', 'C3', 40, 'Bell tower']]
const led9 = (a, b, fs = 1, warn) => `<div style="background:#150f0d;border-radius:${10 * fs}px;padding:${8 * fs}px ${12 * fs}px;display:flex;justify-content:space-between;align-items:baseline;box-shadow:inset 0 2px 6px rgba(0,0,0,.6);font-family:${MONO};color:${warn ? '#ff7a5c' : '#ffc44d'};text-shadow:0 0 ${6 * fs}px ${warn ? 'rgba(255,122,92,.6)' : 'rgba(255,196,77,.55)'}"><span style="font-size:${10 * fs}px;letter-spacing:.14em">${a}</span><span style="font-size:${20 * fs}px;letter-spacing:.04em">${b}</span></div>`
const slot9 = ([n, code, price, name], cw, fs, bal, sel) => { const off = !price || price > bal
  return `<div style="position:relative;width:${cw}px;display:grid;justify-items:center"><div style="height:${cw * .74}px;display:grid;align-items:end;${off ? 'opacity:.3;filter:grayscale(.6)' : ''}">${img9(n, cw * (n === 'cup' || n === 'bell' ? .5 : .84))}</div><div style="width:100%;height:${4 * fs}px;background:linear-gradient(180deg,#8a7f78,#4d4541);margin-top:${3 * fs}px"></div><span style="margin-top:${3 * fs}px;padding:${2 * fs}px ${6 * fs}px;border-radius:${4 * fs}px;background:${code === sel ? C8.red : off ? '#5b514c' : '#f6d867'};color:${code === sel ? '#fff' : off ? '#c9c0ba' : C8.ink};font:500 ${9.5 * fs}px ${MONO};white-space:nowrap">${code} ${!price ? '8PM' : price > bal ? 'TOO LONG' : price + ' MIN'}</span>${code === sel ? `<span style="position:absolute;inset:${-4 * fs}px ${2 * fs}px ${20 * fs}px;border:${2 * fs}px solid ${C8.gold};border-radius:${10 * fs}px;box-shadow:0 0 ${10 * fs}px rgba(232,170,36,.6)"></span>` : ''}</div>` }
const glass9 = (cw, fs, bal, sel, cols = 3) => `<div style="background:linear-gradient(160deg,#3b2f2b,#231a18);border-radius:${14 * fs}px;padding:${12 * fs}px ${8 * fs}px ${8 * fs}px;display:grid;grid-template-columns:repeat(${cols},1fr);gap:${10 * fs}px ${4 * fs}px;justify-items:center;box-shadow:inset 0 0 0 ${3 * fs}px #1a1210,inset 0 0 ${24 * fs}px rgba(0,0,0,.5);position:relative;overflow:hidden">${VEND.map(v => slot9(v, cw, fs, bal, sel)).join('')}<span style="position:absolute;left:-20%;top:-10%;width:40%;height:140%;background:linear-gradient(90deg,rgba(255,255,255,0),rgba(255,255,255,.07),rgba(255,255,255,0));transform:rotate(18deg)"></span></div>`
const rcpt9 = (lines, w, fs = 1) => `<div style="width:${w}px;background:#fffdf8;color:#2b2624;font:500 ${9.6 * fs}px/1.55 ${MONO};padding:${12 * fs}px ${12 * fs}px ${18 * fs}px;box-sizing:border-box;clip-path:polygon(0 0,100% 0,100% calc(100% - 6px),95% 100%,90% calc(100% - 6px),85% 100%,80% calc(100% - 6px),75% 100%,70% calc(100% - 6px),65% 100%,60% calc(100% - 6px),55% 100%,50% calc(100% - 6px),45% 100%,40% calc(100% - 6px),35% 100%,30% calc(100% - 6px),25% 100%,20% calc(100% - 6px),15% 100%,10% calc(100% - 6px),5% 100%,0 calc(100% - 6px))">${lines.map(l => l === '-' ? `<div style="border-top:1px dashed #2b2624;margin:${4 * fs}px 0"></div>` : Array.isArray(l) ? `<div style="display:flex;justify-content:space-between;gap:8px;${l[2] ? `font-size:${13 * fs}px;font-weight:500` : ''}"><span>${l[0]}</span><span>${l[1]}</span></div>` : `<div>${l}</div>`).join('')}</div>`
const RC = ['SIDEQUEST · WED 2:10', '-', 'A2 ROSE GARDEN SKETCH', ['walk there', '6'], ['sketching', '60'], ['walk back', '6'], '-', ['TOTAL', '72 MIN', 1], ['CHANGE', '78 MIN', 1], '-', 'A3 FITS YOUR CHANGE']
const vbtn9 = (fs = 1, t = 'VEND') => `<span style="width:${70 * fs}px;height:${70 * fs}px;border-radius:50%;background:radial-gradient(circle at 35% 30%,#ffd978,#e8aa24 60%,#b97d0c);display:grid;place-content:center;font:700 ${13 * fs}px var(--sans);letter-spacing:.1em;color:${C8.ink};box-shadow:0 ${5 * fs}px 0 #7a5208,0 ${10 * fs}px ${16 * fs}px rgba(0,0,0,.4)">${t}</span>`
O9.Q4 = [
  P8(C8.maroon, `<div style="padding:4px 12px 0">${led9('BALANCE', '150 MIN')}</div><div style="padding:10px 12px 0">${glass9(74, 1, 150, 'A2')}</div><div style="position:absolute;left:12px;right:12px;top:384px;height:10px;border-radius:5px;background:#150f0d;box-shadow:inset 0 2px 4px rgba(0,0,0,.7)"></div><div style="position:absolute;left:22px;top:389px;animation:q9print 2.2s ease-out both">${rcpt9(RC, 152)}</div><div style="position:absolute;right:26px;top:416px;display:grid;justify-items:center;gap:10px">${vbtn9()}<span style="font:600 10px var(--sans);color:rgba(255,255,255,.7)">coin return</span></div>`, { light: true, nav: null }),
  D8(C8.maroon, `<div style="position:absolute;left:40px;top:16px;width:470px"><div>${led9('BALANCE · YOUR GAP 2:10 TO 4:40', '150 MIN', 1.3)}</div><div style="margin-top:12px">${glass9(128, 1.35, 150, 'A2')}</div></div><div style="position:absolute;left:560px;top:16px">${rcpt9(RC.concat(['-', 'TAP VEND TO SAVE THIS PLAN']), 250, 1.5)}</div><div style="position:absolute;left:850px;top:60px;display:grid;justify-items:center;gap:14px">${vbtn9(1.4)}<div style="font:500 13px/1.45 var(--sans);color:rgba(255,255,255,.8);width:120px;text-align:center">A price is the event plus the walk both ways.</div></div>`, 'Discover', 1),
  P8(C8.maroon, `<div style="padding:4px 12px 0">${led9('INSERT MORE TIME', '20 MIN', 1, 1)}</div><div style="padding:10px 12px 0">${glass9(74, 1, 20, '')}</div><div style="position:absolute;left:12px;right:12px;top:384px;height:10px;border-radius:5px;background:#150f0d;box-shadow:inset 0 2px 4px rgba(0,0,0,.7)"></div><div style="position:absolute;left:22px;top:389px">${rcpt9(['SIDEQUEST · WED 2:10', '-', 'NOTHING UNDER 20 MIN', ['cheapest', '38 MIN'], '-', 'NEXT REFILL 6:00 PM', ['you get', '90 MIN', 1]], 152)}</div><div style="position:absolute;right:20px;top:420px;display:grid;justify-items:center;gap:10px">${vbtn9(1, '6:00')}<span style="font:600 10px var(--sans);color:rgba(255,255,255,.7)">shop the 6:00 gap</span></div>`, { light: true, nav: null })]

// ---------------- Q5 · Departures ----------------
const flap9 = (ch, s, c, flip) => `<span style="display:inline-grid;place-content:center;width:${s * .64}px;height:${s}px;margin-right:${Math.max(1, s * .07)}px;border-radius:${s * .12}px;background:linear-gradient(180deg,#3a302c 0 48%,#120d0c 48% 52%,#2c2421 52%);color:${c};font:700 ${s * .74}px/1 ${COND};${flip ? 'animation:q9flip 2.6s ease-in-out infinite;transform-origin:50% 50%' : ''}">${ch === ' ' ? '' : ch}</span>`
const flaps9 = (t, n, s, c = '#f4ead8', flip = -1) => `<span style="display:inline-flex">${t.toUpperCase().padEnd(n, ' ').slice(0, n).split('').map((ch, i) => flap9(ch, s, c, i === flip)).join('')}</span>`
const lamp9 = (c, fs = 1) => `<i style="display:inline-block;width:${8 * fs}px;height:${8 * fs}px;border-radius:50%;background:${c};box-shadow:0 0 ${6 * fs}px ${c}"></i>`
const DEP = [['2:30', 'Therapy dogs', 'Library lawn', 4, 'BOARDING', '#ffc44d', 1], ['3:00', 'Rose sketch', 'Mission Gardens', 6, 'ON TIME', '#8fd18f', 1], ['3:30', 'Ceramics', 'Arts 104', 8, '2 SPOTS LEFT', '#ffc44d', 1], ['3:45', 'Board games', 'Benson 103', 3, 'ENDS LATE', '#8d857f', 0], ['8:00', 'Open night', 'Ricard', 6, 'TONIGHT', '#8d857f', 0]]
const drow9 = ([t, n, p, w, st, c, fit], i, s = 19, sel) => `<div style="padding:6px 12px;${sel ? 'background:rgba(255,196,77,.1);box-shadow:inset 3px 0 0 #ffc44d' : ''}"><div style="display:flex;gap:7px;${fit ? '' : 'opacity:.45'}">${flaps9(t, 4, s, '#ffc44d')}${flaps9(n, 12, s, '#f4ead8', i === 2 ? 9 : -1)}</div><div style="display:flex;align-items:center;gap:6px;margin-top:5px;font:600 9.5px var(--sans);letter-spacing:.06em;color:${fit ? '#f4ead8' : '#8d857f'}">${lamp9(c)}<span style="color:${c}">${st}</span><span style="opacity:.6">· ${p} · ${w} min walk</span></div></div>`
O9.Q5 = [
  P8('#1b1412', `<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 12px 0">${flaps9('Departures', 10, 21, '#f4ead8')}<span style="font:500 15px ${MONO};color:#ffc44d">2:10</span></div><div style="padding:6px 12px 0;font:600 9.5px var(--sans);letter-spacing:.1em;color:#8d857f">FROM BENSON · LIT ROWS FIT YOUR GAP</div><div style="margin-top:4px">${DEP.concat([['6:00', 'Dumplings', 'Benson patio', 2, 'NEXT GAP', '#8d857f', 0]]).map((d, i) => drow9(d, i, 19, i === 1)).join('')}</div><div style="position:absolute;left:12px;right:12px;bottom:84px">${B8('Board the 3:00', '#ffc44d', '#1b1412', 1, 1)}</div>`, { light: true, navDark: true }),
  D8('#1b1412', `<div style="position:absolute;left:36px;top:18px;right:36px;display:flex;justify-content:space-between;align-items:center">${flaps9('Departures', 10, 34, '#f4ead8')}<span style="font:600 12px var(--sans);letter-spacing:.14em;color:#8d857f">FROM BENSON · YOUR GAP 2:10 TO 4:40</span><span style="font:500 26px ${MONO};color:#ffc44d">2:10 PM</span></div>
    <div style="position:absolute;left:36px;top:76px;display:grid;grid-template-columns:104px 356px 240px 60px 1fr;gap:0 14px;width:928px;font:600 10px var(--sans);letter-spacing:.14em;color:#8d857f"><span>TIME</span><span>QUEST</span><span>WHERE</span><span>WALK</span><span>STATUS</span></div>
    <div style="position:absolute;left:28px;top:96px;width:944px">${DEP.concat([['6:00', 'Dumpling social', 'Benson patio', 2, 'NEXT GAP', '#8d857f', 0], ['7:00', 'Trivia night', 'The Bronco', 5, 'KAI IS GOING', '#8d857f', 0]]).map(([t, n, p, w, st, c, fit], i) => `<div style="display:grid;grid-template-columns:104px 356px 240px 60px 1fr;gap:0 14px;align-items:center;padding:9px 8px;${i === 1 ? 'background:rgba(255,196,77,.1);box-shadow:inset 3px 0 0 #ffc44d;' : ''}${fit ? '' : 'opacity:.5'}">${flaps9(t, 4, 28, '#ffc44d')}${flaps9(n, 17, 28, '#f4ead8', i === 2 ? 5 : -1)}${flaps9(p.replace('Mission ', ''), 11, 28, '#f4ead8')}${flaps9(String(w).padStart(2, ' '), 2, 28, '#f4ead8')}<span style="display:inline-flex;align-items:center;gap:8px;font:700 13px var(--sans);letter-spacing:.08em;color:${c}">${lamp9(c, 1.3)}${st}</span></div>`).join('')}</div>
    <div style="position:absolute;right:36px;bottom:20px;display:flex;align-items:center;gap:14px"><span style="font:500 13px var(--sans);color:#8d857f">Lit rows fit your gap. Dim rows end too late or start tonight.</span>${B8('Board the 3:00', '#ffc44d', '#1b1412', 1.05)}</div>`, 'Discover', 1),
  P8('#1b1412', `<div style="display:flex;justify-content:space-between;align-items:center;padding:4px 12px 0">${flaps9('Departures', 10, 21, '#f4ead8')}<span style="font:500 15px ${MONO};color:#ffc44d">2:10</span></div><div style="padding:6px 12px 0;font:600 9.5px var(--sans);letter-spacing:.1em;color:#8d857f">FROM BENSON · YOUR GAP IS 20 MIN</div><div style="margin-top:14px;padding:0 12px;display:grid;gap:6px">${flaps9('No departures', 16, 19, '#ff7a5c')}${flaps9('before 6:00 pm', 16, 19, '#ff7a5c', 7)}${flaps9('', 16, 19)}${flaps9('', 16, 19)}</div><div style="padding:16px 14px 0;font:500 12.5px/1.45 var(--sans);color:#c9c0ba">Nothing leaves and gets you back in twenty minutes. Six things depart after 6:00.</div><div style="position:absolute;left:12px;right:12px;bottom:84px">${B8('Show the 6:00 board', '#ffc44d', '#1b1412', 1, 1)}</div>`, { light: true, navDark: true })]

