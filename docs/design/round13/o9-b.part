
// ---------------- Q6 · Tonight's sky ----------------
// Every event tonight is a star. Left to right is 6 pm to midnight. Join the ones you want and that line is your night.
const roof9 = (W, H, s, ox, c = '#0e1226') => { const X = x => ox + x * s, Y = y => H - y * s
  const palm = (x, h) => `<path d="M${X(x)} ${Y(30)}Q${X(x + 3)} ${Y(h * .6)} ${X(x + 1)} ${Y(h)}" stroke="${c}" stroke-width="${3.4 * s}" fill="none"/>${[-70, -35, -8, 22, 50, 82].map(a => `<path d="M${X(x + 1)} ${Y(h)}q${Math.sin(a * Math.PI / 180) * 14 * s} ${-Math.cos(a * Math.PI / 180) * 12 * s - 2 * s} ${Math.sin(a * Math.PI / 180) * 26 * s} ${-Math.cos(a * Math.PI / 180) * 6 * s + 8 * s}" stroke="${c}" stroke-width="${2.6 * s}" fill="none" stroke-linecap="round"/>`).join('')}`
  return `<rect x="0" y="${Y(34)}" width="${W}" height="${34 * s + 2}" fill="${c}"/><path d="M${X(86)} ${Y(30)}V${Y(78)}L${X(126)} ${Y(112)}L${X(166)} ${Y(78)}V${Y(30)}Z" fill="${c}"/><rect x="${X(166)}" y="${Y(140)}" width="${32 * s}" height="${110 * s}" fill="${c}"/><path d="M${X(160)} ${Y(140)}L${X(182)} ${Y(166)}L${X(204)} ${Y(140)}Z" fill="${c}"/><path d="M${X(182)} ${Y(166)}V${Y(186)}M${X(175)} ${Y(178)}H${X(189)}" stroke="${c}" stroke-width="${2.6 * s}"/>
  <path d="M${X(176)} ${Y(104)}v${-14 * s}a${6 * s} ${6 * s} 0 0 1 ${12 * s} 0v${14 * s}Z" fill="#f2c56a" opacity=".9"/><circle cx="${X(126)}" cy="${Y(84)}" r="${7 * s}" fill="#f2c56a" opacity=".75"/>${[14, 40, 66, 214, 240, 266].map(x => `<path d="M${X(x - 8)} ${Y(4)}v${-14 * s}a${8 * s} ${8 * s} 0 0 1 ${16 * s} 0v${14 * s}Z" fill="#f2c56a" opacity=".28"/>`).join('')}${palm(46, 96)}${palm(236, 118)}` }
const STARS = [[8, 196, 5.2, 'Open night', '8:00', 1], [9.5, 78, 4.6, 'Jazz at the Bronco', '9:30', 1, 1], [11, 124, 4.4, 'Midnight pancakes', '11:00', 1], [7, 96, 3, 'Trivia', '7:00'], [8.5, 44, 2.6, 'Film club', '8:30'], [6.5, 170, 2.6, 'Climbing', '6:30'], [10.6, 178, 2.8, 'Stargazers', '10:30'], [11.6, 50, 2.4, 'Study jam', '11:30']]
const sky9 = (W, H, s, o = {}) => { const ox = o.ox ?? 0, tx = h => o.x0 + (h - 6) / 6 * o.xw, st = (o.stars || STARS).map(([h, y, r, n, t, p, f]) => [tx(h), y * s + (o.dy || 0), r * s, n, t, p, f]), picks = st.filter(a => a[5]).sort((a, b) => a[0] - b[0])
  let seed = 7; const rnd = () => (seed = (seed * 16807) % 2147483647) / 2147483647
  return `<div style="position:relative;width:${W}px;height:${H}px;overflow:hidden;background:linear-gradient(180deg,#121735 0,#2a2552 58%,#6a4160 100%)"><svg width="${W}" height="${H}" style="position:absolute;inset:0">
  ${Array.from({ length: o.dust || 70 }, () => `<circle cx="${(rnd() * W).toFixed(1)}" cy="${(rnd() * H * .8).toFixed(1)}" r="${(rnd() * .9 + .3).toFixed(2)}" fill="#fff" opacity="${(rnd() * .5 + .2).toFixed(2)}"/>`).join('')}
  ${[6, 8, 10, 12].map(h => `<line x1="${tx(h)}" x2="${tx(h)}" y1="${(o.top ?? 56) + 12}" y2="${H}" stroke="#fff" stroke-opacity=".1" stroke-dasharray="2 6"/><text x="${tx(h)}" y="${(o.top ?? 56) + 4}" text-anchor="middle" font-family="DM Mono,monospace" font-size="${9.5 * Math.min(s, 1.4)}" fill="#fff" fill-opacity=".6">${h === 12 ? 'midnight' : h + ' pm'}</text>`).join('')}
  ${o.cloud ? '' : `<polyline points="${picks.map(a => a[0].toFixed(1) + ',' + a[1].toFixed(1)).join(' ')}" fill="none" stroke="#ffd36b" stroke-width="${1.5 * s}" stroke-linecap="round" stroke-dasharray="600" style="animation:q9draw 2.4s ease-out both"/>`}
  ${(o.extra || '')}
  ${st.map(([x, y, r, n, t, p, f], i) => `<g opacity="${o.cloud ? .25 : 1}"><circle cx="${x}" cy="${y}" r="${r * 2.6}" fill="${p ? '#ffd36b' : '#fff'}" opacity="${p ? .22 : .1}"/><circle cx="${x}" cy="${y}" r="${r}" fill="${p ? '#ffd36b' : '#fff'}" style="animation:q9twinkle ${2 + i * .37}s ease-in-out infinite"/>${f ? `<circle cx="${x}" cy="${y}" r="${r * 2.1}" fill="none" stroke="#f08a6b" stroke-width="${1.2 * s}"/>` : ''}</g>`).join('')}
  ${roof9(W, H, o.rs ?? s, ox)}</svg>
  ${o.cloud ? [[-30, 96, 190, 62], [120, 70, 200, 70], [40, 150, 240, 66], [200, 150, 160, 56]].map(([x, y, w, h], i) => `<span style="position:absolute;left:${x * s + (o.cx || 0)}px;top:${y * s}px;width:${w * s}px;height:${h * s}px;border-radius:50%;background:rgba(214,208,226,.34);filter:blur(${14 * s}px);animation:q9drift ${9 + i * 2}s ease-in-out infinite"></span>`).join('') : st.map(([x, y, r, n, t, p, f]) => p ? `<div style="position:absolute;${x > W * .62 ? `right:${W - x + 10 * s}px;text-align:right` : `left:${x + 10 * s}px`};top:${y - 9 * s}px;white-space:nowrap;color:#fff"><div style="font:400 ${15 * s}px/1 var(--serif)">${n}</div><div style="font:500 ${9.5 * s}px ${MONO};opacity:.7;margin-top:${2 * s}px">${t}${f ? ' · Kai' : ''}</div></div>` : `<div style="position:absolute;left:${x + 7 * s}px;top:${y - 5 * s}px;font:500 ${8.5 * s}px ${MONO};color:rgba(255,255,255,.5);white-space:nowrap">${o.names ? n + ' ' + t : t}</div>`).join('')}</div>` }
const night9 = (t, sub, btn, fs = 1) => `<div style="background:rgba(255,255,255,.08);border:1px solid rgba(255,255,255,.14);border-radius:${20 * fs}px;padding:${14 * fs}px ${16 * fs}px;color:#fff"><div style="font:400 ${27 * fs}px/1 var(--serif)">${t}</div><div style="font:500 ${11.5 * fs}px/1.4 var(--sans);opacity:.75;margin-top:${5 * fs}px">${sub}</div><div style="margin-top:${12 * fs}px">${B8(btn, '#ffd36b', '#121735', .9 * fs, 1, 0)}</div></div>`
O9.Q6 = [
  P8('#0e1226', `<div style="position:absolute;left:0;top:-44px">${sky9(280, 356, .86, { x0: 24, xw: 232, dy: 34, rs: .82, ox: 26 })}</div><div style="position:absolute;left:12px;right:12px;top:322px">${night9('The Night Owl', '3 stars · 8:00 to 11:45 · 14 minutes of walking', 'Keep this night')}</div>`, { light: true, navDark: true }),
  D8('#0e1226', `<div style="position:absolute;left:0;top:0">${sky9(1000, 569, 1.55, { x0: 80, xw: 840, ox: 560, rs: 1.5, top: 26, dust: 160, names: 1, stars: STARS.concat([[7.6, 200, 2.6, 'Open mic', '7:30'], [9, 190, 2.4, 'Board games', '9:00'], [10.6, 44, 2.6, 'Night market', '10:30']]), extra: `<polyline points="${[[80 + 1 / 6 * 840, 88 * 1.55], [80 + 3.5 / 6 * 840, 70 * 1.55], [80 + 4.6 / 6 * 840, 44 * 1.55]].map(p => p.join(',')).join(' ')}" fill="none" stroke="#f08a6b" stroke-width="2" stroke-dasharray="3 7" stroke-linecap="round"/>` })}</div><div style="position:absolute;left:36px;bottom:28px;width:330px">${night9('The Night Owl', '3 stars · 8:00 to 11:45 · 14 minutes of walking. Kai’s night, the dotted line, crosses yours at Jazz.', 'Keep this night', 1.15)}</div>`, 'Discover', 1),
  P8('#0e1226', `<div style="position:absolute;left:0;top:-44px">${sky9(280, 356, .86, { x0: 24, xw: 232, dy: 34, rs: .82, ox: 26, cloud: 1 })}</div><div style="position:absolute;left:12px;right:12px;top:322px">${night9('Clouded over', 'Nothing’s on tonight after 7:00. Tomorrow’s sky has seven stars, and Kai already picked two.', 'Look at tomorrow')}</div>`, { light: true, navDark: true })]

// ---------------- Q7 · Rings of minutes ----------------
// You are the centre. Each ring is a walk of 2, 5 or 10 minutes. A dot sits in its real direction, at its real walking time.
const NEAR = [[38, 6, 'Rose sketch', 'in 50', 1], [-62, 5, 'Therapy dogs', 'in 20'], [150, 8, 'Ceramics', 'in 80'], [-128, 3.4, 'Bell tower', 'open now'], [112, 9.2, 'Fountain', 'in 110']]
const rings9 = (R, fs, items, o = {}) => { const C = R + 4, pos = (a, m) => [C + Math.sin(a * Math.PI / 180) * m / 10 * R, C - Math.cos(a * Math.PI / 180) * m / 10 * R], line = 'rgba(255,255,255,.42)'
  return `<div style="position:relative;width:${C * 2}px;height:${C * 2}px"><div style="position:absolute;left:4px;top:4px;width:${R * 2}px;height:${R * 2}px;border-radius:50%;background:conic-gradient(from 0deg,rgba(255,255,255,.2),rgba(255,255,255,0) 22%,rgba(255,255,255,0));animation:q9sweep 7s linear infinite"></div>
  <svg width="${C * 2}" height="${C * 2}" style="position:absolute;inset:0;overflow:visible">${[2, 5, 10].map(m => `<circle cx="${C}" cy="${C}" r="${m / 10 * R}" fill="${m === 10 ? 'rgba(255,255,255,.05)' : 'none'}" stroke="${line}" stroke-width="${1.2 * fs}" ${m === 10 ? '' : 'stroke-dasharray="3 5"'}/>`).join('')}<path d="M${C} ${C - R - 8 * fs}l${-5 * fs} ${9 * fs}h${10 * fs}Z" fill="#fff"/>
  ${items.filter(i => i[4]).map(([a, m]) => { const p = pos(a, m); return `<line x1="${C}" y1="${C}" x2="${p[0]}" y2="${p[1]}" stroke="${C8.gold}" stroke-width="${2.4 * fs}" stroke-dasharray="${2 * fs} ${6 * fs}" stroke-linecap="round"/>` }).join('')}
  ${(o.out || []).map(([a]) => { const p = pos(a, 10.6), q = pos(a, 11.8); return `<line x1="${p[0]}" y1="${p[1]}" x2="${q[0]}" y2="${q[1]}" stroke="#fff" stroke-width="${2 * fs}" stroke-linecap="round" opacity=".7"/>` }).join('')}</svg>
  ${[2, 5, 10].map(m => `<span style="position:absolute;left:${C - 14 * fs}px;top:${C + m / 10 * R - 12 * fs}px;width:${28 * fs}px;text-align:center;white-space:nowrap;font:500 ${7.5 * fs}px ${MONO};color:rgba(255,255,255,.7);background:#3d4f43">${m} min</span>`).join('')}
  <span style="position:absolute;left:${C - 9 * fs}px;top:${C - 9 * fs}px;width:${18 * fs}px;height:${18 * fs}px;border-radius:50%;background:${C8.gold};box-shadow:0 0 0 ${3 * fs}px ${C8.ink}"></span>
  ${items.map(([a, m, n, t, sel]) => { const p = pos(a, m), left = p[0] < C || p[0] > C * 1.25
    return `<span style="position:absolute;left:${p[0] - (sel ? 8 : 5.5) * fs}px;top:${p[1] - (sel ? 8 : 5.5) * fs}px;width:${(sel ? 16 : 11) * fs}px;height:${(sel ? 16 : 11) * fs}px;border-radius:50%;background:${sel ? C8.gold : '#fff'};box-shadow:0 0 0 ${2 * fs}px ${C8.ink}"></span><span style="position:absolute;${left ? `right:${C * 2 - p[0] + 12 * fs}px;text-align:right` : `left:${p[0] + 12 * fs}px`};top:${p[1] - 13 * fs}px;white-space:nowrap;color:#fff"><span style="font:400 ${(sel ? 17 : 14) * fs}px/1 var(--serif);display:block">${n}</span><span style="font:500 ${8.5 * fs}px ${MONO};opacity:.75">${m} min · ${t}</span></span>` }).join('')}
  ${(o.out || []).map(([a, n]) => { const p = pos(a, 12.4), left = p[0] > C; return `<span style="position:absolute;${left ? `right:${C * 2 - p[0] - 30 * fs}px;text-align:right` : `left:${p[0] - 30 * fs}px`};top:${p[1] - (p[1] < C ? 22 : -4) * fs}px;white-space:nowrap;font:500 ${8.5 * fs}px ${MONO};color:rgba(255,255,255,.8)">${n}</span>` }).join('')}</div>` }
const go9 = (t, sub, btn, fs = 1, ghost) => `<div style="display:flex;align-items:center;gap:${12 * fs}px;background:${C8.paper};border-radius:${20 * fs}px;padding:${12 * fs}px ${12 * fs}px ${12 * fs}px ${16 * fs}px"><div style="flex:1"><div style="font:400 ${21 * fs}px/1.05 var(--serif)">${t}</div><div style="font:500 ${11 * fs}px var(--sans);color:${C8.muted};margin-top:${3 * fs}px">${sub}</div></div>${B8(btn, ghost ? 'none' : C8.red, ghost ? C8.ink : '#fff', .84 * fs, 0, 0)}</div>`
O9.Q7 = [
  P8('#3d4f43', `<div style="text-align:center;padding-top:6px;font:700 10.5px var(--sans);letter-spacing:.14em;color:#fff">WITHIN A 10 MINUTE WALK · 2:10 PM</div><div style="position:absolute;left:11px;top:44px">${rings9(125, 1, NEAR)}</div><div style="position:absolute;left:12px;right:12px;bottom:80px">${go9('Rose sketch', '6 min, up and to the right · starts in 50', 'Walk me')}</div>`, { light: true, navDark: true }),
  D8('#3d4f43', `<div style="position:absolute;left:60px;top:40px">${rings9(236, 1.5, NEAR)}</div><div style="position:absolute;left:640px;top:44px;width:310px"><div style="font:700 12px var(--sans);letter-spacing:.14em;color:#fff">NEAREST FIRST · FROM BENSON, 2:10 PM</div>${[...NEAR].sort((a, b) => a[1] - b[1]).map(([a, m, n, t, sel]) => `<div style="display:flex;align-items:center;gap:14px;margin-top:12px;padding:12px 14px;border-radius:16px;${sel ? `background:${C8.paper};color:${C8.ink}` : 'background:rgba(255,255,255,.08);color:#fff'}">${N8(String(m), 40, sel ? C8.ink : '#fff')}<div style="flex:1"><div style="font:400 20px/1 var(--serif)">${n}</div><div style="font:500 11px var(--sans);opacity:.7;margin-top:3px">min walk · ${t}</div></div>${sel ? B8('Walk me', C8.red, '#fff', .8, 0, 0) : ''}</div>`).join('')}</div>`, 'Discover', 1),
  P8('#3d4f43', `<div style="text-align:center;padding-top:6px;font:700 10.5px var(--sans);letter-spacing:.14em;color:#fff">WITHIN A 10 MINUTE WALK · 9:40 PM</div><div style="position:absolute;left:11px;top:44px">${rings9(125, 1, [], { out: [[52, ''], [-110, '']] })}</div><div style="position:absolute;left:12px;right:12px;bottom:80px">${go9('Nothing inside the rings', 'Closest: pancakes at 12 min, Open night at 14.', 'Widen to 15', 1, 1)}</div>`, { light: true, navDark: true })]

// ---------------- Q8 · The someday bag ----------------
const BAG = [['picnic', 'Quad picnic', 1, 3], ['bike', 'Reservoir ride', 0, 2], ['camera', 'Photo walk', 1, 0], ['bottle', 'Beach day', 0, 4], ['record', 'Vinyl night', 0, 0], ['lamp', 'Essay club', 0, 1]]
const bslot9 = (it, cw, fs, sel) => it ? `<div style="position:relative;width:${cw}px;height:${cw}px;border-radius:${18 * fs}px;background:${it[2] ? '#ffe7a8' : C8.paper};box-shadow:inset 0 0 0 ${(sel ? 3.4 : 2) * fs}px ${C8.ink},inset 0 ${-5 * fs}px 0 rgba(48,36,33,.08)${sel ? `,0 0 0 ${4 * fs}px #fff` : ''};display:grid;place-content:center">${img9(it[0], cw * .76)}${it[2] ? `<span style="position:absolute;left:${6 * fs}px;top:${6 * fs}px;padding:${2 * fs}px ${6 * fs}px;border-radius:${5 * fs}px;background:${C8.ink};color:${C8.gold};font:700 ${7.5 * fs}px var(--sans);letter-spacing:.1em">READY</span>` : ''}${it[3] ? `<span style="position:absolute;right:${-5 * fs}px;bottom:${-5 * fs}px;min-width:${20 * fs}px;height:${20 * fs}px;border-radius:${10 * fs}px;background:${C8.red};color:#fff;display:grid;place-content:center;font:700 ${10 * fs}px var(--sans);box-shadow:0 0 0 ${2 * fs}px ${C8.terra}">${it[3]}</span>` : ''}</div>` : `<div style="width:${cw}px;height:${cw}px;border-radius:${18 * fs}px;border:${2 * fs}px dashed rgba(255,255,255,.5);box-sizing:border-box"></div>`
const need9 = (ok, t, fs = 1) => `<div style="display:flex;align-items:center;gap:${9 * fs}px;font:500 ${12.5 * fs}px/1.25 var(--sans)"><span style="width:${18 * fs}px;height:${18 * fs}px;border-radius:50%;flex:none;display:grid;place-content:center;${ok ? `background:${C8.gold};color:${C8.ink}` : 'border:1.6px dashed rgba(255,255,255,.6)'}">${ok ? I6('check', 11 * fs) : ''}</span>${t}</div>`
const bagd9 = (fs = 1) => `<div style="background:${C8.night};color:#fff;border-radius:${22 * fs}px;padding:${16 * fs}px"><div style="font:400 ${26 * fs}px/1 var(--serif)">Quad picnic</div><div style="font:500 ${11 * fs}px var(--sans);opacity:.7;margin-top:${4 * fs}px">Stashed Oct 2. Everything it needs lines up Saturday.</div><div style="display:grid;gap:${7 * fs}px;margin-top:${12 * fs}px">${need9(1, 'A dry afternoon: Saturday, 72°', fs)}${need9(1, 'Two friends free: Kai and Maya, 1 to 4', fs)}${need9(1, 'Two hours of your own', fs)}</div><div style="margin-top:${14 * fs}px">${B8('Make it Saturday’s quest', C8.gold, C8.ink, .9 * fs, 1)}</div></div>`
const bagh9 = (t, fs = 1) => `<div style="text-align:center;font:700 ${10.5 * fs}px var(--sans);letter-spacing:.14em;color:#fff">${t}</div>`
O9.Q8 = [
  P8(C8.terra, `<div style="padding-top:6px">${bagh9('SOMEDAY BAG · 6 OF 9 · 2 READY')}</div><div style="display:grid;grid-template-columns:repeat(3,76px);gap:10px;justify-content:center;margin-top:14px">${[...BAG, null, null, null].map((b, i) => bslot9(b, 76, 1, i === 0)).join('')}</div><div style="position:absolute;left:12px;right:12px;bottom:14px">${bagd9()}</div>`, { light: true, nav: null }),
  D8(C8.terra, `<div style="position:absolute;left:56px;top:22px">${bagh9('SOMEDAY BAG · 6 OF 12 · 2 READY', 1.2).replace('text-align:center', 'text-align:left')}</div><div style="position:absolute;left:56px;top:64px;display:grid;grid-template-columns:repeat(4,116px);gap:16px">${[...BAG, null, null, null, null, null, null].map((b, i) => bslot9(b, 116, 1.4, i === 0)).join('')}</div><div style="position:absolute;left:56px;top:470px;width:500px;font:500 13.5px/1.5 var(--sans);color:rgba(255,255,255,.85)">Stash anything you can’t do today. Each idea remembers what it needs. Gold means every need is met this week. The red number is how many friends stashed it too.</div><div style="position:absolute;left:620px;top:40px;width:330px"><div style="display:grid;justify-content:center;margin-bottom:-18px;position:relative;z-index:1">${img9('picnic', 230)}</div>${bagd9(1.2)}</div>`, 'My Schedule', 1),
  P8(C8.terra, `<div style="padding-top:6px">${bagh9('SOMEDAY BAG · EMPTY')}</div><div style="position:relative;display:grid;grid-template-columns:repeat(3,76px);gap:10px;justify-content:center;margin-top:14px">${Array.from({ length: 9 }, () => bslot9(null, 76, 1)).join('')}<div style="position:absolute;left:112px;top:92px">${blob('round', '#f6d9a8', 56, 'sleepy', -6)}</div></div><div style="position:absolute;left:12px;right:12px;bottom:14px"><div style="background:${C8.night};color:#fff;border-radius:22px;padding:16px"><div style="font:400 26px/1 var(--serif)">Nothing stashed yet</div><div style="font:500 12px/1.45 var(--sans);opacity:.75;margin-top:6px">See something you can’t do this week? Hold its card and drop it in here. It’ll tell you when the day is right.</div><div style="margin-top:14px">${B8('Find something to stash', C8.gold, C8.ink, .9, 1)}</div></div></div>`, { light: true, nav: null })]

// ---------------- Q9 · Quest complete ----------------
const stamp9 = (s, top, mid, c = C8.maroon, o = {}) => { const id = 'st9' + (stamp9.n = (stamp9.n || 0) + 1)
  return `<svg width="${s}" height="${s}" viewBox="0 0 200 200" style="display:block;transform:rotate(${o.rot ?? -10}deg);${o.dash ? '' : 'filter:url(#rough);'}opacity:${o.op ?? .92}"><defs><path id="${id}" d="M100 100m-74 0a74 74 0 1 1 148 0a74 74 0 1 1 -148 0"/></defs><circle cx="100" cy="100" r="94" fill="none" stroke="${c}" stroke-width="5" ${o.dash ? 'stroke-dasharray="6 7"' : ''}/><circle cx="100" cy="100" r="60" fill="none" stroke="${c}" stroke-width="2.4" ${o.dash ? 'stroke-dasharray="4 6"' : ''}/><text font-family="Instrument Sans,sans-serif" font-weight="700" font-size="15.5" letter-spacing="3.2" fill="${c}"><textPath href="#${id}">${top}</textPath></text>${mid}</svg>` }
const xp9 = (n, of, fs = 1) => `<div style="display:flex;gap:${4 * fs}px">${Array.from({ length: of }, (_, i) => `<i style="flex:1;height:${10 * fs}px;border-radius:${5 * fs}px;background:${i < n ? C8.red : 'rgba(48,36,33,.14)'}"></i>`).join('')}</div>`
const loot9 = (fs = 1) => `<div style="display:flex;align-items:center;gap:${12 * fs}px;background:#fff;border-radius:${20 * fs}px;padding:${10 * fs}px ${14 * fs}px ${10 * fs}px ${10 * fs}px;box-shadow:0 8px 18px rgba(117,23,40,.12)">${img9('ceramics', 74 * fs)}<div style="flex:1"><div style="font:400 ${21 * fs}px/1.05 var(--serif)">Ceramics open studio</div><div style="font:500 ${11 * fs}px var(--sans);color:${C8.muted};margin-top:${3 * fs}px">An hour, with Kai · now on your shelf</div></div></div><div style="margin-top:${14 * fs}px"><div style="display:flex;justify-content:space-between;font:700 ${11 * fs}px var(--sans);margin-bottom:${6 * fs}px"><span>Art Club regular</span><span>2 of 3</span></div>${xp9(2, 3, fs)}<div style="font:500 ${11 * fs}px var(--sans);color:${C8.muted};margin-top:${6 * fs}px">One more visit and you get sign-ups a day early.</div></div>`
const done9 = (c = C8.maroon) => `<path d="M72 102l20 20 38-44" fill="none" stroke="${c}" stroke-width="11" stroke-linecap="round" stroke-linejoin="round"/>`
O9.Q9 = [
  P8(C8.pink, `<div style="position:relative;height:222px">${at(40, 6, stamp9(200, 'QUEST COMPLETE · WED NOV 11 · SIDEQUEST · ', done9()))}${at(20, 20, blob('star', C8.gold, 34, 'wow', -14))}${at(228, 44, blob('round', C8.sage, 28, 'happy', 10))}${at(222, 168, blob('cloud', '#c9d7c3', 32, 'happy', -6))}${at(26, 176, blob('tri', C8.gold, 26, 'happy', 16))}</div><div style="padding:6px 16px 0">${loot9()}</div><div style="position:absolute;left:16px;right:16px;bottom:18px;display:flex;gap:8px"><span style="flex:1">${B8('Add a photo', C8.ink, '#fff', 1, 1, 0)}</span>${B8('Done', 'none', C8.ink, 1, 0, 0)}</div>`, { nav: null }),
  D8(C8.pink, `${at(60, 20, stamp9(250, 'QUEST COMPLETE · WED NOV 11 · SIDEQUEST · ', done9()))}${at(40, 30, blob('star', C8.gold, 44, 'wow', -14))}${at(300, 60, blob('round', C8.sage, 36, 'happy', 10))}<div style="position:absolute;left:40px;top:290px;width:330px">${loot9(1.15)}<div style="display:flex;gap:10px;margin-top:18px">${B8('Add a photo', C8.ink, '#fff', 1, 0, 0)}${B8('Done', 'none', C8.ink, 1, 0, 0)}</div></div>
    <div style="position:absolute;left:440px;top:26px;width:520px"><div style="font:700 12px var(--sans);letter-spacing:.14em;color:${C8.maroon}">YOUR SHELF · 7 QUESTS THIS QUARTER</div>${[[['ceramics', 'Ceramics', 'today'], ['cup', 'Boba run', 'Nov 6'], ['camera', 'Photo walk', 'Nov 2'], ['bell', 'Bell tower', 'Oct 28']], [['record', 'Vinyl night', 'Oct 21'], ['dome', 'Open night', 'Oct 16'], ['picnic', 'Quad picnic', 'Oct 4'], null]].map(row => `<div style="display:grid;grid-template-columns:repeat(4,1fr);align-items:end;height:178px;margin-top:20px;padding:0 10px;border-bottom:10px solid #6a4631;box-shadow:0 12px 14px -8px rgba(60,35,10,.35)">${row.map(it => it ? `<div style="display:grid;justify-items:center;padding-bottom:6px">${img9(it[0], it[0] === 'cup' || it[0] === 'bell' ? 62 : 104)}<div style="font:400 15px var(--serif);margin-top:6px">${it[1]}</div><div style="font:500 10px ${MONO};color:${C8.muted}">${it[2]}</div></div>` : `<div style="display:grid;justify-items:center;padding-bottom:10px"><div style="width:84px;height:84px;border-radius:16px;border:2px dashed rgba(117,23,40,.35)"></div><div style="font:500 10px ${MONO};color:${C8.muted};margin-top:8px">next one</div></div>`).join('')}</div>`).join('')}</div>`, 'My Schedule'),
  P8(C8.pink, `<div style="position:relative;height:222px">${at(40, 6, stamp9(200, 'NOT THIS TIME · WED NOV 11 · SIDEQUEST · ', `<path d="M76 100h48" stroke="#8d857f" stroke-width="10" stroke-linecap="round"/>`, '#8d857f', { dash: 1, rot: 6, op: .8 }))}${at(222, 168, blob('cloud', '#c9d7c3', 34, 'sleepy', -6))}</div><div style="padding:6px 20px 0"><div style="font:400 28px/1.05 var(--serif)">You didn’t make it to Ceramics, and that’s allowed.</div><div style="font:500 12.5px/1.45 var(--sans);color:${C8.muted};margin-top:8px">Nothing is lost. Your streak counts weeks, and this week already has one.</div></div><div style="position:absolute;left:16px;right:16px;bottom:18px;display:grid;gap:8px">${B8('Pin it for next Thursday', C8.ink, '#fff', 1, 1, 0)}${B8('Let it go', 'none', C8.ink, 1, 1, 0)}</div>`, { nav: null })]

var SAY9 = { Q1: 'a moment with nothing to offer', Q2: 'a day with nothing pinned', Q3: 'a gap no line can make', Q4: 'a balance of 20 minutes', Q5: 'a gap with no departures', Q6: 'a night with nothing on', Q7: 'a night with nothing close', Q8: 'day one, an empty bag', Q9: 'a quest you skipped' }
SEC9.push({ h: 'It’s called SideQuest', say: 'Four ideas that take the name seriously. A side quest is something a game offers while you’re on your way somewhere else.', o: [
  ['Q1', 'A stranger has a quest for you', 'An event doesn’t sit in a list. A character walks up with a “!” over its head and asks, in a dialogue box, with three answers. Your free time is the bar at the top, like health in a game. Why it should work: one question with three answers is the smallest decision an app can ask for (Hick’s law), and it copies a pattern every game player already knows (Jakob’s law).'],
  ['Q2', 'The quest board, with tear-off tabs', 'A cork board of pinned notices. Signing up is tearing off a tab, and the tabs left on a notice are the spots left. A notice with no tabs is open to anyone. Posting is “Pin a notice”. Why: the control and the status are the same object, so you can see how full something is without reading a number.'],
  ['Q8', 'The someday bag', 'Someday ideas as items in a bag, like a game inventory. Each item remembers what it needs: weather, friends, hours. It turns gold in the week all of those line up. The red number is friends who stashed the same thing. Why: it turns “we should do that sometime” into something that tells you when.'],
  ['Q9', 'Quest complete', 'After you go, you get a stamp, the thing lands on your shelf, and a bar shows how close you are to being a regular. Skipping costs nothing and says so. Why: a visible finish makes you likelier to come back (goal-gradient effect), and a guilt-free miss keeps people from quitting.']] })
SEC9.push({ h: 'Borrowed machines', say: 'Three objects everyone already knows how to read, pointed at your free time.', o: [
  ['Q4', 'Minutes are money', 'A vending machine. Your free gap is the balance, and every event has a price in minutes: its length plus the walk both ways. Anything you can’t afford is greyed out. Your plan prints as a receipt, with change. Why: “does it fit?” becomes “can I afford it?”, a sum people do every day, and the receipt shows the math.'],
  ['Q5', 'Departures', 'A split-flap board like an airport’s. Rows that fit your gap are lit, the rest are dim, and each row has a status: boarding, on time, 2 spots left. Why: it is a table, the easiest thing to scan, wearing a costume people find exciting. It is also the best desktop screen here.'],
  ['Q3', 'Main line, side quests', 'Your day as a transit map. Classes are stations on the main line. A side quest is a branch that leaves and has to rejoin before the next station. The dotted parts are the walk. On desktop, a friend’s line that shares a station with yours is a transfer. Why: “will I be back in time?” is visible as a line that rejoins, or one that doesn’t.']] })
SEC9.push({ h: 'Maps of now', say: 'Two pictures of what’s around you, in space and in time.', o: [
  ['Q7', 'Rings of minutes', 'You’re the dot in the middle. Rings are 2, 5 and 10 minute walks, and every event sits in its real direction at its real walking time. Why: distance is the first thing you ask when you’re already outside, and position on a ring answers it without a number to read.'],
  ['Q6', 'Tonight’s sky', 'Tonight’s events as stars over the Mission roof, earlier on the left and later on the right. Join the ones you want and the line is your night. It gets a name. A ring means a friend is going. Why: planning an evening is choosing a path through time, and a line you draw is a plan you made.']] })
