
// =================== ROUND 10 (review: Round 14) · things you can hold ===================
// From the Nov 16 references: two-colour brand kits with thick-outline doodles, packaging with bracket labels,
// stationery that turns software into objects, and a task app whose form is a little machine.
// Rule for this round: every screen runs on data the app already stores, unless its caption says otherwise.
const SEC10 = [], O10 = {}
const X10 = { paper: '#fbf6ed', ink: '#302421', butter: '#fff1a6', butterD: '#f4d94f', gold: '#e8aa24', blue: '#2f7df6', blueT: '#d6e6ff', red: '#a32035', redT: '#f6dcd9', sage: '#506252', sageT: '#dde8d8', grey: '#ecebe8', kraft: '#d9a066', esp: '#2a1d17', muted: '#6f6660' }
const MO10 = "'DM Mono',ui-monospace,Menlo,monospace"
let wn10 = 0
const BG10 = "'Bricolage Grotesque','Instrument Sans',sans-serif"
const sf10 = (t, s, ex = '') => `<div style="font:800 ${s * .8}px/1.02 ${BG10};font-stretch:80%;letter-spacing:-.03em;${ex}">${t}</div>`
const sn10 = (t, s, w = 600, ex = '') => `<div style="font:${w} ${s}px/1.32 ${BG10};${ex}">${t}</div>`
const bk10 = (t, s = 9, ex = '') => `<span style="font:500 ${s}px/1 ${MO10};letter-spacing:.05em;text-transform:uppercase;white-space:nowrap;${ex}">( ${t} )</span>`
const mo10 = (t, s = 10, ex = '') => `<span style="font:500 ${s}px/1.25 ${MO10};letter-spacing:.03em;${ex}">${t}</span>`
const al10 = (t, ex = '') => `<span style="display:inline-block;font:700 12px/1.2 ${BG10};border-bottom:1.600px solid currentColor;padding-bottom:2px;${ex}">${t} &rarr;</span>`
// real objects: open-source 3D renders and cut-outs from our own campus photos
const OB10 = { dog: 'dogp', rose: 'rosep', mug: 'coffeep', pot: 'vase', dice: 'dicep', bowl: 'dumplings', mic: 'micp', star: 'telescope', ball: 'volleyball', bagel: 'bagel' }
const obr10 = (n, w, h, ex = '') => `<span class="x-${n}" style="display:inline-block;width:${w}px;height:${h}px;flex:none;${ex}"></span>`
const ob10 = (n, s, ex = '') => `<span class="x-${n}" style="display:inline-block;width:${s}px;height:${s}px;flex:none;${ex}"></span>`
const ev10 = (k, s, ex = '') => OB10[k] ? ob10(OB10[k], s, ex) : dd10(k, s, FC10[k] || X10.butter, { ex })
const spark10 = (s, c = X10.ink, ex = '') => hl10(s, s, `M${s * .5} ${s * .05}V${s * .32}M${s * .95} ${s * .5}H${s * .68}M${s * .86} ${s * .14}L${s * .68} ${s * .32}`, c, Math.max(2, s * .09), ex)
// doodles: thick ink outline, one flat fill, a wobble filter so no line is ruler-straight
const DD10 = {
  mug: (f, g) => `<path d="M16 24h26v18a10 10 0 0 1-10 10h-6a10 10 0 0 1-10-10z" fill="${f}"/><path d="M42 29h4a5.500 5.500 0 0 1 0 11h-4M24 16c-2-3 2-5 0-8M33 16c-2-3 2-5 0-8M11 57h36" fill="none"/>`,
  dog: (f, g) => `<path d="M19 24c-9-3-12 9-7 18l7-5z" fill="${f}"/><path d="M45 24c9-3 12 9 7 18l-7-5z" fill="${f}"/><path d="M18 26c0-9 28-9 28 0v13c0 9-6 15-14 15s-14-6-14-15z" fill="${g}"/><path d="M28.500 39h7l-3.500 4z" fill="${X10.ink}"/><path d="M32 43v3c-2 3-5 2-6 0M32 46c2 3 5 2 6 0M26 32v2M38 32v2" fill="none"/>`,
  rose: (f, g) => `<path d="M32 40v18" fill="none"/><path d="M32 50c7-7 13-3 13-3s-5 9-13 3z" fill="${X10.sage}"/><circle cx="32" cy="26" r="15" fill="${f}"/><path d="M32 26c3-5 9 1 4 5-6 4-12-3-7-9 5-5 14-1 13 7" fill="none"/>`,
  mic: (f, g) => `<path d="M30 31l19 20-5 5-21-18z" fill="${g}"/><circle cx="23" cy="23" r="12" fill="${f}"/><path d="M14 19h18M13 26h20M19 12v22M27 12v22" fill="none" stroke-width="1.600"/>`,
  ball: (f, g) => `<circle cx="32" cy="32" r="22" fill="${f}"/><path d="M11 28c13 8 29 8 42 0M22 12c-6 14-4 30 6 41M42 12c6 14 4 30-6 41" fill="none" stroke-width="2"/>`,
  cam: (f, g) => `<path d="M22 22l3-7h14l3 7" fill="${g}"/><rect x="8" y="22" width="48" height="30" rx="6" fill="${f}"/><circle cx="32" cy="37" r="10" fill="${g}"/><circle cx="32" cy="37" r="4" fill="${X10.ink}"/><path d="M46 29h4" fill="none"/>`,
  bell: (f, g) => `<path d="M27 12a5 5 0 0 1 10 0" fill="none"/><path d="M32 12c-11 0-15 9-15 19v9l-7 8h44l-7-8v-9c0-10-4-19-15-19z" fill="${f}"/><circle cx="32" cy="52" r="4.500" fill="${g}"/><path d="M18 40h28" fill="none" stroke-width="2"/>`,
  pot: (f, g) => `<path d="M24 10h16v7c9 5 12 13 12 20 0 9-7 17-16 17h-8c-9 0-16-8-16-17 0-7 3-15 12-20z" fill="${f}"/><path d="M22 10h20M14 32c12 4 24 4 36 0M13 39c12 4 26 4 38 0" fill="none" stroke-width="2"/>`,
  star: (f, g) => `<path d="M32 7l6 15 16 1-12 10 4 16-14-9-14 9 4-16L10 23l16-1z" fill="${f}"/>`,
  bowl: (f, g) => `<path d="M37 8l-7 24M47 11l-11 21" fill="none"/><path d="M8 32h48c0 13-10 22-24 22S8 45 8 32z" fill="${f}"/><path d="M22 58h20" fill="none"/>`,
  dice: (f, g) => `<rect x="12" y="12" width="40" height="40" rx="9" fill="${f}" transform="rotate(-8 32 32)"/><circle cx="23" cy="24" r="2.600" fill="${X10.ink}"/><circle cx="32" cy="32" r="2.600" fill="${X10.ink}"/><circle cx="41" cy="40" r="2.600" fill="${X10.ink}"/>`,
  ticket: (f, g) => `<path d="M6 20h52v8a5 5 0 0 0 0 10v8H6v-8a5 5 0 0 0 0-10z" fill="${f}"/><path d="M24 23v22" fill="none" stroke-dasharray="3 4" stroke-width="2"/>`,
  plate: (f, g) => `<ellipse cx="32" cy="36" rx="25" ry="12" fill="${g}"/><ellipse cx="32" cy="35" rx="14" ry="6" fill="${f}"/>`,
  plug: (f, g) => `<path d="M3 46c10 0 8-16 17-16" fill="none"/><rect x="20" y="22" width="13" height="16" rx="4" fill="${f}"/><path d="M33 26h6M33 34h6" fill="none"/><rect x="47" y="20" width="9" height="20" rx="3" fill="${g}"/><path d="M56 30c6 0 2 16 6 16" fill="none"/>`,
  check: (f, g) => `<path d="M13 34l12 12 26-28" fill="none" stroke-width="6.500"/>`,
  folder: (f, g) => `<path d="M6 16h18l5 7h29v29H6z" fill="${f}"/>`,
  tag: (f, g) => `<path d="M22 8h20l8 9v39H14V17z" fill="${f}"/><circle cx="32" cy="19" r="3" fill="${g}"/>`,
  line: (f, g) => `<path d="M4 14c18 6 38 6 56 0" fill="none"/><path d="M14 21h13v21H14zM37 22h13v28H37z" fill="${f}"/>`,
  device: (f, g) => `<rect x="18" y="8" width="28" height="48" rx="6" fill="${f}"/><path d="M28 48h8" fill="none"/>`,
  eye: (f, g) => `<path d="M6 32c10-14 42-14 52 0-10 14-42 14-52 0z" fill="${g}"/><circle cx="32" cy="32" r="8" fill="${f}"/><path d="M10 52L54 12" fill="none"/>`
}
const dd10 = (n, s = 56, f = X10.butter, o = {}) => { const id = 'w' + (wn10++); return `<svg width="${s}" height="${s}" viewBox="0 0 64 64" style="overflow:visible;flex:none;display:inline-block;${o.ex || ''}"><filter id="${id}" filterUnits="userSpaceOnUse" x="-8" y="-8" width="80" height="80"><feTurbulence type="fractalNoise" baseFrequency=".045" numOctaves="2" seed="${o.seed || 3}" result="t"/><feDisplacementMap in="SourceGraphic" in2="t" scale="${o.wob == null ? 2.6 : o.wob}" xChannelSelector="R" yChannelSelector="G"/></filter><g filter="url(#${id})" stroke="${o.ink || X10.ink}" stroke-width="${o.sw || 3}" stroke-linecap="round" stroke-linejoin="round">${DD10[n](f, o.g || '#fff')}</g></svg>` }
// a hand-drawn stroke
const hl10 = (w, h, d, c = X10.ink, sw = 2.400, ex = '', dash = '') => { const id = 'w' + (wn10++); return `<svg width="${w}" height="${h}" viewBox="0 0 ${w} ${h}" style="overflow:visible;display:block;${ex}"><filter id="${id}" filterUnits="userSpaceOnUse" x="-12" y="-12" width="${w + 24}" height="${h + 24}"><feTurbulence type="fractalNoise" baseFrequency=".011" numOctaves="2" seed="7" result="t"/><feDisplacementMap in="SourceGraphic" in2="t" scale="5" xChannelSelector="R" yChannelSelector="G"/></filter><path d="${d}" fill="none" stroke="${c}" stroke-width="${sw}" stroke-linecap="round" stroke-linejoin="round" ${dash ? `stroke-dasharray="${dash}"` : ''} filter="url(#${id})"/></svg>` }
// die-cut sticker: white edge follows the drawing
const cut10 = (inner, e = 3, sh = '0 5px 8px rgba(36,27,25,.28)') => `<div style="display:inline-block;line-height:0;filter:drop-shadow(${e}px 0 0 #fff) drop-shadow(-${e}px 0 0 #fff) drop-shadow(0 ${e}px 0 #fff) drop-shadow(0 -${e}px 0 #fff) drop-shadow(${sh})">${inner}</div>`

// events: [start, end, title, place, doodle, host, minutes]
const E10 = { dog: ['2:30', '3:00', 'Therapy dogs', 'Library lawn', 'dog', 'SCU Wellness', 30], rose: ['3:00', '4:00', 'Rose garden sketch', 'Mission Gardens', 'rose', 'Art Club', 60], pot: ['3:30', '4:30', 'Ceramics open studio', 'Arts 104', 'pot', 'Art Club', 60], dice: ['3:45', '5:30', 'Board games', 'Benson 103', 'dice', 'Game Night Crew', 105], bowl: ['6:00', '7:00', 'Dumpling social', 'Benson patio', 'bowl', 'APSU', 60], mic: ['7:00', '8:00', 'Open mic', 'The Bronco', 'mic', 'KSCU', 60], star: ['8:00', '9:30', 'Open night', 'Ricard Observatory', 'star', 'Astronomy Club', 90] }
const FC10 = { dog: X10.kraft, rose: X10.gold, pot: X10.blue, dice: '#fff', bowl: X10.butterD, mic: X10.blue, star: X10.gold, ball: X10.butterD, cam: X10.kraft }
const tm10 = t => { const [h, m] = t.split(':').map(Number); return h * 60 + m }

const nav10 = (on = 0, dark) => `<div style="position:absolute;left:38px;right:38px;bottom:13px;height:58px;border-radius:20px;background:${dark ? 'rgba(255,255,255,.16)' : 'rgba(255,255,255,.86)'};box-shadow:0 8px 22px rgba(36,27,25,.16);display:flex;align-items:center;justify-content:space-around;z-index:6">${[['folder', 'Discover'], ['tag', 'Post'], ['line', 'My Schedule']].map(([k, t], i) => `<span style="display:grid;justify-items:center;gap:2px;font:700 8.500px/1 ${BG10};color:${dark ? '#fff' : X10.ink};opacity:${i === on ? 1 : .62}">${dd10(k, 30, i === on ? X10.butterD : '#fff', { sw: 3.600, seed: 5 + i })}${t}</span>`).join('')}</div>`
const VAR10 = `--sans:${BG10};--serif:${BG10}`
const P10 = (bg, inner, o = {}) => phoneW(`<div style="position:absolute;inset:0;background:${bg}"></div>`, `<div style="position:absolute;inset:0;${VAR10}"><div style="position:absolute;left:0;right:0;top:44px;bottom:0;color:${o.col || X10.ink}">${inner}</div>${o.nav === null ? '' : nav10(o.nav || 0, o.dark)}</div>`, o.light)
const D10 = (bg, inner, on = 'Discover', dark) => dk6(bg, `<div style="position:absolute;inset:0;color:${dark ? '#fff' : X10.ink}">${inner}</div>`, on, dark).replace('class="inner" style="', `class="inner" style="${VAR10};`)
// a results line: doodle, serif name, mono facts
const r10 = (e, fs = 1, ex = '') => `<div style="display:flex;align-items:center;gap:${10 * fs}px;${ex}">${ev10(e[4], 40 * fs)}<div>${sf10(e[2], 20 * fs)}<div style="margin-top:${3 * fs}px;color:${X10.muted}">${mo10(`${e[0]} &middot; ${e[3].toUpperCase()} &middot; ${e[6]} MIN`, 8.500 * fs)}</div></div></div>`
// packaging card: bracket labels in the corners, drawing in the middle, a colour band at the foot
const card10 = (e, w, h, band = X10.butter, fs = 1) => `<div style="position:relative;width:${w}px;height:${h}px;color:${X10.ink};background:#fff;box-shadow:0 8px 18px rgba(48,36,33,.12);background-image:radial-gradient(rgba(48,36,33,.07) .7px,transparent .8px);background-size:5px 5px"><div style="position:absolute;left:9px;top:10px">${bk10(e[0], 8 * fs)}</div>${fs > 1.200 ? '' : `<div style="position:absolute;right:9px;top:10px">${bk10(e[6] + ' min', 8)}</div>`}<div style="position:absolute;left:0;right:0;top:${h * .17}px;text-align:center">${ev10(e[4], w * .56)}</div><div style="position:absolute;left:8px;right:8px;top:${h * .17 + w * .6}px;text-align:center">${sf10(e[2], Math.max(15, w * .15))}</div><div style="position:absolute;left:0;right:0;bottom:0;height:${h * .2}px;background:${band};display:flex;align-items:center;justify-content:space-between;padding:0 10px">${mo10(e[3].toUpperCase(), 7.500 * fs)}<span style="font:700 ${13 * fs}px var(--sans)">&rarr;</span></div></div>`
// ---------- H1 · say it in a sentence ----------
const slot10 = (t, c = X10.ink) => `<span style="display:inline-block;vertical-align:.1em;font:700 .56em/1.5 ${BG10};font-stretch:100%;letter-spacing:0;background:#fff;color:${c};padding:0 .5em;border-radius:.45em;box-shadow:0 .14em 0 ${X10.ink}">${t}</span>`
const sent10 = (s, until = '4:40') => `<div style="font:800 ${s * .8}px/1.3 ${BG10};font-stretch:80%;letter-spacing:-.03em">I&rsquo;m free ${ob10('coffeep', s * 1.150, 'vertical-align:-.3em')} ${slot10('today')} from ${slot10('2:10')} until ${slot10(until)}.</div>`
O10.H1 = [
  P10(X10.butter, `${at(20, 16, bk10('Discover', 8))}${at(0, 16, bk10('12 on today', 8), 'left:auto;right:20px')}
    ${at(22, 44, sent10(52), 'width:244px')}
    ${at(22, 226, hl10(236, 6, 'M2 3H234', X10.ink, 2))}${at(22, 242, bk10('3 fit', 8.500))}
    ${at(22, 266, r10(E10.dog, 1.060))}${at(22, 324, r10(E10.rose, 1.060))}${at(22, 382, r10(E10.pot, 1.060))}
    ${at(22, 446, al10('and 9 that don&rsquo;t'))}`),
  D10(X10.grey, `${at(56, 30, bk10('Discover &middot; Wed Nov 11', 14))}${at(56, 70, sent10(98), 'width:470px')}
    ${at(56, 384, hl10(430, 6, 'M2 3H428', X10.ink, 2.400))}${at(56, 404, sf10('Three things do.', 46))}${at(56, 468, al10('See the 9 that don&rsquo;t', 'font-size:18px'))}
    ${at(548, 30, bk10('3 fit', 14))}${at(548, 62, card10(E10.dog, 134, 330, X10.butter, 1.500))}${at(692, 92, card10(E10.rose, 134, 330, X10.blueT, 1.500))}${at(836, 62, card10(E10.pot, 134, 330, X10.butter, 1.500))}
    ${at(548, 452, sn10('Each blank is one of the three inputs the app already has: day, from, until.', 19, 500, `width:420px;color:${X10.muted}`))}`),
  P10(X10.butter, `${at(20, 16, bk10('Discover', 8))}${at(0, 16, bk10('12 on today', 8), 'left:auto;right:20px')}
    ${at(22, 44, sent10(52, '2:30'), 'width:244px')}
    ${at(22, 250, sf10('Nothing fits twenty minutes.', 30, `width:230px`))}
    ${at(22, 322, `<div style="display:flex;align-items:center;gap:10px">${B8('Stretch until 3:00', X10.ink, '#fff', .82)}</div>`)}
    ${at(22, 374, `<div style="display:flex;align-items:center;gap:8px">${ev10('dog', 40)}${sn10('catches Therapy dogs, 2:30 on the Library lawn', 11.500, 500, 'width:180px')}</div>`)}
    ${at(22, 440, al10('or see all 12'))}${at(176, 392, ob10('plate', 108))}`)]

// ---------- H2 · the ruler and two clips ----------
const RUL10 = (len, vert, from, to, ppm, fs = 1) => { let t = ''; const T = 40 * fs; for (let m = from; m <= to; m += 10) { const p = (m - from) * ppm, big = m % 60 === 0, mid = m % 30 === 0, L = (big ? 20 : mid ? 13 : 7) * fs
    t += vert ? `<line x1="${T - L}" x2="${T}" y1="${p}" y2="${p}"/>` : `<line y1="${T - L}" y2="${T}" x1="${p}" x2="${p}"/>`
    if (big) t += vert ? `<text x="4" y="${p + 13 * fs}">${m / 60 % 12 || 12}</text>` : `<text x="${p + 5}" y="${15 * fs}">${m / 60 % 12 || 12} PM</text>` }
  return `<svg width="${vert ? T : len}" height="${vert ? len : T}" style="display:block;background:#fff;border-radius:4px;box-shadow:0 0 0 2px ${X10.ink},0 6px 12px rgba(48,36,33,.14)"><g stroke="${X10.ink}" stroke-width="${1.400 * fs}" font-family="DM Mono,monospace" font-size="${10 * fs}" font-weight="500" fill="${X10.ink}">${t.replace(/<text/g, '<text stroke="none"')}</g></svg>` }
const clip10 = (t, vert, fs = 1) => `<div style="position:relative;width:${62 * fs}px;height:${66 * fs}px;${vert ? '' : 'transform:rotate(-90deg)'}">${ob10('clip', 62 * fs, 'position:absolute;left:0;top:0;filter:drop-shadow(0 3px 4px rgba(48,36,33,.3))')}<span style="position:absolute;left:50%;top:${2 * fs}px;transform:translateX(-50%)${vert ? '' : ' rotate(90deg)'};background:#fff;color:${X10.ink};font:500 ${9 * fs}px/1 ${MO10};padding:${2 * fs}px ${4 * fs}px;border-radius:3px;box-shadow:0 0 0 1.200px ${X10.ink};white-space:nowrap">${t}</span></div>`
const flag10 = (e, x, y, w, h, on, col = X10.butterD, rot = 0, fs = 1) => `<div style="position:absolute;left:${x}px;top:${y}px;width:${w}px;height:${h}px;box-sizing:border-box;padding:${4 * fs}px ${5 * fs}px ${3 * fs}px ${9 * fs}px;border-radius:2px 9px 9px 2px;transform:rotate(${rot}deg);overflow:hidden;line-height:1;color:${X10.ink};${on ? `background:${col};box-shadow:inset ${4 * fs}px 0 0 rgba(48,36,33,.22),0 4px 8px rgba(48,36,33,.14)` : `background:rgba(255,255,255,.7);box-shadow:inset 0 0 0 1.400px rgba(48,36,33,.3);color:${X10.muted}`}">${mo10(e[0], 8 * fs)}<div style="font:700 ${10.500 * fs}px/1.12 var(--sans);margin-top:${1 * fs}px">${e[2]}</div></div>`
const vy10 = t => 40 + (tm10(t) - 120) * 1.500
const rulerP10 = (until, bad) => `${at(0, vy10('2:10'), '', `left:14px;right:10px;height:${vy10(until) - vy10('2:10')}px;background:rgba(244,217,79,.5);border-radius:3px`)}
  ${at(14, 40, RUL10(410, 1, 120, 393, 1.500))}${at(5, vy10('2:10') - 10, clip10('2:10', 1))}${at(5, vy10(until) - 10, clip10(until, 1))}
  ${flag10(E10.dog, 62, vy10('2:30'), 68, 45, !bad, X10.kraft, -1)}${flag10(E10.rose, 62, vy10('3:00') + 2, 68, 88, !bad, X10.butterD, .6)}${flag10(E10.pot, 134, vy10('3:30'), 66, 90, !bad, X10.blueT, -.8)}${flag10(E10.dice, 204, vy10('3:45'), 64, 157, 0)}${flag10(E10.bowl, 62, vy10('6:00') - 6, 68, 45, 0)}`
const hx10 = t => 40 + (tm10(t) - 120) * 2.550
O10.H2 = [
  P10(X10.grey, `${at(0, 12, `<div style="text-align:center">${bk10('what sits between the clips', 8)}</div>`, 'right:0')}${rulerP10('4:40')}
    ${at(0, 446, `<div style="display:flex;justify-content:flex-end;align-items:baseline;gap:8px;padding-right:18px">${sf10('3 fit', 30)}${mo10('150 MIN', 9, `color:${X10.muted}`)}</div>`, 'right:0')}`),
  D10(X10.grey, `${at(hx10('2:10'), 96, '', `width:${hx10('4:40') - hx10('2:10')}px;height:336px;background:rgba(244,217,79,.5);border-radius:4px`)}
    ${at(40, 30, RUL10(920, 0, 120, 480, 2.550, 1.500))}${at(hx10('2:10') - 11, 11, clip10('2:10', 0, 1.500))}${at(hx10('4:40') - 11, 11, clip10('4:40', 0, 1.500))}
    ${flag10(E10.dog, hx10('2:30'), 112, 76, 76, 1, X10.kraft, -1, 1.450)}${flag10(E10.rose, hx10('3:00') + 2, 112, 151, 76, 1, X10.butterD, .5, 1.450)}${flag10(E10.pot, hx10('3:30'), 198, 153, 76, 1, X10.blueT, -.6, 1.450)}${flag10(E10.dice, hx10('3:45'), 284, 268, 62, 0, '', 0, 1.450)}
    ${flag10(E10.bowl, hx10('6:00'), 112, 151, 76, 0, '', 0, 1.450)}${flag10(E10.mic, hx10('7:00') + 2, 112, 151, 76, 0, '', 0, 1.450)}
    ${at(60, 452, `<div style="display:flex;align-items:baseline;gap:14px">${sf10('3 fit between the clips', 50)}${mo10('150 MIN', 15, `color:${X10.muted}`)}</div>`)}
    ${at(560, 212, sn10('A flag is as wide as its event is long. Flags that overlap sit on separate rows, with no warning colour.', 18, 500, `width:400px;color:${X10.muted}`))}
    ${at(560, 318, `<div style="width:400px;background:#fff;padding:18px 20px;box-sizing:border-box;box-shadow:0 10px 22px rgba(48,36,33,.14);transform:rotate(.6deg);display:flex;gap:16px;align-items:center">${ev10('rose', 104)}<div>${bk10('3:00 to 4:00 &middot; Mission Gardens', 12)}${sf10('Rose garden sketch', 34, 'margin:8px 0 12px')}${B8('Add to My Schedule', X10.ink, '#fff', 1.050)}</div></div>`)}`),
  P10(X10.grey, `${at(0, 12, `<div style="text-align:center">${bk10('what sits between the clips', 8)}</div>`, 'right:0')}${rulerP10('2:30', 1)}
    ${at(136, 58, `<div style="width:126px;background:#fff;padding:9px 10px;box-sizing:border-box;box-shadow:0 6px 12px rgba(48,36,33,.16);transform:rotate(1.500deg)">${sn10('Ten minutes short.', 12, 700)}${sn10('Slide the lower clip to 3:00 and Therapy dogs fits.', 10.500, 500, `color:${X10.muted};margin-top:3px`)}</div>`)}
    ${at(50, 92, hl10(30, 50, 'M4 2C22 8 24 26 16 44M16 44l-7-8M16 44l8-6', X10.blue, 2.600))}
    ${at(0, 446, `<div style="display:flex;justify-content:flex-end;align-items:baseline;gap:8px;padding-right:18px">${sf10('0 fit', 30, `color:${X10.muted}`)}${mo10('20 MIN', 9, `color:${X10.muted}`)}</div>`, 'right:0')}`)]

// ---------- H7 · the date stamp ----------
const wheel10 = (lab, v, k, bad) => `<div style="flex:1;display:grid;justify-items:center;gap:${2 * k}px;padding:${4 * k}px 0;${bad ? `background:${X10.redT}` : ''}"><span style="font:700 ${6 * k}px/1 var(--sans);opacity:.5">&#9650;</span><span style="font:500 ${12.500 * k}px/1 ${MO10};white-space:nowrap;${bad ? `color:${X10.red}` : ''}">${v}</span><span style="font:700 ${6 * k}px/1 var(--sans);opacity:.5">&#9660;</span></div>`
const stamp10 = (k, vals, bad) => `<div style="position:relative;width:${196 * k}px;display:grid;justify-items:center">
  <div style="width:${86 * k}px;height:${46 * k}px;border-radius:50% 50% 46% 46%/62% 62% 38% 38%;background:${X10.kraft};box-shadow:inset 0 0 0 ${3 * k}px ${X10.ink},inset ${-9 * k}px ${-7 * k}px 0 rgba(48,36,33,.14)"></div>
  <div style="width:${26 * k}px;height:${34 * k}px;margin-top:${-3 * k}px;background:${X10.kraft};box-shadow:inset 0 0 0 ${3 * k}px ${X10.ink}"></div>
  <div style="width:${196 * k}px;margin-top:${-3 * k}px;border-radius:${16 * k}px;background:${X10.blue};box-shadow:inset 0 0 0 ${3 * k}px ${X10.ink};padding:${14 * k}px ${12 * k}px ${10 * k}px;box-sizing:border-box">
    <div style="display:flex;background:#fff;border-radius:${8 * k}px;box-shadow:0 0 0 ${2.500 * k}px ${X10.ink};overflow:hidden">${wheel10('day', vals[0], k)}<span style="width:${2 * k}px;background:${X10.ink}"></span>${wheel10('from', vals[1], k)}<span style="width:${2 * k}px;background:${X10.ink}"></span>${wheel10('until', vals[2], k, bad)}</div>
    <div style="display:flex;justify-content:space-around;margin-top:${7 * k}px;color:#fff">${['day', 'from', 'until'].map(l => bk10(l, 7.500 * k)).join('')}</div></div>
  <div style="width:${178 * k}px;height:${11 * k}px;background:${X10.ink};border-radius:0 0 ${5 * k}px ${5 * k}px"></div></div>`
const imp10 = (k, l1, l2, l3, o = {}) => { const id = 'w' + (wn10++); return `<svg width="0" height="0" style="position:absolute"><filter id="${id}"><feTurbulence type="fractalNoise" baseFrequency=".9" numOctaves="1" seed="2" result="t"/><feDisplacementMap in="SourceGraphic" in2="t" scale="2.200" xChannelSelector="R" yChannelSelector="G"/></filter></svg><div style="display:inline-block;transform:rotate(${o.rot == null ? -4 : o.rot}deg);padding:${3 * k}px;border:${2.600 * k}px solid ${X10.blue};border-radius:${10 * k}px;color:${X10.blue};filter:url(#${id});opacity:.92;${o.ex || ''}"><div style="border:${1.200 * k}px solid ${X10.blue};border-radius:${7 * k}px;padding:${7 * k}px ${14 * k}px;text-align:center"><div style="font:500 ${8.500 * k}px/1 ${MO10};letter-spacing:.14em">${l1}</div><div style="font:800 ${19 * k}px/1.15 var(--sans);letter-spacing:.02em;margin:${3 * k}px 0">${l2}</div><div style="font:500 ${8.500 * k}px/1 ${MO10};letter-spacing:.14em">${l3}</div></div></div>` }
O10.H7 = [
  P10(X10.paper, `${at(42, 14, stamp10(1, ['WED 11', '2:10', '4:40']))}
    ${at(34, 206, imp10(1, 'FREE &middot; WED NOV 11', '2:10 &rarr; 4:40 PM', '150 MIN &middot; 3 FIT'))}
    ${at(26, 298, r10(E10.dog, .86))}${at(26, 346, r10(E10.rose, .86))}${at(26, 394, r10(E10.pot, .86))}
    ${at(26, 446, mo10('ROLL A WHEEL, STAMP AGAIN', 8, `color:${X10.muted}`))}`),
  D10(X10.grey, `${at(70, 40, stamp10(1.900, ['WED 11', '2:10', '4:40']))}${at(338, 352, obr10('datestamp', 150, 84, 'transform:rotate(12deg);filter:drop-shadow(0 6px 6px rgba(48,36,33,.25))'))}${at(74, 440, sn10('Three wheels: day, from, until. The same three inputs as now, as one object you can roll with a thumb or the arrow keys.', 19, 500, `width:380px;color:${X10.muted}`))}
    ${at(510, 22, `<div style="width:440px;height:524px;background:#fff;box-shadow:0 14px 30px rgba(48,36,33,.14);transform:rotate(.7deg);padding:30px 34px;box-sizing:border-box">${imp10(1.700, 'FREE &middot; WED NOV 11', '2:10 &rarr; 4:40 PM', '150 MIN &middot; 3 FIT', { rot: -3 })}<div style="display:grid;gap:22px;margin-top:30px">${r10(E10.dog, 1.600)}${r10(E10.rose, 1.600)}${r10(E10.pot, 1.600)}</div><div style="margin-top:26px">${al10('See the 9 that don&rsquo;t fit', 'font-size:18px')}</div></div>`)}`),
  P10(X10.paper, `${at(42, 14, stamp10(1, ['WED 11', '2:10', '1:50'], 1))}
    ${at(158, 118, hl10(84, 46, 'M42 4C70 4 80 14 80 24S66 43 40 42 4 34 4 22 16 5 46 5', X10.red, 2.400))}
    ${at(34, 210, imp10(1, 'FREE &middot; WED NOV 11', '2:10 &rarr; 1:50 PM', 'NOT STAMPED', { ex: 'opacity:.26' }))}
    ${at(30, 300, `<div style="display:flex;gap:9px;align-items:flex-start;width:222px;color:${X10.red}"><span style="font:800 15px/1 var(--sans);width:20px;height:20px;border-radius:50%;border:2px solid ${X10.red};display:grid;place-items:center;flex:none">!</span><div>${sn10('Until comes before from.', 13, 700)}${sn10('Roll the last wheel past 2:10.', 11.500, 500, `color:${X10.ink};margin-top:2px`)}</div></div>`)}
    ${[0, 1, 2].map(i => at(26, 362 + i * 36, '', `width:228px;height:26px;border-radius:8px;border:1.500px dashed rgba(48,36,33,.22)`)).join('')}`)]

// ---------- H3 · sticker filters ----------
const cat10 = (name, n, doodle, fill, s, rot, on, o = {}) => `<div style="position:relative;width:${s}px;transform:rotate(${rot}deg);${on === 0 ? 'opacity:.74;filter:grayscale(.5)' : ''}">${cut10(ev10(doodle, s), Math.max(3, s * .04), '0 6px 10px rgba(0,0,0,.4)')}<div style="position:absolute;left:50%;bottom:${-s * .08}px;transform:translateX(-50%) rotate(${-rot - 3}deg);background:${on ? X10.butterD : '#fff'};color:${X10.ink};padding:4px 8px;border-radius:6px;white-space:nowrap;box-shadow:0 2px 0 ${X10.ink};font:800 ${Math.max(9, s * .1)}px/1 var(--sans);letter-spacing:.08em">${name} ${mo10('( ' + n + ' )', Math.max(8, s * .09))}${on && o.tick !== 0 ? ` <span style="color:${X10.sage}">&#10003;</span>` : ''}</div></div>`
const pile10 = (k, sel) => `${at(8 * k, 0, cat10('MAKE', 3, 'pot', X10.blue, 118 * k, -8, sel.includes('MAKE') ? 1 : 0))}${at(140 * k, 14 * k, cat10('MOVE', 0, 'ball', X10.butterD, 104 * k, 7, sel.includes('MOVE') ? 1 : 0, { seed: 9 }))}${at(74 * k, 112 * k, cat10('EAT', 2, 'bowl', X10.gold, 126 * k, 4, sel.includes('EAT') ? 1 : 0, { seed: 5 }))}${at(0, 206 * k, cat10('HEAR', 2, 'mic', X10.blue, 100 * k, -5, sel.includes('HEAR') ? 1 : 0, { seed: 11 }))}${at(170 * k, 150 * k, cat10('PAWS', 1, 'dog', X10.kraft, 92 * k, 10, sel.includes('PAWS') ? 1 : 0, { seed: 4 }))}${at(128 * k, 250 * k, cat10('LOOK', 4, 'star', X10.gold, 108 * k, -9, sel.includes('LOOK') ? 1 : 0, { seed: 8 }))}`
const cap10 = dark => `${at(18, 14, mo10('WED NOV 11', 8, 'opacity:.7'))}${at(0, 14, mo10('PEEL WHAT YOU&rsquo;RE UP FOR', 8, 'opacity:.7'), 'left:auto;right:18px')}`
O10.H3 = [
  P10(X10.esp, `${cap10()}${at(14, 44, pile10(.94, ['MAKE', 'EAT']), 'width:260px;height:360px')}
    ${at(108, 38, spark10(26, X10.butterD))}${at(196, 142, spark10(24, X10.butterD))}${at(20, 422, B8('Show 5 that match', X10.gold, X10.ink, .9, 1))}`, { light: 1, dark: 1, col: '#fff' }),
  D10(X10.esp, `${at(40, 22, mo10('WED NOV 11 &middot; 12 ON TODAY', 14, 'opacity:.7'))}${at(60, 70, pile10(1.280, ['MAKE', 'EAT']), 'width:360px;height:460px')}
    ${at(510, 36, sf10('Five match.', 62, 'color:#fff'))}${at(512, 112, mo10('MAKE ( 3 ) + EAT ( 2 )', 15, `color:${X10.butterD}`))}
    ${at(510, 150, card10(E10.pot, 140, 320, X10.butter, 1.500))}${at(660, 150, card10(E10.bowl, 140, 320, X10.blueT, 1.500))}${at(810, 150, card10(E10.rose, 140, 320, X10.butter, 1.500))}
    ${at(510, 490, sn10('Until events carry a category, the app can guess one from the title and file the rest under Other.', 18, 500, 'width:440px;color:rgba(255,255,255,.72)'))}`, 'Discover', 1),
  P10(X10.esp, `${cap10()}${at(14, 38, pile10(.94, ['MOVE']), 'width:260px;height:360px')}
    ${at(20, 418, `<div style="width:240px;box-sizing:border-box;background:${X10.paper};color:${X10.ink};border-radius:14px;padding:11px 14px;display:flex;align-items:center;justify-content:space-between;gap:10px"><div>${sn10('No Move today.', 13, 700)}${sn10('Two on Friday.', 11.500, 500, `color:${X10.muted}`)}</div>${al10('Show Friday')}</div>`)}`, { light: 1, dark: 1, col: '#fff' })]
