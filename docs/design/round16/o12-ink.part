const rng12 = a => () => { a |= 0; a = a + 0x6D2B79F5 | 0; let t = Math.imul(a ^ a >>> 15, 1 | a); t = t + Math.imul(t ^ t >>> 7, 61 | t) ^ t; return ((t ^ t >>> 14) >>> 0) / 4294967296 }
const cr12 = (P, n = 14) => { const out = [], g = i => P[Math.max(0, Math.min(P.length - 1, i))]
  for (let i = 0; i < P.length - 1; i++) { const [a, b, c, d] = [g(i - 1), g(i), g(i + 1), g(i + 2)]
    for (let k = 0; k < n; k++) { const t = k / n, t2 = t * t, t3 = t2 * t; out.push([0, 1].map(j => .5 * (2 * b[j] + (c[j] - a[j]) * t + (2 * a[j] - 5 * b[j] + 4 * c[j] - d[j]) * t2 + (3 * b[j] - a[j] - 3 * c[j] + d[j]) * t3))) } }
  out.push(P[P.length - 1]); return out }
// text: the words. X: x-height in px. seed: which drawing. o.c colour, o.W weight, o.sl slant
const ink12 = (text, X, seed = 1, o = {}) => { const R = rng12(seed * 7919 + 13), j = a => (R() - .5) * 2 * a, W = (o.W || .15) * (1 + j(.1)), sl = (o.sl ?? .22) + j(.06), strokes = [], dots = []
  let pen = .15, cur = null, prevHi = null; const ph = R() * 6, wf = 1.100 + R() * .9, wa = .03 + R() * .05, chars = [...text]
  chars.forEach((ch, ci) => { if (ch === ' ') { if (cur) strokes.push(cur); cur = null; pen += .5 + j(.08); return }
    const g = GL12[ch] || GL12[ch.toLowerCase()]; if (!g) return
    const sc = 1 + j(.075), sx = 1.060 + j(.09), by = j(.055), end = ci === chars.length - 1 || (ci === chars.length - 2 && GL12[chars[ci + 1]] && GL12[chars[ci + 1]].cap), last = end || chars[ci + 1] === ' ' || (GL12[chars[ci + 1]] || {}).cap
    const tp = p => [pen + p[0] * sc * sx + j(.028), p[1] * sc + by + j(.028)]
    if (g.cap) { if (cur) strokes.push(cur); cur = null }
    ;(g.pre || []).forEach(s => strokes.push(s.map(tp)))
    if (g.m) { let pts = g.m.map(tp)
      if (end && !g.nc) { const e = pts[pts.length - 1], f = R(); pts[pts.length - 1] = [e[0] + .1 + f * .5, e[1] + .05 + f * (R() < .5 ? .5 : .12)]; if (f > .55) pts.push([e[0] + .5 + f * .7, e[1] + .3 + j(.2)]) } else if (last && !g.nc) { const e = pts[pts.length - 1]; pts[pts.length - 1] = [e[0] + .06, e[1] + .1 + R() * .15] }
      if (cur && !g.cap) cur.push(...pts.slice(1)); else cur = pts
      if (g.nc || last) { strokes.push(cur); cur = null } }
    ;(g.x || []).forEach(x => { if (x[0] === 'dot') dots.push([tp([x[1], x[2]]), .11 + R() * .05]); else { const L = end ? 1.100 + R() * 1.200 : .85 + R() * .45, s = x[1].map(p => [(p[0] - .26) * L + .26 + (end ? .12 : 0), p[1]]); strokes.push(s.map(tp)) } })
    pen += g.w * sc * sx + (o.tr ?? .04) + j(.02) })
  if (cur) strokes.push(cur)
  const A = 2.050, H = 2.950, M = .3, T = p => { const y = p[1] + wa * Math.sin(p[0] * wf + ph); return [(p[0] + sl * y + M) * X, (A - y) * X] }
  const paths = strokes.map(s => { const q = cr12(s.map(T)), n = q.length, tw = []
    for (let i = 0; i < n; i++) { const a = q[Math.max(0, i - 1)], b = q[Math.min(n - 1, i + 1)], dx = b[0] - a[0], dy = b[1] - a[1], l = Math.hypot(dx, dy) || 1; tw.push([dx / l, dy / l]) }
    const raw = tw.map(t => .62 + .62 * Math.max(0, t[1]) + .1 * Math.abs(t[0])), wd = raw.map((_, i) => { let s2 = 0, c = 0; for (let k = -6; k <= 6; k++) { const v = raw[i + k]; if (v != null) { s2 += v; c++ } } return s2 / c })
    const Lp = [], Rp = []; q.forEach((p, i) => { const e = Math.min(i, n - 1 - i) / Math.max(6, n * .06), tap = Math.min(1, .38 + .62 * Math.min(1, e)), w = W * X * wd[i] * tap * (1 + .1 * Math.sin(i * .21 + ph)) / 2, [tx, ty] = tw[i]; Lp.push([p[0] - ty * w, p[1] + tx * w]); Rp.push([p[0] + ty * w, p[1] - tx * w]) })
    const f = p => p[0].toFixed(1) + ' ' + p[1].toFixed(1); return `<path d="M${Lp.map(f).join('L')}L${Rp.reverse().map(f).join('L')}Z"/>` }).join('')
  const ds = dots.map(([p, r]) => { const [x, y] = T(p); return `<ellipse cx="${x.toFixed(1)}" cy="${y.toFixed(1)}" rx="${(r * X).toFixed(1)}" ry="${(r * X * .9).toFixed(1)}"/>` }).join('')
  const w = (pen + sl * 2 + M * 2 + .5) * X, h = H * X
  return `<svg width="${w.toFixed(0)}" height="${h.toFixed(0)}" viewBox="0 0 ${w.toFixed(0)} ${h.toFixed(0)}" style="display:block;overflow:visible;flex:none;${o.ex || ''}"><g fill="${o.c || K.ink}" stroke="${o.c || K.ink}" stroke-width="${(X * .012).toFixed(2)}" stroke-linejoin="round">${paths}${ds}</g></svg>` }
