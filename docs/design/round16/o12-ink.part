  T: { w: 1.05, cap: 1, pre: [[[-.1, 1.66], [.3, 1.92], [.7, 1.8], [1.18, 1.9]]], m: [[.56, 1.84], [.5, .4], [.64, .03], [1.05, .12]] },
  F: { w: 1, cap: 1, nc: 1, pre: [[[0, 1.74], [.4, 1.9], [1.02, 1.8]], [[.3, 1], [.74, 1.04]]], m: [[.5, 1.84], [.46, .5], [.34, .06], [.12, .12]] },
  '?': { w: .9, cap: 1, nc: 1, m: [[.14, 1.5], [.4, 1.9], [.7, 1.6], [.52, 1.02], [.38, .56]], x: [['dot', .38, .08]] },
  '.': { w: .45, cap: 1, nc: 1, m: null, x: [['dot', .18, .08]] }, ',': { w: .45, cap: 1, nc: 1, m: [[.2, .12], [.22, -.1], [.1, -.3]] }
