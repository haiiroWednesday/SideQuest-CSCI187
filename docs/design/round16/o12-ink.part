  S: { w: 1.05, cap: 1, nc: 1, m: [[.9, 1.5], [.66, 1.9], [.34, 1.82], [.22, 1.42], [.5, 1], [.76, .55], [.62, .1], [.28, -.02], [.06, .22], [.2, .5]] },
