  h: { w: .9, m: [[0, .12], [.2, .9], [.3, 1.8], [.17, 1.86], [.16, 0], [.2, .5], [.45, .97], [.62, .8], [.64, .2], [.74, .04], [.9, .12]] },
  i: { w: .5, m: [[0, .12], [.25, .97], [.27, .2], [.36, .04], [.5, .12]], x: [['dot', .29, 1.42]] },
  k: { w: .85, m: [[0, .12], [.2, .9], [.3, 1.8], [.17, 1.86], [.16, 0], [.2, .45], [.5, .97], [.58, .75], [.3, .5], [.6, .15], [.7, .04], [.85, .12]] },
  l: { w: .5, m: [[0, .12], [.22, .9], [.32, 1.8], [.19, 1.86], [.18, .25], [.3, .03], [.5, .12]] },
  m: { w: 1.3, m: [[0, .12], [.14, .92], [.16, 0], [.2, .55], [.42, .98], [.56, .8], [.58, 0], [.62, .55], [.84, .98], [.98, .8], [1, .2], [1.1, .04], [1.3, .12]] },
  n: { w: .9, m: [[0, .12], [.14, .92], [.16, 0], [.2, .55], [.42, .98], [.58, .8], [.6, .2], [.7, .04], [.9, .12]] },
  o: { w: .8, hi: .78, m: [[0, .12], [.3, .5], [.52, .96], [.36, 1.02], [.14, .6], [.2, .12], [.4, .02], [.6, .3], [.6, .75], [.46, .98], [.56, .8], [.8, .78]] },
  p: { w: .85, m: [[0, .12], [.16, .96], [.16, -.8], [.18, .5], [.4, .98], [.62, .72], [.58, .22], [.4, .03], [.24, .2], [.5, .04], [.85, .12]] },
  q: { w: .9, m: [[0, .12], [.3, .45], [.6, .9], [.42, 1.02], [.14, .62], [.2, .14], [.42, .02], [.64, .4], [.7, .96], [.7, -.76], [.8, -.3], [.9, .12]] },
  r: { w: .7, m: [[0, .12], [.16, .75], [.2, 1.04], [.3, .9], [.5, .9], [.52, .25], [.6, .04], [.7, .12]] },
