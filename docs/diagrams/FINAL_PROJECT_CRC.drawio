<?xml version="1.0" encoding="UTF-8"?><mxfile host="app.diagrams.net" agent="SideQuest" version="24.7.17" type="device" pages="2"><diagram name="Final CRC - Coded Responsibilities" id="final-crc-implemented"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="crc-title" value="SideQuest  |  Final-project CRC responsibilities" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#344054;fontSize=30;fontStyle=1;fontColor=#202E40;" vertex="1" parent="1"><mxGeometry x="45" y="25" width="1380" height="55" as="geometry"/></mxCell><mxCell id="crc-sub" value="Page 1 of 2 · Actual model and controller modules on the November 20 integration/draft branches; M2 remains on master. CRC cards are conceptual responsibilities, not literal TypeScript classes." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#344054;fontSize=15;" vertex="1" parent="1"><mxGeometry x="45" y="85" width="1380" height="55" as="geometry"/></mxCell><mxCell id="eventCatalog" value="&lt;b&gt;EventCatalog / Event&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN M2&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Create and validate public Events&lt;br/&gt;• Stable UUID, date/time, host, location&lt;br/&gt;• List upcoming / resolve by ID&lt;br/&gt;• Server-owned Supabase adapter when configured" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EAF5EE;strokeColor=#4C9472;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="175" width="290" height="220" as="geometry"/></mxCell><mxCell id="discover" value="&lt;b&gt;Discover / Fit assessment&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Filter entire event into free window&lt;br/&gt;• Explain misses without false fits&lt;br/&gt;• Classify provisional category/Other&lt;br/&gt;• Display verified event details" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="410" y="175" width="290" height="220" as="geometry"/></mxCell><mxCell id="schedule" value="&lt;b&gt;Personal Schedule&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN M2&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Store local planned Event UUIDs&lt;br/&gt;• Resolve event details and failures&lt;br/&gt;• Detect overlaps / remove plans&lt;br/&gt;• No RSVP or account sync" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EAF5EE;strokeColor=#4C9472;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="770" y="175" width="290" height="220" as="geometry"/></mxCell><mxCell id="timeline" value="&lt;b&gt;Schedule timeline&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Map real minutes to bar height&lt;br/&gt;• Assign overlap lanes&lt;br/&gt;• Preserve accessible event list&lt;br/&gt;• No fabricated duration" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1130" y="175" width="290" height="220" as="geometry"/></mxCell><mxCell id="someday" value="&lt;b&gt;Intention / Someday&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Independent idea ID, title and note&lt;br/&gt;• Nullable link to real Event UUID&lt;br/&gt;• Saved / ready / deferred states&lt;br/&gt;• Persist in device localStorage" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="50" y="520" width="290" height="215" as="geometry"/></mxCell><mxCell id="calendar" value="&lt;b&gt;CalendarDraft&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Generate reviewable Google Calendar link&lt;br/&gt;• Resolve California date and time&lt;br/&gt;• Reject invalid DST transitions&lt;br/&gt;• No OAuth or calendar write" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="410" y="520" width="290" height="215" as="geometry"/></mxCell><mxCell id="campus" value="&lt;b&gt;CampusWalk / Map&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Use verified pedestrian edges only&lt;br/&gt;• Reject closed / inaccessible paths&lt;br/&gt;• Official SCU map search fallback&lt;br/&gt;• Real walkway network not loaded" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="770" y="520" width="290" height="215" as="geometry"/></mxCell><mxCell id="group" value="&lt;b&gt;GroupPlan rules&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Organizer and participant permissions&lt;br/&gt;• Works / If / Cannot; unknown stays unknown&lt;br/&gt;• Private condition redaction&lt;br/&gt;• Service requires verified server identity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1130" y="520" width="290" height="215" as="geometry"/></mxCell><mxCell id="crc-bottom" value="Implementation boundary: EventCatalog and personal Schedule are existing M2 behavior. Someday, fit explanations, timeline, categories, calendar, map and group rules live in unmerged draft branches. Group HTTP endpoints, real accounts and verified SCU routing data are still missing." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#344054;fontSize=14;fontStyle=1;fontColor=#8A3A29;" vertex="1" parent="1"><mxGeometry x="55" y="822" width="1360" height="70" as="geometry"/></mxCell><mxCell id="a1" value="catalog IDs" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="eventCatalog" target="discover"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a2" value="plan by Event ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="discover" target="schedule"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a3" value="derived geometry" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="schedule" target="timeline"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a4" value="optional Event ID" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="someday" target="eventCatalog"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a5" value="read-only export" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="eventCatalog" target="calendar"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a6" value="venue text only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;" edge="1" parent="1" source="eventCatalog" target="campus"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="a7" value="future proposal handoff" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B07C35;" edge="1" parent="1" source="someday" target="group"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram name="Group CRC - Gated Collaboration" id="final-crc-group"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1460" pageHeight="930" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="crc2-title" value="SideQuest  |  Group coordination CRC &amp; permission boundary" style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#344054;fontSize=30;fontStyle=1;fontColor=#202E40;" vertex="1" parent="1"><mxGeometry x="50" y="25" width="1340" height="55" as="geometry"/></mxCell><mxCell id="crc2-sub" value="Page 2 of 2 · Tested pure domain + abstract server service only. Daven&apos;s live login, database persistence and authorization have not been implemented on this branch. DO NOT call these deployed." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#344054;fontSize=16;" vertex="1" parent="1"><mxGeometry x="50" y="88" width="1340" height="70" as="geometry"/></mxCell><mxCell id="gplan" value="&lt;b&gt;GroupPlan&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Event ID, organizer ID, revision&lt;br/&gt;• Proposed / confirmed / cancelled&lt;br/&gt;• Organizer invites, revokes and confirms&lt;br/&gt;• Reject stale update or unresolved responses" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="60" y="210" width="350" height="240" as="geometry"/></mxCell><mxCell id="part" value="&lt;b&gt;Participant&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• One user per invited plan&lt;br/&gt;• Response: null / works / if / cant&lt;br/&gt;• Only owner changes own response&lt;br/&gt;• Private condition visible to author only" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="550" y="210" width="350" height="240" as="geometry"/></mxCell><mxCell id="svc" value="&lt;b&gt;GroupPlanService&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;CODED IN DRAFT PR&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Validate real EventCatalog reference&lt;br/&gt;• Accept verified actor, not client ID&lt;br/&gt;• Read → apply rule → atomic compare/swap&lt;br/&gt;• Return only authorized projection" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#EFF4FC;strokeColor=#547AAA;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1030" y="210" width="350" height="240" as="geometry"/></mxCell><mxCell id="session" value="&lt;b&gt;Verified identity / session&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;GATED / PLANNED&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Server derives actor from auth token&lt;br/&gt;• Expires / revokes and rejects spoofing&lt;br/&gt;• No browser-supplied identity" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#FFF4DE;strokeColor=#B07C35;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="60" y="590" width="350" height="190" as="geometry"/></mxCell><mxCell id="repository" value="&lt;b&gt;Durable plan repository&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;GATED / PLANNED&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• SQL group_plans and participants&lt;br/&gt;• Atomic revision and deny-by-default RLS&lt;br/&gt;• No actual migration or connection yet" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#FFF4DE;strokeColor=#B07C35;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="550" y="590" width="350" height="190" as="geometry"/></mxCell><mxCell id="ui" value="&lt;b&gt;Invitation &amp;amp; response UI&lt;/b&gt;&lt;br/&gt;&lt;font color=&quot;#596A7A&quot; style=&quot;font-size:12px&quot;&gt;GATED / PLANNED&lt;/font&gt;&lt;br/&gt;&lt;br/&gt;• Two genuine accounts / two browsers&lt;br/&gt;• Works / If / Can&amp;apos;t + pending&lt;br/&gt;• Realtime only after authorization" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacing=15;fillColor=#FFF4DE;strokeColor=#B07C35;strokeWidth=1.8;fontFamily=Helvetica;fontSize=14;fontColor=#172B4D;" vertex="1" parent="1"><mxGeometry x="1030" y="590" width="350" height="190" as="geometry"/></mxCell><mxCell id="g-bottom" value="Security rule: Domain tests alone cannot establish authenticated multi-user access. Test anonymous and cross-account SELECT/INSERT/UPDATE denial against the real database before enabling group features." style="text;html=1;whiteSpace=wrap;align=left;verticalAlign=middle;strokeColor=none;fillColor=none;fontFamily=Helvetica;fontSize=15;fontColor=#344054;fontSize=15;fontStyle=1;fontColor=#8A3A29;" vertex="1" parent="1"><mxGeometry x="60" y="845" width="1320" height="52" as="geometry"/></mxCell><mxCell id="g-e1" value="0..12 invited" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="gplan" target="part"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-e2" value="commands" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;" edge="1" parent="1" source="part" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-e3" value="trusted actor" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B07C35;" edge="1" parent="1" source="session" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-e4" value="atomic state" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B07C35;" edge="1" parent="1" source="repository" target="svc"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="g-e5" value="authorized response only" style="edgeStyle=orthogonalEdgeStyle;rounded=1;orthogonalLoop=1;jettySize=auto;html=1;strokeColor=#8594A8;strokeWidth=1.8;endArrow=open;endFill=0;fontSize=12;fontColor=#334155;labelBackgroundColor=#FFFFFF;dashed=1;strokeColor=#B07C35;" edge="1" parent="1" source="svc" target="ui"><mxGeometry relative="1" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>