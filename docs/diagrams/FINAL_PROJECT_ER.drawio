ore acceptance" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EAF2FD;strokeColor=#547AAA;strokeWidth=2;fontSize=16;align=left;spacing=16;"><mxGeometry x="80" y="595" width="585" height="235" as="geometry"/></mxCell><mxCell id="participants" value="&lt;b&gt;group_participants (PROPOSED)&lt;/b&gt;&lt;br/&gt;PK (plan_id, user_id)&lt;br/&gt;plan_id FK: cascade; user_id FK: cascade&lt;br/&gt;response nullable, private_condition nullable&lt;br/&gt;invited_at, responded_at&lt;br/&gt;Only accepted members; optional If note author-only" vertex="1" parent="1" style="rounded=0;html=1;whiteSpace=wrap;fillColor=#EAF2FD;strokeColor=#547AAA;strokeWidth=2;fontSize=16;align=left;spacing=16;"><mxGeometry x="855" y="595" width="620" height="235" as="geometry"/></mxCell><mxCell id="policy" value="Acceptance creates membership with an unanswered response. Decline, expiry or revocation grants no roster access. Member deletion advances revision and cancels a confirmed plan; deleting the organizer deletes their own plans. Daven/team must approve these lifecycle rules." vertex="1" parent="1" style="text;html=1;whiteSpace=wrap;align=left;strokeColor=none;fillColor=none;fontColor=#344054;fontSize=16;"><mxGeometry x="70" y="865" width="1410" height="125" as="geometry"/></mxCell><mxCell id="e1" value="1" edge="1" parent="1" source="event" target="r-event" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#536B80;strokeWidth=2;endArrow=none;startArrow=none;fontSize=14;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e2" value="0..N" edge="1" parent="1" source="r-event" target="plans" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;strokeColor=#536B80;strokeWidth=2;endArrow=none;startArrow=none;fontSize=14;labelBackgroundColor=#FFFFFF;"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="e3" value="1" edge="1" parent="1" source="users" target="r-org" style="edgeStyle=orthogonalEdgeStyle;rounded=0;