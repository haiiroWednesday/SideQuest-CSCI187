        <mxCell id="lc" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Georgia;fontSize=13;fillColor=#FFFFFF;fontColor=#202E40;rotation=0;" value="&lt;b&gt;C / local attendance references&lt;/b&gt;&lt;br&gt;Zero or more IDs per browser; Events survive removal." vertex="1">
          <mxGeometry height="75" width="315" x="405" y="454" as="geometry"/>
        </mxCell>
        <mxCell id="footer0" parent="1" style="text;html=1;align=left;fontFamily=Georgia;fontSize=12;fontColor=#202E40;" value="&lt;b&gt;HOLLOW DIAMOND&lt;/b&gt; / Groups independent Event records.  &lt;b&gt;DASHED ARROW&lt;/b&gt; / Uses catalog lookup." vertex="1">
          <mxGeometry height="22.6771653546" width="1046.9291338707" x="37.795275591" y="695.4330708744" as="geometry"/>
        </mxCell>
        <mxCell id="footer1" parent="1" style="text;html=1;align=left;fontFamily=Georgia;fontSize=12;fontColor=#202E40;" value="&lt;b&gt;DELETION&lt;/b&gt; / Removing a planned ID never deletes its public Event.  &lt;b&gt;MATCH&lt;/b&gt; / Entire interval fits." vertex="1">
          <mxGeometry height="22.6771653546" width="1046.9291338707" x="37.795275591" y="718.110236229" as="geometry"/>
