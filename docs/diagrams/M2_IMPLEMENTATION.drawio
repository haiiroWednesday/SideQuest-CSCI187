        <mxCell id="footer2" parent="1" style="text;html=1;align=left;fontFamily=Georgia;fontSize=12;fontColor=#202E40;" value="&lt;b&gt;SCOPE&lt;/b&gt; / M2 conceptual CRC for TypeScript types, functions and ports. P4 and P5 originals unchanged." vertex="1">
