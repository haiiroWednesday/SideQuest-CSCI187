        </mxCell>
        <mxCell id="match-note" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Georgia;fontSize=13;fillColor=#FFFFFF;fontColor=#202E40;rotation=0;" value="&lt;b&gt;Exact full-fit rule&lt;/b&gt;&lt;br&gt;Same date; window.start ≤ event.start&lt;br&gt;and event.end ≤ window.end.&lt;br&gt;Equal boundaries count." vertex="1">
          <mxGeometry height="120" width="350" x="735" y="145" as="geometry"/>
        </mxCell>
        <mxCell id="storage-note" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontFamily=Georgia;fontSize=13;fillColor=#FFFFFF;fontColor=#202E40;rotation=0;" value="&lt;b&gt;Storage boundaries&lt;/b&gt;&lt;br&gt;Public events: shared SQL if configured.&lt;br&gt;Plan IDs: localStorage on this device.&lt;br&gt;Free-time window: temporary input." vertex="1">
          <mxGeometry height="116" width="350" x="735" y="570" as="geometry"/>
        </mxCell>
        <mxCell id="ownership-note" parent="1" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacing=10;fontFamily=Georgia;fontSize=13;fontColor=#202E40;fillColor=#EDF3FA;strokeColor=#254F88;strokeWidth=1;arcSize=8;" value="&lt;b&gt;EVENT LIFETIME&lt;/b&gt;&lt;br&gt;Public Events remain in catalog when a plan is removed. Schedule stores IDs, not copies of the Events. No SQL attendance table." vertex="1">
          <mxGeometry height="124" width="298" x="414" y="563" as="geometry"/>
        </mxCell>
      </root>
