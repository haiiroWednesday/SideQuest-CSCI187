<mxfile host="app.diagrams.net">
  <diagram name="Current M2 storage ER">
    <mxGraphModel grid="1" page="1" pageWidth="1600" pageHeight="950">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="event" parent="1" vertex="1" value="&lt;b&gt;public.events | shared SQL entity&lt;/b&gt;&lt;br&gt;&lt;br&gt;id: UUID PRIMARY KEY, generated by database&lt;br&gt;title: text, required, maximum 120&lt;br&gt;host_name: text, required, maximum 120&lt;br&gt;description: text, required, maximum 2000&lt;br&gt;location: text, required, maximum 200&lt;br&gt;event_date: date (California campus calendar)&lt;br&gt;start_time, end_time: same-day wall times&lt;br&gt;created_at: timestamptz, generated by database&lt;br&gt;Constraint: start_time &amp;lt; end_time&lt;br&gt;RLS: anonymous SELECT and bounded INSERT&lt;br&gt;No anonymous UPDATE or DELETE." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf4ec;strokeColor=#38516c;fontSize=20;align=left;spacing=20;verticalAlign=top;">
          <mxGeometry as="geometry" x="60" y="150" width="760" height="620" />
        </mxCell>
        <mxCell id="plans" parent="1" vertex="1" value="&lt;b&gt;Current-device local storage&lt;/b&gt;&lt;br&gt;&lt;br&gt;sidequest.planned-event-ids.v1&lt;br&gt;JSON array of unique Event ID strings.&lt;br&gt;Provisional maximum: 100 IDs.&lt;br&gt;Not a SQL table or a user account.&lt;br&gt;References can be missing or unavailable.&lt;br&gt;Remove changes this array only." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#edf2f7;strokeColor=#38516c;fontSize=20;align=left;spacing=20;verticalAlign=top;">
          <mxGeometry as="geometry" x="1000" y="150" width="540" height="290" />
        </mxCell>
        <mxCell id="window" parent="1" vertex="1" value="&lt;b&gt;Transient search input&lt;/b&gt;&lt;br&gt;&lt;br&gt;date, start, end: held in View state.&lt;br&gt;Used for full-fit matching.&lt;br&gt;No saved availability table." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2da;strokeColor=#38516c;fontSize=20;align=left;spacing=20;verticalAlign=top;">
          <mxGeometry as="geometry" x="1000" y="530" width="540" height="180" />
        </mxCell>
        <mxCell id="e0" parent="1" edge="1" source="plans" target="event" value="ID lookup" style="endArrow=open;html=1;strokeWidth=2;dashed=1;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
